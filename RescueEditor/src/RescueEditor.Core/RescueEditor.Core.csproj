<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shipped with RescueTemple releases; generated by tools/pack_cpatch_payload.py (not required for Core unit tests). -->
  <ItemGroup Condition="Exists('Resources/CPatchFeaturePayload.rcp')">
    <EmbeddedResource Include="Resources/CPatchFeaturePayload.rcp" LogicalName="RescueEditor.Core.CPatchFeaturePayload.rcp" />
    <None Include="Resources/CPatchFeaturePayload.rcp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keep C Patches field IDs locked to include/runtime.h when building inside the decomp tree. -->
  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))</RepoRoot>
    <RuntimeConfigHeader>$(RepoRoot)/include/runtime.h</RuntimeConfigHeader>
    <RuntimeConfigGenScript>$(RepoRoot)/tools/gen_runtime_config_schema.py</RuntimeConfigGenScript>
    <RuntimeConfigSnapshot>$(MSBuildProjectDirectory)/Generated/RuntimeConfigHeaderSnapshot.g.cs</RuntimeConfigSnapshot>
  </PropertyGroup>

  <Target Name="GenerateRuntimeConfigHeaderSnapshot"
          BeforeTargets="BeforeCompile;CoreCompile"
          Condition="Exists('$(RuntimeConfigHeader)') And Exists('$(RuntimeConfigGenScript)')"
          Inputs="$(RuntimeConfigHeader);$(RuntimeConfigGenScript)"
          Outputs="$(RuntimeConfigSnapshot)">
    <Exec Command="python3 &quot;$(RuntimeConfigGenScript)&quot; --header &quot;$(RuntimeConfigHeader)&quot; -o &quot;$(RuntimeConfigSnapshot)&quot;" />
  </Target>

</Project>
