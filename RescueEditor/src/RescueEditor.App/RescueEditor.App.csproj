<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\rescuetemple_logo.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>RescueTemple</AssemblyName>
    <Product>RescueTemple</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RescueEditor.Core\RescueEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\rescuetemple_logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../charmap.txt" Link="charmap.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../tools/agbplay/**/*" Link="tools/agbplay/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))</RepoRoot>
    <DungeonFloorCache>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../cache/dungeon-floors'))</DungeonFloorCache>
    <Baserom>$(RepoRoot)/baserom.gba</Baserom>
    <DungeonFloorBakeProject>$(MSBuildProjectDirectory)/../RescueEditor.Bake/RescueEditor.Bake.csproj</DungeonFloorBakeProject>
  </PropertyGroup>

  <Target Name="BakeDungeonFloorPreviews"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(Baserom)') And Exists('$(DungeonFloorBakeProject)')"
          Inputs="$(Baserom);$(MSBuildProjectDirectory)/../RescueEditor.Core/DungeonFloorGenerator.cs;$(MSBuildProjectDirectory)/../RescueEditor.Core/DungeonFloorRenderer.cs;$(MSBuildProjectDirectory)/../RescueEditor.Core/DungeonFloorPreviewCache.cs;$(MSBuildProjectDirectory)/../RescueEditor.Core/DungeonFloorPreviewBake.cs"
          Outputs="$(DungeonFloorCache)/manifest.json">
    <MakeDir Directories="$(DungeonFloorCache)" />
    <Exec Command="dotnet run --project &quot;$(DungeonFloorBakeProject)&quot; -c $(Configuration) -- &quot;$(Baserom)&quot; &quot;$(DungeonFloorCache)&quot;" />
  </Target>

  <Target Name="IncludeDungeonFloorPreviews" BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup Condition="Exists('$(DungeonFloorCache)')">
      <Content Include="$(DungeonFloorCache)\**\*"
               Link="dungeon-floors\%(RecursiveDir)%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
