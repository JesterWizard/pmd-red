prefix s_gs180_
debug_file src/data/ground/sky/ground_data_d02p01_station.h

# Explorers of Sky demake, chapter 2 (documentation/Features/SkyChapter2.md):
# the one station file of every chapter-2 map (Wigglytuff's Guild, Drenched
# Bluff). gMapScriptTable points them all at gs180, Red's Thunderwave Cave
# entrance slot, which the sky build does not use. A placeholder until the
# chapter's scenes come in: group 0, the station's enter script.
```c
#include "sky_story.h"
```

script g0_s0_station control=ENTER_CONTROL type=SCRIPT_TYPE_01
    DEBUGINFO line=14
    SELECT_MAP SKY_GUILD_B2F
    BGM_STOP
    JUMP_SCRIPT COMMON_ENTER
end

stations
    g0_s0_station
end

sectors g0
    sector station=0
end

groups
    g0
end
