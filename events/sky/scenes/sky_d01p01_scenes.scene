    actor kind=34 facing=WEST x=86 y=24.5 script=g1_s0_lives1_dlg0
end

# The Relic Fragment (object kind SKY_OBJ_RELIC_FRAGMENT): on the sand until
# Zubat takes it (cue 9).
script relic_fragment_dlg0
    DEBUGINFO line=1220
    CLEAR_OBJ_FLAGS INTERACT_MASK
    AWAIT_CUE 9
    END_DELETE
end

objects g1_s2_objs
    object kind=SKY_OBJ_RELIC_FRAGMENT w=1 h=1 x=39.5 y=23.5 script=relic_fragment_dlg0
end

# g6: the Relic Fragment the partner holds out at the grate (EoS m01a0104
