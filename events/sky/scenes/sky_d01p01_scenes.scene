# g5 / m01a0103: PLAYER (36,22) facing right
actors g5_s0_lives
    actor kind=0 facing=EAST x=36 y=22.5 script=g5_s0_lives0_dlg0
end

# g6 / m01a0104: ATTENDANT1 (30,25) facing up; Zubat (20,22) and Koffing
