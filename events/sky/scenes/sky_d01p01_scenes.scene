# ------------------------------------------------------------------------
# group 3 — m01a0702: back on the beach with the Relic Fragment
# ------------------------------------------------------------------------

script g3_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO line=960
    SET_PLACE_MODE 1
    BGM_STOP
    FADE_OUT wait=TRUE frames=0
    SELECT_MAP SKY_BEACH_DUSK
    SELECT_ENTITIES group=-1 sector=0
    # EoS m01a0702: the waves (bgm2) first; the music starts at the Relic
    # Fragment ("It's my precious treasure.").
    SKY_AMBIENCE song=SKY_OCEAN frames=160
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    AWAIT_CUE 3
    BGM_FADEOUT 180
    SKY_AMBIENCE_FADEOUT 180   # EoS: bgm2_FadeOut(180)
    FADE_OUT wait=TRUE frames=90
    FADE2_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=0x0 id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=0x1 id=0x22
    WAIT 60
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}And so..."
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}{NAME_1} and {NAME_0}..."
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}formed an exploration team."
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}This turned out to be..."
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}their very first step into..."
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}many fantastic realms of adventure\n{CENTER_ALIGN}that awaited their arrival."
    TEXTBOX_CLEAR
    WAIT 1
    FADE2_IN wait=TRUE frames=0
    RET
end

script g3_s0_lives0_dlg0   # Player
    DEBUGINFO line=994
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    WAIT_FADE
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=NORMAL
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=HAPPY
    ALERT_CUE 6
    AWAIT_CUE 5
    MSG_NPC who=PARTNER text=" Thank you very much!"
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(............)"
    MSG_QUIET who=PLAYER text="(I only helped because I happened\nto be there... Was that the right\nthing to do?)"
    PORTRAIT place=KEEP who=PLAYER emotion=HAPPY
    MSG_QUIET who=PLAYER text="(I guess so.{WAIT_PRESS} This Pokémon is\nclearly grateful.)"
    MSG_QUIET who=PLAYER text="(It's nice to be appreciated.)"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Here's what they stole."
    MSG_NPC who=PARTNER text=" This is a Relic Fragment.{WAIT_PRESS}\n...Well, at least, that's what\nI started calling it..."
    MSG_NPC who=PARTNER text=" But this Relic Fragment...{WAIT_PRESS}\nIt's my precious treasure."
    BGM_SWITCH SKY_ON_THE_BEACH_AT_DUSK   # EoS: bgm_PlayFadeIn(BGM_ON_THE_BEACH_AT_DUSK, 0)
    TEXTBOX_CLEAR
    MSG_NPC who=PARTNER text=" You see, I've always liked\nlegends and lore..."
    MSG_NPC who=PARTNER text=" I always get so excited when I\nhear tales from the past!"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    MSG_NPC who=PARTNER text=" Don't you feel the same way?"
    MSG_NPC who=PARTNER text=" Hidden troves full of treasure\nand strange relics..."
    PORTRAIT place=KEEP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" ...uncharted territories veiled\nin darkness..."
    MSG_NPC who=PARTNER text=" ...and new lands just waiting to\nbe discovered!"
    MSG_NPC who=PARTNER text=" Such places must be full of gold\nand treasure!"
    MSG_NPC who=PARTNER text=" And history! Wouldn't it be\ndramatic to make historic\ndiscoveries?"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" That's what I always dream of.\nIt's all so exciting to me."
    MSG_NPC who=PARTNER text=" And it just so happened...{WAIT_PRESS}that I\nfound this Relic Fragment."
    MSG_NPC who=PARTNER text=" Sure, it does look like junk, but\ntake a closer look."
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=RELIC_FRAGMENT frames=150   # EoS: the Relic Fragment close-up
    FADE_IN wait=TRUE frames=20
    MSG_NPC who=PARTNER text=" Look there.{WAIT_PRESS} See that strange\npattern inscribed on it?"
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=PLAYER emotion=NORMAL
    MSG_QUIET who=PLAYER text="(It's true. There is a strange\ninscription.)"
    MSG_QUIET who=PLAYER text="(I've never seen a pattern like\nthis.)"
    TEXTBOX_CLEAR
    MSG_NPC who=PARTNER text=" There must be some meaning to\nthis pattern."
    MSG_NPC who=PARTNER text=" This Relic Fragment must be the\nkey to legendary places! To areas\nwhere precious treasure lies!"
    MSG_NPC who=PARTNER text=" At least that's the feeling I get."
    MSG_NPC who=PARTNER text=" That's why I want to join an\nexploration team."
    MSG_NPC who=PARTNER text=" This fragment must fit into\nsomething...somewhere! I want to\ndiscover where that is."
    MSG_NPC who=PARTNER text=" I want to solve the mystery of\nmy Relic Fragment!"
    MSG_NPC who=PARTNER text=" So earlier, I tried joining an\nexploration team as an\napprentice..."
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" But...{WAIT_PRESS}I was too cowardly..."
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" What about you, {NAME_0}?\nWhat are you going to do now?"
    MSG_NPC who=PARTNER text=" You lost your memory. And you\nsomehow transformed into a\nPokémon..."
    MSG_NPC who=PARTNER text=" Do you have anyplace where\nyou can stay?"
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(............)"
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" If not, can I ask a big favor?"
    MSG_NPC who=PARTNER text=" Would you form an exploration\nteam with me?"
    MSG_NPC who=PARTNER text=" I think we could make a good\nexploration team together,\n{NAME_0}."
    MSG_NPC who=PARTNER text=" So will you do that with me?{WAIT_PRESS}\nPlease?"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    FANFARE_PLAY2 470   # EoS se_Play(8972) + sweat drops on the hero
    CALL_SCRIPT SWEAT_FUNC
    PORTRAIT place=KEEP who=PLAYER emotion=SUPRISED
    MSG_QUIET who=PLAYER text="(Wah! What should I do?{WAIT_PRESS} I'm getting\nrecruited out of the blue!)"
    PORTRAIT place=KEEP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(I don't know what an exploration\nteam is...)"
  LABEL 1   # = 0x01
    ASK2 flag=FALSE default=-1 who=PLAYER text="(What should I do?{WAIT_PRESS} Should I join this\nPokémon and form an exploration\nteam?)"
    CHOICE label=2 text="Form a team"
    CHOICE label=3 text="Say no"
  LABEL 3   # = 0x03
    TEXTBOX_CLEAR
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" What?! Oh, please!"
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" But I'm braver when I'm with\nyou, {NAME_0}..."
    MSG_NPC who=PARTNER text=" And you were fantastic when\nwe faced Koffing and his sidekick."
    MSG_NPC who=PARTNER text=" When I saw that, I realized\nyou're no ordinary Pokémon,\n{NAME_0}!"
    MSG_NPC who=PARTNER text=" I thought that you could be a\nfirst-class explorer, {NAME_0}."
    MSG_NPC who=PARTNER text=" So, please?{WAIT_PRESS} Will you please form\nan exploration team with me?"
    TEXTBOX_CLEAR
    JUMP_LABEL 1
  LABEL 2   # = 0x02
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(It's true, I do have nowhere to go...)"
    MSG_QUIET who=PLAYER text="(I don't have any clue what I should\ndo next.)"
    MSG_QUIET who=PLAYER text="(I guess it wouldn't hurt to team up\nwith {NAME_1} for now.)"
    MSG_QUIET who=PLAYER text="(Maybe I'll eventually discover who or\nwhat I am by hanging out with this\nPokémon.)"
    PORTRAIT place=KEEP who=PLAYER emotion=NORMAL
    MSG_QUIET who=PLAYER text="(OK! That's settled!)"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    PORTRAIT place=KEEP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" Oh?{WAIT_PRESS} Really?!"
    MSG_NPC who=PARTNER text=" You'll really form an exploration\nteam with me?"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    PORTRAIT place=KEEP who=PARTNER emotion=JOYOUS
    MSG_NPC who=PARTNER text=" Yay! Thank you!"
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" We're going to be a great\ncombination! Let's make this work!"
    MSG_NPC who=PARTNER text=" First, we need to go to\nWigglytuff's place and sign up as\napprentices."
    MSG_NPC who=PARTNER text=" That's where we can get the\ntraining to become a proper\nexploration team."
    MSG_NPC who=PARTNER text=" I think the training will be very\ntough..."
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" So let's give it our best,\n{NAME_0}!"
    TEXTBOX_CLEAR
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTH
    ALERT_CUE 6
    WAIT 60
    ALERT_CUE 3
    HALT
end

script g3_s0_lives1_dlg0   # Partner
    DEBUGINFO line=1134
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 6
    CALL_SCRIPT JUMP_ANGRY_FUNC
    ALERT_CUE 5
    AWAIT_CUE 6
    WALK_RELATIVE speed=128 dx=12 dy=0
    FANFARE_PLAY2 SE_SKY_RELIC_FRAGMENT   # EoS se_Play(6410): the Relic Fragment comes out
    SELECT_ENTITIES group=-1 sector=1   # EoS supervision_Acting(1): it lies on the sand from here on
    WAIT 15
    MOVE_RELATIVE speed=128 dx=-12 dy=0
    ALERT_CUE 5
    AWAIT_CUE 6
    CALL_SCRIPT JUMP_HAPPY_FUNC
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    ALERT_CUE 5
    AWAIT_CUE 6
    CALL_SCRIPT JUMP_HAPPY_FUNC
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=EAST
    ALERT_CUE 5
    AWAIT_CUE 6
    CALL_SCRIPT JUMP_HAPPY_FUNC
    ALERT_CUE 5
    AWAIT_CUE 6   # "Oh? Really?!"
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    CALL_SCRIPT NOTICE_FUNC
    ALERT_CUE 5
    AWAIT_CUE 6   # "Yay!"
    CALL_SCRIPT JUMP_ANGRY_FUNC
    ALERT_CUE 5
    AWAIT_CUE 6   # both look out to sea
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTH
    HALT
end

