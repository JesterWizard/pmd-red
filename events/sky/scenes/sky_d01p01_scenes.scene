# ------------------------------------------------------------------------
# group 2 — m01a0301: defeated in Beach Cave
# ------------------------------------------------------------------------

script g2_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO line=871
    SET_PLACE_MODE 1
    BGM_STOP
    FADE_OUT wait=TRUE frames=0
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=-1 emotion=PAINED
    MSG_NPC who=-1 text=" ...Wh-what?"
    TEXTBOX_CLEAR
    WAIT 60
    SELECT_MAP SKY_BEACH_DUSK
    SELECT_ENTITIES group=-1 sector=0
    BGM_FADEIN frames=160 song=SKY_OCEAN   # EoS m01a0301: bgm_PlayFadeIn(BGM_OCEAN1, 160)
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    AWAIT_CUE 3
    BGM_FADEOUT 60
    NEXT_DUNGEON frames=30 dungeon=TINY_WOODS
    RET
end

script g2_s0_lives0_dlg0   # Player
    DEBUGINFO line=894
    CALL_SCRIPT INIT_SLEEP_FUNC
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    WAIT_FADE
    PORTRAIT place=LEFT_BOTTOM_2 who=PLAYER emotion=NORMAL
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=PAINED
    CALL_SCRIPT WAKEUP_FUNC
    CALL_SCRIPT LOOK_AROUND_DOWN_FUNC
    ALERT_CUE 6
    AWAIT_CUE 5
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    WAIT 20
    MSG_NPC who=PARTNER text=" Ouch! We didn't do too well..."
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" I guess if either of us faints,\nthe other one can't carry on!"
    MSG_NPC who=PARTNER text=" ...Could this be what they're\ncalling a mystery dungeon?"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Oh! There's no time to waste!"
    MSG_NPC who=PARTNER text=" We need to catch Koffing and\nhis buddy and get my treasure\nback!"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    AWAIT_CUE 5
    PORTRAIT place=KEEP who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" Let's go, {NAME_0}!"
    TEXTBOX_CLEAR
    ALERT_CUE 6
    WAIT 10
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=WEST
    ALERT_CUE 3
    WALK_RELATIVE speed=384 dx=-184 dy=4
    HALT
end

script g2_s0_lives1_dlg0   # Partner
