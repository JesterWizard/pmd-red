script g3_relic_fragment_dlg0
    DEBUGINFO line=1262
    CLEAR_OBJ_FLAGS INTERACT_MASK
    HALT
end

objects g3_s1_objs
    object kind=SKY_OBJ_RELIC_FRAGMENT w=1 h=1 x=50 y=22.5 script=g3_relic_fragment_dlg0
end

