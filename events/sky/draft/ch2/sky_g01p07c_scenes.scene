script g1_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    BGM_STOP
    SELECT_MAP SKY_GUILD_CREW_ROOM_NIGHT
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Why don't we get some sleep?"
    TEXTBOX_CLEAR
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    WAIT 1
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    WAIT 20
    FANFARE_PLAY2 SE_SKY_EVENT_SIGN_NOTICE_05   # EoS se_Play(8978) = SE_NUM_EVENT_SIGN_NOTICE_05: not converted yet
    # TODO eos: SetEffect<actor ACTOR_PLAYER>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    AWAIT_CUE 65   # <- CHATOT done
    PORTRAIT place=LEFT_MIDTOP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Hey, beginners!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    ALERT_CUE 66   # -> PARTNER
    MSG_NPC who=CHATOT text=" Before you go to bed, our\nGuildmaster wants to speak with you."
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=30
    RET
end

script g1_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    HALT
end

script g1_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=WEST
    HALT
end

script g1_s1_chatot   # EoS actor NPC_PERAPPU, layer 1
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=CHATOT id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    WALK_RELATIVE speed=307 dx=96 dy=0   # EoS MovePositionMark to Position<'m0', 14, 23>
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    HALT
end

actors g1_s0_lives
    actor kind=0 facing=WEST x=25.5 y=23 script=g1_s0_player   # EoS PLAYER
    actor kind=34 facing=EAST x=19.5 y=23 script=g1_s0_partner   # EoS ATTENDANT1
end

actors g1_s1_lives
    actor kind=SKY_LIVES_CHATOT facing=EAST x=2 y=23 script=g1_s1_chatot   # EoS NPC_PERAPPU
end

