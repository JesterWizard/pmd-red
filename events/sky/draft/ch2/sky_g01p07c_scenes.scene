script g3_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    BGM_STOP
    SELECT_MAP SKY_GUILD_CREW_ROOM_NIGHT
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_GOODNIGHT
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" We should get some sleep too."
    MSG_NPC who=PARTNER text=" Let's make tomorrow another\ngood day, {NAME_0}!"
    MSG_NPC who=PARTNER text=" OK, good night."
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_GOODNIGHT
    RET
end

