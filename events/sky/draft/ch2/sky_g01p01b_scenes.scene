script g2_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    # eos: back2_SetMode(4); (the top screen)
    SELECT_MAP SKY_GUILD_DUSK2
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=124 y=120   # EoS camera_SetMyself<performer 0>
    # eos: screen2_FlushOut(1, 0, 8, 0, 0, 0); (the top screen)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=8 color=RGB_U32(0x00, 0x00, 0x00)
    # eos: screen2_FadeIn(0, 30); (the top screen)
    WAIT 1   # the actors take their poses; the pan draws them
    SKY_CUTAWAY cg=GUILD_SKY_SCROLL frames=90   # EoS: the top screen's picture over the map: pan down to it
    FADE_IN wait=TRUE frames=0   # the pan ends on this exact view
    SET_PLACE_MODE 4
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Pokémon detected!{WAIT_PRESS} Pokémon detected!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" Whose footprint?{WAIT_PRESS} Whose footprint?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" The footprint is {POKEMON_1}'s!{WAIT_PRESS}\nThe footprint is {POKEMON_1}'s!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Waah!"
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(0, 30); (the top screen)
    FADE_OUT wait=TRUE frames=30
    # eos: back2_SetMode(0); (the top screen)
    # eos: screen2_FlushIn(1, 0, 1, 0, 0, 0); (the top screen)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    RET
end

script g2_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    HALT
end

script g2_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    EMOTION_EFFECT SHOCK
    AWAIT_CUE 64
    EMOTION_EFFECT SWEAT
    HALT
end

actors g2_s0_lives
    actor kind=0 facing=NORTH x=32 y=26.5 script=g2_s0_player   # EoS PLAYER
    actor kind=34 facing=NORTH x=30 y=22 script=g2_s0_partner   # EoS ATTENDANT1
end

stations
    g0_s0_station
    g1_s0_station
    g2_s0_station
end

sectors g0
    sector actors=g0_s0_lives station=0
    sector
end

sectors g1
    sector actors=g1_s0_lives station=1
    sector actors=g1_s1_lives
    sector objects=g1_s2_objs
end

sectors g2
    sector actors=g2_s0_lives station=2
end

groups
    g0
    g1
    g2
end
