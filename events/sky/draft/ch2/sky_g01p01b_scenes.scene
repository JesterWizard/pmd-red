    WALK_RELATIVE speed=256 dx=40 dy=-4   # EoS MovePositionMark to Position<'m2', 30, 21.5>
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    WALK_RELATIVE speed=256 dx=0 dy=-24   # EoS MovePositionMark to Position<'m3', 30, 18.5>
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    END_DELETE
end

script g1_s2_obj0_g01p01a3   # EoS object G01P01A3_95, layer 2
    DEBUGINFO
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    SELECT_ANIMATION 1   # EoS SetAnimation(9): closed (direction 0, held)
    AWAIT_CUE 64
    SELECT_ANIMATION 4   # EoS SetAnimation(17): opens once and stays open (0x1001)
    STOP_ANIMATION_ON_CURRENT_FRAME   # EoS WaitAnimation
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    HALT
end

