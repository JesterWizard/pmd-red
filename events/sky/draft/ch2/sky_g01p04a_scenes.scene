# ------------------------------------------------------------------------
# group 2: EoS m02a0301 (G01P04A)
# ------------------------------------------------------------------------

script g2_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    SELECT_MAP SKY_GUILD_B2F   # EoS: the scene goes on on the map as it is
    SELECT_ENTITIES group=-1 sector=0   # (its layer 0: who is there)
    FADE_IN wait=TRUE frames=0
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    SCENARIO_CALC SCENARIO_MAIN 3 2   # EoS scenario numbers
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    SKY_CAMERA_SET x=364 y=172   # EoS camera_SetMyPosition<actor ACTOR_PLAYER>();
    AWAIT_CUE 65   # <- PLAYER done
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    ALERT_CUE 64   # -> PLAYER
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Hey, you shouldn't just be\nwandering around there."
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    MSG_NPC who=CHATOT text=" You two come here. ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- CHATOT done
    ALERT_CUE 68   # -> CHATOT
    AWAIT_CUE 69   # <- CHATOT done
    ALERT_CUE 68   # -> CHATOT
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 60
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 20
    BGM_FADEOUT 60
    FADE_OUT wait=TRUE frames=30
    WAIT_BGM MUS_SKY_WIGGLYTUFFS_GUILD
    RET
end

