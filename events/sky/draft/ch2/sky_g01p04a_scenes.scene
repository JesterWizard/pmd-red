end

script g4_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    # EoS: its own coroutine (def ... for actor ATTENDANT1)
    SELECT_ANIMATION 2
    AWAIT_CUE 9   # EoS Lock(9)
    EMOTION_EFFECT NOTICE
    ROTATE_TO speed=1 turn=DIR_TRANS_10 direction=WEST
    AWAIT_CUE 10   # EoS Lock(10)
  LABEL 0
  LABEL 1
    SELECT_ANIMATION 3
    HEIGHT_TO 512 10
    WAIT 1
    HEIGHT_TO 512 0
    WAIT 2
    HEIGHT_TO 512 10
    WAIT 1
    HEIGHT_TO 512 0
    WAIT 15
    SELECT_ANIMATION 2
    WAIT 1   # (a forever loop)
    JUMP_LABEL 1
  LABEL 2
end

