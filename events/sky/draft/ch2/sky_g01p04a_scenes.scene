    PORTRAIT place=RIGHT_MIDTOP_FLIP who=CHATOT emotion=ANGRY
    MSG_NPC who=CHATOT text=" Hush!"
    MSG_NPC who=CHATOT text=" Your voice is ridiculously loud!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    MSG_NPC who=LOUDRED text=" Humph..."
