    COND_EQUAL 1 1
    COND_EQUAL 2 2
    JUMP_LABEL 0
  LABEL 1
    EMOTION_EFFECT NOTICE
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTHWEST
    JUMP_LABEL 0
  LABEL 2
