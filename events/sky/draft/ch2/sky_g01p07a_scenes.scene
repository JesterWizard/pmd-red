#   group 0  m02a0111  (EoS SCRIPT/G01P07A/m02a0111.ssb)
#   group 1  m02a0201  (EoS SCRIPT/G01P07A/m02a0201.ssb)
#   group 2  c00a0201  (EoS SCRIPT/G01P07A/c00a0201.ssb)

```c
#include "sky_story.h"
```

```c
#define NPC_PLAYER 0
#define NPC_PARTNER 1
#define NPC_CHATOT 2
#define NPC_LOUDRED 3
```

# ROTATE_TO_LIVES takes a lives kind, not an NPC slot.
```c
#define LIVES_KIND_PLAYER 0
