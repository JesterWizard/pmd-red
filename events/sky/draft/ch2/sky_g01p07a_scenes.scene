# ------------------------------------------------------------------------
# group 0: EoS m02a0111 (G01P07A)
# ------------------------------------------------------------------------

script g0_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    SELECT_MAP SKY_GUILD_CREW_ROOM
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=52 y=108   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    WAIT 30
    PORTRAIT place=LEFT_MIDTOP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" This is your room! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PLAYER done
    ALERT_CUE 64   # -> PLAYER
    AWAIT_CUE 67   # <- PARTNER done
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 20
    ALERT_CUE 66   # -> PARTNER
    WAIT 1
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 2
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 1
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=CENTERRIGHT_CENTER_FLIP who=PARTNER emotion=JOYOUS
    # TODO eos: message_FacePositionOffset(-2, -1);
    MSG_NPC who=PARTNER text=" Yay! We get beds!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=CHATOT text=" You will live here while you\nwork for us."
    MSG_NPC who=CHATOT text=" Things will start getting busy\nfor you tomorrow! ♪{WAIT_PRESS} So rise early and start\nliving up to our code!"
    MSG_NPC who=CHATOT text=" Don't stay up late. Get to sleep\nearly tonight! ♪{WAIT_PRESS} That is all."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 69   # <- CHATOT done
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    ALERT_CUE 68   # -> CHATOT
    AWAIT_CUE 69   # <- CHATOT done
    ALERT_CUE 68   # -> CHATOT
    WAIT 30
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=90
    WAIT_BGM MUS_SKY_WIGGLYTUFFS_GUILD_REMIX
    RET
end

script g0_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    WALK_RELATIVE speed=256 dx=108 dy=0   # EoS MovePositionMark to Position<'m0', 25.5, 23>
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=SPINRIGHT1 direction=WEST
    AWAIT_CUE 64
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_CHATOT
    HALT
end

script g0_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    WALK_RELATIVE speed=256 dx=84 dy=0   # EoS MovePositionMark to Position<'m1', 19.5, 23>
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTH
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    SELECT_ANIMATION 3
    HEIGHT_TO 512 10
    AWAIT_CUE 66
    HEIGHT_TO 512 0
    AWAIT_CUE 66
    HEIGHT_TO 512 10
    AWAIT_CUE 66
    HEIGHT_TO 512 0
    SELECT_ANIMATION 2
    EMOTION_EFFECT SMILE
    AWAIT_CUE 66
    EMOTION_EFFECT NONE
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHWEST
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=WEST
    HALT
end

script g0_s0_chatot   # EoS actor NPC_PERAPPU, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=CHATOT id=0x0
