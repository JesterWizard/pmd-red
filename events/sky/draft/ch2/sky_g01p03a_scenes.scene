# group 3: EoS m02a1001 (G01P03A)
# ------------------------------------------------------------------------

script g3_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=SPOINK id=SKY_LIVES_SPOINK   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_STOP
    SELECT_MAP SKY_GUILD_B1F
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=136 y=152   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_JOB_CLEAR
    WAIT 30
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=SPOINK emotion=NORMAL
    MSG_NPC who=SPOINK text=" Th-thank you!"
    MSG_NPC who=SPOINK text=" That pearl must be propped on\nmy head, you see. I missed it so much!"
    MSG_NPC who=SPOINK text=" I just couldn't settle down\nwithout it up there!"
    MSG_NPC who=SPOINK text=" So I was just boinging and\nsproinging everywhere!"
    MSG_NPC who=SPOINK text=" That's why I'm covered in dings\nand bumps."
    MSG_NPC who=SPOINK text=" But thanks to you, that long\nnightmare is over!"
    MSG_NPC who=SPOINK text=" You have my sincere thanks!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 1   # -> SPOINK: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    AWAIT_CUE 65   # <- SPOINK done
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}{NAME_0}'s team was rewarded with\n{CENTER_ALIGN}a Protein!"   # EoS message_Mail
    WAIT_FANFARE1 203
    TEXTBOX_CLEAR
    # eos: if ( variation ): never in the story (EoS's variation run)
    # eos: item_Set(0, 100, 0); (item slot 0: Protein)
    SKY_GIVE_ITEM item=ITEM_PROTEIN   # EoS item_Set(0, 100); message_Menu(MENU_GIVE_ITEM)
    WAIT 10
    JUMP_LABEL 1
    JUMP_LABEL 8
  LABEL 0
  LABEL 1
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}You also received a Calcium!"   # EoS message_Mail
    WAIT_FANFARE1 203
    TEXTBOX_CLEAR
    # eos: if ( variation ): never in the story (EoS's variation run)
    # eos: item_Set(0, 101, 0); (item slot 0: Calcium)
    SKY_GIVE_ITEM item=ITEM_CALCIUM   # EoS item_Set(0, 101); message_Menu(MENU_GIVE_ITEM)
    WAIT 10
    JUMP_LABEL 3
    JUMP_LABEL 7
  LABEL 2
  LABEL 3
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}You also received an Iron!"   # EoS message_Mail
    WAIT_FANFARE1 203
    TEXTBOX_CLEAR
    # eos: if ( variation ): never in the story (EoS's variation run)
    # eos: item_Set(0, 102, 0); (item slot 0: Iron)
    SKY_GIVE_ITEM item=ITEM_IRON   # EoS item_Set(0, 102); message_Menu(MENU_GIVE_ITEM)
    WAIT 10
    JUMP_LABEL 5
    JUMP_LABEL 6
  LABEL 4
  LABEL 5
    FANFARE_PLAY 212   # EoS me_Play(9)
    MSG_INSTANT text="{CENTER_ALIGN}You were also given\n{CENTER_ALIGN}2,000 Poké! Incredible!"   # EoS message_Mail
    WAIT_FANFARE1 212
    TEXTBOX_CLEAR
    WAIT 15
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Oh, wow! 2,000 Poké?!{WAIT_PRESS} We can\nhave all this money?"
    TEXTBOX_CLEAR
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=SPOINK emotion=NORMAL
    # eos: message_FacePositionOffset(-4, 1); (the face stays at its place on the GBA)
    MSG_NPC who=SPOINK text=" Of course! Of course! That's\nnothing compared to my pearl's value!"
    MSG_NPC who=SPOINK text=" Farewell!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 2   # -> SPOINK: batch 2
    AWAIT_CUE_COND 68 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 3   # -> PARTNER: batch 3
    AWAIT_CUE_COND 70 1   # -> CHATOT: batch 1
    AWAIT_CUE 65   # <- SPOINK done
    AWAIT_CUE_COND 64 3   # -> SPOINK: batch 3
    AWAIT_CUE 65   # <- SPOINK done
    AWAIT_CUE_COND 64 4   # -> SPOINK: batch 4
    AWAIT_CUE 65   # <- SPOINK done
    AWAIT_CUE_COND 64 5   # -> SPOINK: batch 5
    WAIT 60
    AWAIT_CUE_COND 66 4   # -> PARTNER: batch 4
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 68 2   # -> PLAYER: batch 2
    AWAIT_CUE_COND 66 5   # -> PARTNER: batch 5
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 70 2   # -> CHATOT: batch 2
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" We're rich, {NAME_0}! All of\na sudden, we're rich!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=MIDLEFT_TOP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Well done, team! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 6   # -> PARTNER: batch 6
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 68 3   # -> PLAYER: batch 3
    AWAIT_CUE_COND 70 3   # -> CHATOT: batch 3
    AWAIT_CUE 71   # <- CHATOT done
    AWAIT_CUE_COND 70 4   # -> CHATOT: batch 4
    AWAIT_CUE_COND 66 7   # -> PARTNER: batch 7
    AWAIT_CUE_COND 68 4   # -> PLAYER: batch 4
    PORTRAIT place=CENTERLEFT_CENTER who=CHATOT emotion=NORMAL
    # eos: message_FacePositionOffset(2, -1); (the face stays at its place on the GBA)
    MSG_NPC who=CHATOT text=" Now hand that money over, if\nyou please!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    BGM_STOP
    AWAIT_CUE_COND 68 5   # -> PLAYER: batch 5
    AWAIT_CUE_COND 66 8   # -> PARTNER: batch 8
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Excuse me?!"
    AWAIT_CUE 67   # <- PARTNER done
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 5   # -> CHATOT: batch 5
    AWAIT_CUE 71   # <- CHATOT done
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    # eos: message_FacePositionOffset(2, 2); (the face stays at its place on the GBA)
    MSG_NPC who=CHATOT text=" Most of the money from jobs\ngoes to the Guildmaster, you see! ♪"
    MSG_NPC who=CHATOT text=" And your team's share of the\nmoney comes out to this much...! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 6   # -> CHATOT: batch 6
    AWAIT_CUE 71   # <- CHATOT done
    FANFARE_PLAY2 SE_SKY_REWARD_MONEY   # EoS se_Play(8713)
    UPDATE_VARINT CALC_ADD GOLD 200   # EoS $CARRY_GOLD += 200;
    WAIT_FANFARE2 SE_SKY_REWARD_MONEY
    WAIT 10
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 68 6   # -> PLAYER: batch 6
    AWAIT_CUE_COND 66 9   # -> PARTNER: batch 9
    MSG_NPC who=PARTNER text=" Huh?!{WAIT_PRESS} We keep only 200 Poké?"
    AWAIT_CUE 67   # <- PARTNER done
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 66 10   # -> PARTNER: batch 10
    AWAIT_CUE 67   # <- PARTNER done
    MSG_NPC who=PARTNER text=" That's not fair!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 7   # -> CHATOT: batch 7
    AWAIT_CUE 71   # <- CHATOT done
    PORTRAIT place=CENTERRIGHT_CENTER_FLIP who=CHATOT emotion=NORMAL
    # eos: message_FacePositionOffset(2, -1); (the face stays at its place on the GBA)
    MSG_NPC who=CHATOT text=" Well that's the guild's rule.{WAIT_PRESS}\nYou simply have to accept it! ♪"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 66 11   # -> PARTNER: batch 11
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" Hmph..."
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=60
    RET
    JUMP_LABEL 6
  LABEL 6
    JUMP_LABEL 7
  LABEL 7
    JUMP_LABEL 8
  LABEL 8
    RET
end

script g3_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
  LABEL 0
    AWAIT_CUE 68
    COND_EQUAL 1 1
    COND_EQUAL 2 2
    COND_EQUAL 3 3
    COND_EQUAL 4 4
    COND_EQUAL 5 5
    COND_EQUAL 6 6
    JUMP_LABEL 0
  LABEL 1
    ROTATE_TO speed=16 turn=DIR_TRANS_10 direction=NORTHEAST
    JUMP_LABEL 0
  LABEL 2
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    JUMP_LABEL 0
  LABEL 3
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_CHATOT
    JUMP_LABEL 0
  LABEL 4
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_CHATOT
    JUMP_LABEL 0
  LABEL 5
    EMOTION_EFFECT SHOCK
    JUMP_LABEL 0
  LABEL 6
    EMOTION_EFFECT SHOCK
    JUMP_LABEL 0
end

script g3_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
  LABEL 0
    AWAIT_CUE 66
    COND_EQUAL 1 1
    COND_EQUAL 2 2
    COND_EQUAL 3 3
    COND_EQUAL 4 4
    COND_EQUAL 5 5
    COND_EQUAL 6 6
    COND_EQUAL 7 7
    COND_EQUAL 8 8
    COND_EQUAL 9 9
    COND_EQUAL 10 10
    COND_EQUAL 11 11
    JUMP_LABEL 0
  LABEL 1
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHEAST
    JUMP_LABEL 0
  LABEL 2
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 3
    ROTATE_TO speed=16 turn=DIR_TRANS_10 direction=NORTHEAST
    JUMP_LABEL 0
  LABEL 4
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 5
    CALL_SCRIPT JUMP_HAPPY_FUNC   # EoS CORO_JUMP_HAPPY_FUNC_SERIES
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 6
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_CHATOT
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 7
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_CHATOT
    JUMP_LABEL 0
  LABEL 8
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 9
    CALL_SCRIPT JUMP_SURPRISE_FUNC   # EoS CORO_JUMP_SURPRISE_FUNC_SERIES
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 10
    CALL_SCRIPT SWEAT_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 11
    CALL_SCRIPT SWEAT_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
end

script g3_s0_chatot   # EoS actor NPC_PERAPPU, layer 0
