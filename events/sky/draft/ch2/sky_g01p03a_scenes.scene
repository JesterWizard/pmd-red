script g0_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_STOP
    SELECT_MAP SKY_GUILD_B1F
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=232 y=128   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 0   # -> PIDGEY (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> BIDOOF (waits until it is ready)
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=MIDLEFT_TOP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" Wow!"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=88 speed=128   # EoS MovePositionMark<performer 0>(0.5, Position<'m0', 43.5, 36>);
    SKY_CAMERA_MOVE_X dx=4 speed=128
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 71   # <- PLAYER done
    # eos: WaitExecutePerformer(0); (the camera has arrived)
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 70   # -> PLAYER
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" So this is Wigglytuff's Guild!"
    MSG_NPC who=PARTNER text=" There are sure a lot of Pokémon\nhere. Do they all belong to exploration teams?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Excuse me!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    WAIT 30
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    WAIT 1
    SKY_CAMERA_MOVE dy=-60 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m3', 43.5, 28.5>);
    AWAIT_CUE_COND 72 0   # -> CHATOT (waits until it is ready)
    WAIT 60   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 45
    SKY_CAMERA_MOVE dy=60 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m4', 43.5, 36>);
    AWAIT_CUE_COND 72 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 73   # <- CHATOT done
    # eos: WaitExecutePerformer(0); (the camera has arrived)
    WAIT 15
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" It was you two that just came in, right?"
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Y-yes!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" I'm Chatot! ♪{WAIT_PRESS} I'm the Pokémon in the\nknow around these parts!"
    MSG_NPC who=CHATOT text=" I am Guildmaster Wigglytuff's\nright-hand Pokémon! ♪"
    MSG_NPC who=CHATOT text=" Now, shoo! Leave the premises!\nWe have no time for salespeople or silly\nsurveys.{WAIT_PRESS} Off you go, if you please!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    ALERT_CUE 68   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" N-no! That's not why we're here!"
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" We want to form an\nexploration team..."
    MSG_NPC who=PARTNER text=" So we came here. We want to\nget proper training as an exploration team."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 482   # EoS se_Play(8969)
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    PORTRAIT place=KEEP who=CHATOT emotion=SUPRISED
    MSG_NPC who=CHATOT text=" Wh-what?! Exploration team?"
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    PORTRAIT place=KEEP who=CHATOT emotion=WORRIED
    MSG_NPC who=CHATOT text=" It's rare to see a kid like this\nwant to apprentice at the guild."
    MSG_NPC who=CHATOT text=" Especially given how hard our\ntraining is!"
    MSG_NPC who=CHATOT text=" Surely the steady stream of\nPokémon that run away from our rigorous\ntraining proves how true that is!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" Excuse me."
    MSG_NPC who=PARTNER text=" Is the exploration team training\nthat harsh?"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 473   # EoS se_Play(8973)
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    PORTRAIT place=KEEP who=CHATOT emotion=SUPRISED
    MSG_NPC who=CHATOT text=" What?!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    ALERT_CUE 72   # -> CHATOT
    MSG_NPC who=CHATOT text=" Well...no! No, no, no!"
    MSG_NPC who=CHATOT text=" It's not true in the slightest!{WAIT_PRESS}\nOur training program for exploration teams is\nas easy as can be!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 72 0   # -> CHATOT (waits until it is ready)
    PORTRAIT place=KEEP who=CHATOT emotion=JOYOUS
    MSG_NPC who=CHATOT text=" Well, well, well! ♪{WAIT_PRESS} I wish you\nhad told me up front that you wanted to be\nan exploration team! ♪ Hee-heeee! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 72 0   # -> CHATOT (waits until it is ready)
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 68   # -> PARTNER
    WAIT 60
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" What a shift in attitude!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" OK! Let's get your team signed\nup right away. Follow me! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE_COND 72 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 73   # <- CHATOT done
    WAIT 20
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    WAIT 10
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    WAIT 10
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE 73   # <- CHATOT done
    PORTRAIT place=KEEP who=CHATOT emotion=HAPPY
    MSG_NPC who=CHATOT text=" Oh, anything wrong? Come on!\nOver here! ♪{WAIT_PRESS} Quickly, please! ♪"
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> CHATOT
    AWAIT_CUE_COND 70 0   # -> PLAYER (waits until it is ready)
    WAIT 25
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> CHATOT (waits until it is ready)
    WAIT 20
    FADE_OUT wait=TRUE frames=30
    RET
end

script g0_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 70
    WALK_RELATIVE speed=128 dx=4 dy=92   # EoS MovePositionMark to Position<'m1', 45.5, 35.5>
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 70
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 70
    ROTATE_TO speed=4 turn=SPINRIGHT1 direction=NORTH
    AWAIT_CUE 70
    EMOTION_EFFECT SWEAT
    AWAIT_CUE 70
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 70
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 70
    WALK_RELATIVE speed=256 dx=0 dy=-88
    HALT
end

