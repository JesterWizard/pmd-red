script g0_s0_swellow   # EoS actor NPC_OOSUBAME, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    # EoS: its own coroutine (def ... for actor NPC_OOSUBAME)
    SELECT_ANIMATION 2
    WAIT 30
  LABEL 0
  LABEL 1
    EMOTION_EFFECT SMILE
    WAIT_RANDOM 90 180
    EMOTION_EFFECT NONE
    WAIT_RANDOM 60 180
    WAIT 1   # (a forever loop)
    JUMP_LABEL 1
  LABEL 2
end

