script g1_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    SELECT_MAP SKY_GUILD_B1F
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=228 y=152   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    WAIT 30
    AWAIT_CUE_COND 64 1   # -> CHATOT: batch 1
    WAIT 30
    SELECT_LIVES group=-1 sector=2   # EoS supervision_Acting(2)
    WAIT 30
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    WAIT 30
    SELECT_LIVES group=-1 sector=3   # EoS supervision_Acting(3)
    WAIT 30
    AWAIT_CUE_COND 68 1   # -> PLAYER: batch 1
    SKY_CAMERA_MOVE dy=4 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m3', 31.5, 28.5>);
    SKY_CAMERA_MOVE_X dx=-88 speed=256
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 64 2   # -> CHATOT: batch 2
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE 69   # <- PLAYER done
    AWAIT_CUE_COND 68 2   # -> PLAYER: batch 2
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE 69   # <- PLAYER done
    # eos: WaitExecutePerformer(0); (the camera has arrived)
    WAIT 30
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" You're just beginners."
    MSG_NPC who=CHATOT text=" We'll have you start off with\nthis assignment. ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 3   # -> CHATOT: batch 3
    AWAIT_CUE 65   # <- CHATOT done
    MSG_NPC who=CHATOT text=" This is the Job Bulletin Board.\nPokémon from various regions post job\nrequests here."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 4   # -> CHATOT: batch 4
    AWAIT_CUE 65   # <- CHATOT done
    MSG_NPC who=CHATOT text=" You're aware that bad Pokémon\nare cropping up in greater numbers, right?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Yup.{WAIT_PRESS} Because the flow of time is\ngetting messed up. It's wreaking havoc, right?"
    MSG_NPC who=PARTNER text=" Which is why lots of bad\nPokémon are appearing!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(The flow of time is getting messed up?)"
    MSG_QUIET who=PLAYER text="(Time? As in hours and minutes?{WAIT_PRESS} Do they mean\nsomething has gone wrong with time here?)"
    MSG_QUIET who=PLAYER text="(And, because of that, more and more bad\nPokémon are popping up?)"
    MSG_QUIET who=PLAYER text="(What's going on here?!)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" Precisely.{WAIT_PRESS} Time getting out of\nwhack has caused an outbreak of bad Pokémon.\nPerhaps because of all that..."
    MSG_NPC who=CHATOT text=" We have noticed an increase\nin the number of jobs."
    MSG_NPC who=CHATOT text=" In addition...and it's unknown if\nthis is because of time's influence..."
    MSG_NPC who=CHATOT text=" There has also been a mass\noutbreak of...{WAIT_PRESS}mystery dungeons."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_QUIET who=PLAYER text="(Mystery dungeons?!)"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 3   # -> PARTNER: batch 3
    AWAIT_CUE 67   # <- PARTNER done
    MSG_NPC who=PARTNER text=" So, {NAME_0}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 3   # -> PLAYER: batch 3
    AWAIT_CUE 69   # <- PLAYER done
    MSG_NPC who=PARTNER text=" You know how we got my Relic\nFragment back yesterday?"
    MSG_NPC who=PARTNER text=" The place where we found it\nwas a mystery dungeon."
    MSG_NPC who=PARTNER text=" A mystery dungeon changes each\ntime you go into it. There's a different layout\nand different items every time you enter!"
    MSG_NPC who=PARTNER text=" If you faint in the middle of a\ndungeon, you lose half of your money..."
    MSG_NPC who=PARTNER text=" You can even lose half your\nitems or more..."
    MSG_NPC who=PARTNER text=" Finally, you get kicked right out.\nThey're very strange places."
    PORTRAIT place=KEEP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" But every time you go inside\none, there are always new things to discover!"
    MSG_NPC who=PARTNER text=" They really are fantastic places\nto go explore!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_WING_FLAP   # EoS se_Play(5122)
    AWAIT_CUE_COND 64 5   # -> CHATOT: batch 5
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 64 6   # -> CHATOT: batch 6
    MSG_NPC who=CHATOT text=" Well! You're quite informed,\naren't you! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 4   # -> PARTNER: batch 4
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 68 4   # -> PLAYER: batch 4
    AWAIT_CUE 69   # <- PLAYER done
    PORTRAIT place=KEEP who=CHATOT emotion=HAPPY
    MSG_NPC who=CHATOT text=" That makes things much easier\nfor me to explain! ♪"
    MSG_NPC who=CHATOT text=" Jobs all take place in\nmystery dungeons."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 7   # -> CHATOT: batch 7
    AWAIT_CUE 65   # <- CHATOT done
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" So...{WAIT_PRESS}let's look for a job that you\nshould perform! ♪"
    TEXTBOX_CLEAR
    WAIT 30
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    AWAIT_CUE_COND 64 8   # -> CHATOT: batch 8
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 64 9   # -> CHATOT: batch 9
    AWAIT_CUE 65   # <- CHATOT done
    MSG_NPC who=CHATOT text=" Ah, yes. ♪ Maybe this will do?"
    TEXTBOX_CLEAR
    # eos: if ( variation ): never in the story (EoS's variation run)
    JUMP_LABEL 1
  LABEL 0
    JUMP_LABEL 1
  LABEL 1
  LABEL 2
    AWAIT_CUE_COND 64 10   # -> CHATOT: batch 10
    AWAIT_CUE_COND 66 5   # -> PARTNER: batch 5
    AWAIT_CUE_COND 68 5   # -> PLAYER: batch 5
    AWAIT_CUE 65   # <- CHATOT done
    FANFARE_PLAY2 SE_SKY_TAIL_FEATHERS   # EoS se_Play(5124)
    WAIT 45
    AWAIT_CUE_COND 64 11   # -> CHATOT: batch 11
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 64 12   # -> CHATOT: batch 12
    WAIT 20
    AWAIT_CUE_COND 68 6   # -> PLAYER: batch 6
    BGM_FADEOUT 120
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh, really? Let's read it!"
    TEXTBOX_CLEAR
    MSG_INSTANT text="\"Hello! My name is Spoink!\""   # EoS message_Mail
    MSG_INSTANT text="\"An outlaw has run off with my most prized\npossession. My precious pearl!\""   # EoS message_Mail
    MSG_INSTANT text="\"That pearl is life itself...to me!\""   # EoS message_Mail
    MSG_INSTANT text="\"I just can't seem to settle down if that pearl\nisn't in its proper place atop my head!\""   # EoS message_Mail
    MSG_INSTANT text="\"But I've heard my pearl has been sighted!\""   # EoS message_Mail
    MSG_INSTANT text="\"It's said to be on a rocky bluff. But this bluff\nis reported to be extremely unsafe.\""   # EoS message_Mail
    MSG_INSTANT text="\"I could never go somewhere so frightening!\""   # EoS message_Mail
    MSG_INSTANT text="\"Oh, friendly readers! Would you be so kind as\nto go to the bluff and get my pearl?\""   # EoS message_Mail
    MSG_INSTANT text="\"I beg your help, exploration team members!\"\n\n                                        From Spoink"   # EoS message_Mail
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" Wait a second..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    AWAIT_CUE_COND 66 6   # -> PARTNER: batch 6
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 66 7   # -> PARTNER: batch 7
    PORTRAIT place=KEEP who=PARTNER emotion=ANGRY
    MSG_NPC who=PARTNER text=" We're going to fetch an item\nthat someone dropped?"
    # eos: message_KeyWait(); (the line above waits for a button)
    AWAIT_CUE_COND 66 8   # -> PARTNER: batch 8
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" I'd rather go on a bigger\nadventure than that."
    PORTRAIT place=KEEP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" I'd rather look for treasure or\nexplore unknown places. Things like that!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_WING_FLAP   # EoS se_Play(5122)
    AWAIT_CUE_COND 64 13   # -> CHATOT: batch 13
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 64 14   # -> CHATOT: batch 14
    AWAIT_CUE_COND 68 7   # -> PLAYER: batch 7
    PORTRAIT place=KEEP who=CHATOT emotion=ANGRY
    MSG_NPC who=CHATOT text=" Hush!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 66 9   # -> PARTNER: batch 9
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Yikes!"
    AWAIT_CUE 67   # <- PARTNER done
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" It's important that you rookies\npay your dues!"
    MSG_NPC who=CHATOT text=" Now pay attention!{WAIT_PRESS} I'll repeat\nthe warnings again to make sure they stick!"
    MSG_NPC who=CHATOT text=" You'll be forced out of a dungeon\nand sent back here if either of you faints."
    MSG_NPC who=CHATOT text=" You'll lose half your money!{WAIT_PRESS}\nAnd you could lose half your items or more.\nYou'd best be careful!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_WING_FLAP   # EoS se_Play(5122)
    AWAIT_CUE_COND 64 15   # -> CHATOT: batch 15
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 64 16   # -> CHATOT: batch 16
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" If you've understood all that,\nI suggest you get on with the job! ♪"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 66 10   # -> PARTNER: batch 10
    PORTRAIT place=KEEP who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Hmm..."
    AWAIT_CUE 67   # <- PARTNER done
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT 30
    CMD_UNK_AF RESCUE_DUNGEON_THUNDERWAVE_CAVE TRUE   # EoS dungeon_mode(3) = DMODE_OPEN;
    RET
end

