  LABEL 4
    WALK_RELATIVE speed=204 dx=0 dy=-64
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 5
    END_DELETE
end

actors g3_s0_lives
    actor kind=0 facing=NORTH x=33.5 y=30.5 script=g3_s0_player   # EoS PLAYER
    actor kind=34 facing=NORTH x=29.5 y=30.5 script=g3_s0_partner   # EoS ATTENDANT1
    actor kind=SKY_LIVES_CHATOT facing=SOUTHEAST x=27.5 y=25.5 script=g3_s0_chatot   # EoS NPC_PERAPPU
    actor kind=SKY_LIVES_SPOINK facing=SOUTH x=31.5 y=26.5 script=g3_s0_spoink   # EoS NPC_BANEBUU
end

stations
    g0_s0_station
    g1_s0_station
    g2_s0_station
    g3_s0_station
end

sectors g0
    sector actors=g0_s0_lives station=0
    sector actors=g0_s1_lives
end

sectors g1
    sector actors=g1_s0_lives station=1
    sector actors=g1_s1_lives
    sector actors=g1_s2_lives
    sector actors=g1_s3_lives
end

sectors g2
    sector actors=g2_s0_lives station=2
end

sectors g3
    sector actors=g3_s0_lives station=3
end

groups
    g0
    g1
    g2
    g3
end
