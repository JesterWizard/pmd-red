# ------------------------------------------------------------------------
# group 15: EoS m02a0801 (D02P31A)
# ------------------------------------------------------------------------

script g15_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    # eos: if ( variation ): never in the story (EoS's variation run)
    # eos: back_SetDungeonBanner(3, 0): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    FADE_IN wait=TRUE frames=16
    SET_PLACE_MODE 4
    WAIT 60
    FADE_OUT wait=TRUE frames=16
    WAIT 15
    CJUMP_SCENARIO_1 SCENARIO_MAIN   # EoS switch ( scn($SCENARIO_MAIN)[1] )
    COND_EQUAL 3 0
    JUMP_LABEL 2
  LABEL 0
    SCENARIO_CALC SCENARIO_MAIN 3 6   # EoS scenario numbers
  LABEL 1
    SELECT_MAP SKY_DRENCHED_BLUFF_END
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=124 y=216   # EoS camera_SetMyself<performer 0>
    WAIT 1
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    FADE_IN wait=TRUE frames=30
    AWAIT_CUE 65   # <- PLAYER done
    AWAIT_CUE 67   # <- PARTNER done
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh! Over there!"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=-92 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m2', 30, 24.5>);
    SKY_CAMERA_MOVE_X dx=4 speed=256
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    WAIT 5
    AWAIT_CUE_COND 66 3   # -> PARTNER: batch 3
    AWAIT_CUE 65   # <- PLAYER done
    AWAIT_CUE_COND 64 3   # -> PLAYER: batch 3
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 66 4   # -> PARTNER: batch 4
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 30
    AWAIT_CUE_COND 66 5   # -> PARTNER: batch 5
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 64 4   # -> PLAYER: batch 4
    MSG_NPC who=PARTNER text=" This has to be Spoink's pearl!"
    MSG_NPC who=PARTNER text=" Quick! Let's take it back!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 5   # -> PLAYER: batch 5
    AWAIT_CUE_COND 66 6   # -> PARTNER: batch 6
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 30
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_IN_THE_DEPTHS_OF_THE_PIT
    # eos: switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) (EoS's team set-up before a dungeon: Red's own runs)
    RET
  LABEL 2
  LABEL 3
    SCENARIO_CALC SCENARIO_MAIN 3 7   # EoS scenario numbers
    JUMP_LABEL 1
  LABEL 4
    JUMP_LABEL 7
  LABEL 5
  LABEL 6
    # eos: switch ( ProcessSpecial(53, -1, 0) ) (EoS's demo version only)
    TEXTBOX_AUTO_PRESS 300 300   # EoS message_SetWaitMode
    MSG_NPC who=-1 text="{CENTER_ALIGN}Thanks for playing!\n{CENTER_ALIGN}We hope you enjoyed\n{CENTER_ALIGN}the demo!"   # EoS message_Explanation
    # eos: message_KeyWait(); (the line above waits for a button)
    SKY_DEMO_TO_TITLE   # EoS ProcessSpecial(PROCESS_SPECIAL_JUMP_TO_TITLE_SCREEN)
    RET
    JUMP_LABEL 7
  LABEL 7
    RET
end

