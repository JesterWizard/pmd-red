# ------------------------------------------------------------------------
# group 19: EoS m02a1003 (G01P07C)
# ------------------------------------------------------------------------

script g19_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    # eos: if ( variation ): never in the story (EoS's variation run)
    # eos: back2_SetMode(4); (the top screen)
    # eos: back2_SetGround(LEVEL_V02P06A); (the top screen's picture: NIGHT_SKY; left out as in chapter 1)
    # eos: camera2_SetPositionMark(Position<'m0', 19.5, 15.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 60); (the top screen)
    WAIT 150
    # eos: screen2_FadeOut(1, 60); (the top screen)
    # eos: back2_SetMode(0); (the top screen)
    SELECT_MAP SKY_GUILD_CREW_ROOM_NIGHT
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    FADE_IN wait=TRUE frames=60   # EoS screen_FadeChange(1, 60, 0, 192); (to full brightness)
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_GOODNIGHT
    WAIT 30
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" Say, {NAME_0}..."
    MSG_NPC who=PARTNER text=" Today was pretty hectic with\neverything we went through, wasn't it?"
    MSG_NPC who=PARTNER text=" But I'm glad our first job turned\nout so well."
    MSG_NPC who=PARTNER text=" I was really mad about how\nWigglytuff's Guild took most of the money..."
    MSG_NPC who=PARTNER text=" That's just the cost of training,\nI guess. We can't do anything about it."
    MSG_NPC who=PARTNER text=" But what made me really happy\ntoday, though, was getting thanked by Spoink!"
    TEXTBOX_CLEAR
    WAIT 45
    MSG_NPC who=PARTNER text=" Yawn... I'm getting sleepy."
    MSG_NPC who=PARTNER text=" I'm going to sleep.{WAIT_PRESS} Let's try our\nbest again tomorrow."
    MSG_NPC who=PARTNER text=" Sleep tight, {NAME_0}..."
    TEXTBOX_CLEAR
    WAIT 30
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    WAIT 10
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    WAIT 80
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=120
    WAIT_BGM MUS_SKY_GOODNIGHT
    WAIT 30
    # eos: if ( variation ): never in the story (EoS's variation run)
    SCENARIO_CALC SCENARIO_MAIN 4 0   # EoS scenario numbers
    RET
    JUMP_LABEL 1
  LABEL 0
    JUMP_LABEL 3
    JUMP_LABEL 1
  LABEL 1
    JUMP_LABEL 4
  LABEL 2
  LABEL 3
    # eos: switch ( ProcessSpecial(53, -1, 0) ) (EoS's demo version only)
    TEXTBOX_AUTO_PRESS 300 300   # EoS message_SetWaitMode
    MSG_NPC who=-1 text="{CENTER_ALIGN}Thanks for playing!\n{CENTER_ALIGN}We hope you enjoyed\n{CENTER_ALIGN}the demo!"   # EoS message_Explanation
    # eos: message_KeyWait(); (the line above waits for a button)
    SKY_DEMO_TO_TITLE   # EoS ProcessSpecial(PROCESS_SPECIAL_JUMP_TO_TITLE_SCREEN)
    RET
    JUMP_LABEL 4
  LABEL 4
    RET
end

