script g10_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    SELECT_ANIMATION 2   # TODO anim: EoS SetAnimation(68) is SELECT_ANIMATION 28 once the hero and partner have EoS ground groups (ch2-heroanims)
    WAIT 30   # TODO anim: EoS WaitAnimation (STOP_ANIMATION_ON_CURRENT_FRAME once the animation is there)
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    SELECT_ANIMATION 2
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    CALL_SCRIPT JUMP_SURPRISE_FUNC   # EoS CORO_JUMP_SURPRISE_FUNC_SERIES
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    WALK_RELATIVE speed=768 dx=-160 dy=0
    HALT
end

script g10_s0_loudred   # EoS actor NPC_DOGOOMU, layer 0
