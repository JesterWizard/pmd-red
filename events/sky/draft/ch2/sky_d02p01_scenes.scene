    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Now, this could just be a wild\nguess on my part, but..."
    MSG_NPC who=CHATOT text=" I would guess that it's because\nyou fail so often. Our Guildmaster must be\nseething with anger over you."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
