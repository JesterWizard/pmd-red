# ------------------------------------------------------------------------
# group 9: EoS m02a0113 (G01P07C)
# ------------------------------------------------------------------------

script g9_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    JUMPIF_ARRAY SKY_SCENARIO_MAIN_BIT_FLAG 8 3
    # eos: back2_SetMode(4); (the top screen)
    # eos: back2_SetGround(LEVEL_V02P06A); (the top screen's picture: NIGHT_SKY; left out as in chapter 1)
    # eos: camera2_SetPositionMark(Position<'m0', 19.5, 15.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 60); (the top screen)
    WAIT 150
    # eos: screen2_FadeOut(1, 60); (the top screen)
    # eos: back2_SetMode(0); (the top screen)
    SELECT_MAP SKY_GUILD_CREW_ROOM_NIGHT
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    FADE_IN wait=TRUE frames=60   # EoS screen_FadeChange(1, 60, 0, 192); (to full brightness)
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_GOODNIGHT
    WAIT 30
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" ..."
    MSG_NPC who=PARTNER text=" ......"
    MSG_NPC who=PARTNER text=" Say, are you still awake,\n{NAME_0}?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" My heart's been racing all day..."
    MSG_NPC who=PARTNER text=" But I'm glad I finally forced\nmyself to come here."
    MSG_NPC who=PARTNER text=" I thought Wigglytuff would be\nkind of scary, but he was pretty nice."
    MSG_NPC who=PARTNER text=" We'll experience all sorts of\nnew stuff starting tomorrow, but I'm not\nvery frightened."
    MSG_NPC who=PARTNER text=" Actually, I can't wait to find\nout what new adventures are in store for us!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" I'm getting a little sleepy..."
    MSG_NPC who=PARTNER text=" Let's give it our all tomorrow."
    MSG_NPC who=PARTNER text=" OK, {NAME_0}. Sleep tight."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    WAIT 90
    BGM_FADEOUT 120
    # eos: message_EmptyActor(); (no speaker)
    MSG_QUIET who=-1 text="(Um...)"
    MSG_QUIET who=-1 text="(Now I'm suddenly apprenticing at the guild...)"
    MSG_QUIET who=-1 text="(I gotta admit, it's pretty exciting to be in an\nexploration team.)"
    MSG_QUIET who=-1 text="(And it's fun to be friends with\n{NAME_1}...)"
    MSG_QUIET who=-1 text="(But first things first...)"
    MSG_QUIET who=-1 text="(Who am I?)"
    MSG_QUIET who=-1 text="(How did I turn into a Pokémon?)"
    MSG_QUIET who=-1 text="(How did I end up unconscious on that beach?)"
    MSG_QUIET who=-1 text="(I'm feeling sleepy too...)"
    MSG_QUIET who=-1 text="(Well, thinking about it won't help right now.\nI'd better focus on the guild's work for now...)"
    MSG_QUIET who=-1 text="(If I do that, well, everything should become\nclear eventually...)"
    MSG_QUIET who=-1 text="(I'll surely get to the bottom of this in time.)"
    TEXTBOX_CLEAR
    WAIT 30
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    WAIT 120
    FADE_OUT wait=TRUE frames=120
    WAIT 60
    SET_ARRAYVAL SKY_SCENARIO_MAIN_BIT_FLAG 8 1   # EoS $SCENARIO_MAIN_BIT_FLAG[8] = 1;
    # eos: $COMPULSORY_SAVE_POINT = 1; (EoS's bed save point: nothing on the GBA)
    ASK2 flag=FALSE default=-1 who=-1 text="{CENTER_ALIGN}Would you like to save your adventure?"
    CHOICE label=0 text="Save"
    CHOICE label=2 text="Don't save"
  LABEL 0
    TEXTBOX_CLEAR
    SKY_SAVE_GAME   # EoS CORO_HANYOU_SAVE_FUNC
    COND_EQUAL 0 1
    MSG_INSTANT text="{CENTER_ALIGN}Your adventure has been saved."
    JUMP_LABEL 2
  LABEL 1
    MSG_INSTANT text="{CENTER_ALIGN}The data could not be saved."
  LABEL 2
    TEXTBOX_CLEAR
    JUMP_LABEL 4
    JUMP_LABEL 5
  LABEL 3
  LABEL 4
    SET_ARRAYVAL SKY_SCENARIO_MAIN_BIT_FLAG 8 0   # EoS $SCENARIO_MAIN_BIT_FLAG[8] = 0;
    WAIT 30
    FANFARE_PLAY 207   # EoS me_Play(7)
    MSG_NPC who=-1 text="{CENTER_ALIGN}Exploration Team\n{CENTER_ALIGN}Quick Tip"   # EoS message_Explanation
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text="{CENTER_ALIGN}You can save a record of your progress\n{CENTER_ALIGN}by climbing onto your bed from now on."   # EoS message_Explanation
    MSG_NPC who=-1 text="{CENTER_ALIGN}So whenever you want to save your\n{CENTER_ALIGN}progress, just climb onto your bed."   # EoS message_Explanation
    TEXTBOX_CLEAR
    WAIT 60
    RET
    JUMP_LABEL 5
  LABEL 5
    RET
end

