# group 1: EoS m02a0101 (G01P01B)
# ------------------------------------------------------------------------

script g1_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=DIGLETT id=SKY_LIVES_DIGLETT   # the text names it
    BGM_STOP
    # eos: chapter card "The New Guild Recruits" (back_SetBanner2(LEVEL_G01P07C, 0, 148, 168, 2,): shown at the next SELECT_MAP (src/chapter_titles.c, queued by EVENT_DIVIDE)
    SELECT_MAP SKY_GUILD_ENTRANCE   # the chapter card, before the scene's pictures
    # eos: screen_FadeIn(1, 45); (the chapter card's)
    # eos: Wait(160); (the chapter card's)
    # eos: screen_FadeOut(1, 45); (the chapter card's)
    # eos: Wait(15); (the chapter card's)
    SCENARIO_CALC SCENARIO_MAIN 3 1   # EoS scenario numbers
    # eos: back2_SetMode(5); (the top screen)
    SKY_CUTAWAY cg=GUILD_GATE frames=244   # EoS: the main screen's picture (and its waits)
    # eos: supervision_Acting(1); (only the camera's performer)
    # eos: camera_SetMyself<performer 0>(); (the CG's view, as cropped)
    # eos: MovePositionOffset<performer 0>(0.5, 0, -32); (the CG's view, as cropped)
    BGM_FADEIN frames=60 song=SKY_FIRE_CRACKLING
    # eos: screen2_FadeIn(0, 30); (the top screen)
    # eos: screen_FadeIn(1, 30); (the CG fades in itself)
    # eos: WaitExecutePerformer(0); (the CG is up)
    # eos: Wait(180); (the CG is up)
    # eos: screen2_FadeOut(0, 30); (the top screen)
    # eos: screen_FadeOut(1, 30); (the CG fades out itself)
    # eos: back2_SetMode(0); (the top screen)
    # eos: supervision_RemoveActing(1);
    WAIT 30
    # eos: back2_SetMode(4); (the top screen)
    SELECT_MAP SKY_GUILD_DUSK2
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=118 y=112   # the pan's last view (EoS's centre: (124, 120))
    # eos: screen2_FadeIn(0, 30); (the top screen)
    WAIT 1   # the actors take their poses; the pan draws them
    SKY_CUTAWAY cg=GUILD_SKY_SCROLL frames=90   # EoS: the top screen's picture over the map: pan down to it
    FADE_IN wait=TRUE frames=0   # the pan ends on this exact view
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" This is Wigglytuff's Guild."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=PARTNER text=" To form an exploration team,\nyou need to register your team here."
    MSG_NPC who=PARTNER text=" Then you have to train until you\nbecome a first-rate exploration team."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 20
    ALERT_CUE 64   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Y-y-yikes!"
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    TEXTBOX_CLEAR
    WAIT 20
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" Isn't this place just a little bit\nodd? It just is!"
    TEXTBOX_CLEAR
    WAIT 20
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" No...!{WAIT_PRESS} I've got {NAME_0} with\nme this time."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    MSG_NPC who=PARTNER text=" I have to be brave."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    WAIT 20
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    ALERT_CUE 64   # -> PARTNER
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Pokémon detected!{WAIT_PRESS} Pokémon detected!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" Whose footprint?{WAIT_PRESS} Whose footprint?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" The footprint is {POKEMON_1}'s!{WAIT_PRESS}\nThe footprint is {POKEMON_1}'s!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Waah!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    WAIT 10
    PORTRAIT place=KEEP who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" N-no. I can't lose it now..."
    TEXTBOX_CLEAR
    WAIT 30
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" ...{WAIT_PRESS}You may ENTER!"
    MSG_NPC who=-1 text=" Someone's with you!{WAIT_PRESS} So get that stranger\nto stand up THERE!"
    TEXTBOX_CLEAR
    WAIT 20
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    WAIT 90
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    WAIT 20
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" I think they mean you,\n{NAME_0}."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    MSG_NPC who=PARTNER text=" They said to stand up here."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PARTNER
    WAIT 20
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    # eos: screen2_FadeOut(1, 15); (the top screen)
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=SENTRY_GRATE frames=90   # EoS: the top screen's picture
    FADE_IN wait=TRUE frames=20
    # eos: camera2_SetPositionMark(Position<'m2', 19.5, 17.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    # eos: Wait(30); (the CG is up)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=NORMAL
    MSG_QUIET who=PLAYER text="(............)"
    MSG_QUIET who=PLAYER text="(There's a grate covering the hole...)"
    MSG_QUIET who=PLAYER text="(It's made so that no one can fall through...)"
    PORTRAIT place=KEEP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(Still, it's really strange...)"
    MSG_QUIET who=PLAYER text="(It looks like it will tickle my feet or...)"
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(1, 15); (the top screen)
    # eos: back2_SetGround(LEVEL_V02P01A); (the top screen's picture again)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    WAIT 45
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    ALERT_CUE 66   # -> PLAYER
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Hey, you! Stranger!{WAIT_PRESS} Get on the GRATE!"
    TEXTBOX_CLEAR
    WAIT 15
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    WAIT 20
    MSG_NPC who=-1 text=" Pokémon detected!{WAIT_PRESS} Pokémon detected!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" Whose footprint?{WAIT_PRESS} Whose footprint?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" The footprint is...{WAIT_PRESS} The footprint is... Um..."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" What's the matter?!{WAIT_PRESS} Sentry!{WAIT_PRESS} Sentry?!"
    MSG_NPC who=-1 text=" What's wrong, sentry Diglett?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_SetActor(ACTOR_NPC_DIGUDA);
    MSG_NPC who=DIGLETT text=" Umm... Er..."
    TEXTBOX_CLEAR
    BGM_FADEOUT 60
    # eos: screen2_FadeOut(0, 30); (the top screen)
    FADE_OUT wait=TRUE frames=30
    # eos: back2_SetMode(0); (the top screen)
    RET
end

script g1_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 66
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHWEST
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 66
    WALK_RELATIVE speed=204 dx=-16 dy=-32   # EoS MovePositionMark to Position<'m3', 30, 22>
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    HALT
end

script g1_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    SELECT_ANIMATION 9
    AWAIT_CUE 64
    SELECT_ANIMATION 2
    AWAIT_CUE 64
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    CALL_SCRIPT JUMP_HAPPY_FUNC   # EoS CORO_JUMP_HAPPY_FUNC_SERIES
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    WALK_RELATIVE speed=204 dx=16 dy=-32   # EoS MovePositionMark to Position<'m0', 30, 22>
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    EMOTION_EFFECT SHOCK
    AWAIT_CUE 64
    EMOTION_EFFECT SWEAT
    AWAIT_CUE 64
    SELECT_ANIMATION 9
    AWAIT_CUE 64
    SELECT_ANIMATION 2
    AWAIT_CUE 64
    WALK_RELATIVE speed=204 dx=-36 dy=0   # EoS MovePositionMark to Position<'m1', 25.5, 22>
    ROTATE_TO speed=4 turn=SPINRIGHT1 direction=EAST
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTHEAST
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    CALL_SCRIPT SWEAT_FUNC
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=EAST
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTHEAST
    AWAIT_CUE 64
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=EAST
    HALT
end

actors g1_s0_lives
    actor kind=0 facing=NORTH x=32 y=26.5 script=g1_s0_player   # EoS PLAYER
    actor kind=34 facing=NORTH x=28 y=26.5 script=g1_s0_partner   # EoS ATTENDANT1
end

