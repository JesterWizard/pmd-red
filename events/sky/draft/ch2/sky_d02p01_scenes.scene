script g7_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=WIGGLYTUFF id=SKY_LIVES_WIGGLYTUFF   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_STOP
    SELECT_MAP SKY_GUILD_WIGGLYTUFF
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=88 y=152   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Guildmaster!{WAIT_PRESS} I present to you\ntwo Pokémon who wish to join our guild as\napprentices."
    TEXTBOX_CLEAR
    WAIT 60
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    WAIT 30
    MSG_NPC who=CHATOT text=" Guildmaster...{WAIT_PRESS}um...{WAIT_PRESS}Guildmaster?"
    TEXTBOX_CLEAR
    WAIT 60
    AWAIT_CUE_COND 66 0   # -> WIGGLYTUFF (waits until it is ready)
    AWAIT_CUE 67   # <- WIGGLYTUFF done
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    BGM_SWITCH SKY_GUILDMASTER_WIGGLYTUFF
    PORTRAIT place=MIDLEFT_TOP who=WIGGLYTUFF emotion=NORMAL
    MSG_NPC who=WIGGLYTUFF text=" Hiya!"
    MSG_NPC who=WIGGLYTUFF text=" I'm Wigglytuff!{WAIT_PRESS} I'm the guild's\nGuildmaster!"
    MSG_NPC who=WIGGLYTUFF text=" You want to form an exploration\nteam?{WAIT_PRESS} Then, let's go for it!"
    MSG_NPC who=WIGGLYTUFF text=" First we must register your\nexploration team's name!"
    MSG_NPC who=WIGGLYTUFF text=" So tell me your team's name?"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Oh? Our team's name?"
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" I didn't think about a team name."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 71   # <- PARTNER done
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" So what do you think would be a\ngood name for us, {NAME_0}?"
    TEXTBOX_CLEAR
    RENAME_TEAM   # EoS message_Menu(MENU_TEAM_NAME)
    # eos: $PERFORMANCE_PROGRESS_LIST[1] = 1; (unlocks EoS menus: nothing on the GBA)
    FANFARE_PLAY2 464   # EoS se_Play(8965)
    ALERT_CUE 70   # -> PARTNER
    MSG_NPC who=PARTNER text=" ...{TEAM_NAME}?!{WAIT_PRESS}\nTeam {TEAM_NAME}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 71   # <- PARTNER done
    ALERT_CUE 70   # -> PARTNER
    AWAIT_CUE 71   # <- PARTNER done
    ALERT_CUE 70   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" I like it! It's a good name!{WAIT_PRESS}\nIt's perfect for us!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    MSG_NPC who=WIGGLYTUFF text=" All settled, then!{WAIT_PRESS} I'll register\nyour team as {TEAM_NAME}."
    MSG_NPC who=WIGGLYTUFF text=" Registering! ♪ Registering! ♪"
    MSG_NPC who=WIGGLYTUFF text=" All registered..."
    PORTRAIT place=KEEP who=WIGGLYTUFF emotion=SIGH
    MSG_NPC who=WIGGLYTUFF text=" YOOM...TAH!"
    ALERT_CUE 66   # -> WIGGLYTUFF
    BGM_STOP
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 5
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    AWAIT_CUE 67   # <- WIGGLYTUFF done
    ALERT_CUE 66   # -> WIGGLYTUFF
    TEXTBOX_CLEAR
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    MSG_NPC who=WIGGLYTUFF text=" Congratulations!{WAIT_PRESS} From now on,\nyou're an official exploration team!"
    MSG_NPC who=WIGGLYTUFF text=" I present you with this in\ncommemoration."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> WIGGLYTUFF (waits until it is ready)
    AWAIT_CUE 67   # <- WIGGLYTUFF done
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    FANFARE_PLAY2 SE_SKY_RELIC_FRAGMENT   # EoS se_Play(6410)
    SELECT_OBJECTS group=-1 sector=1   # EoS supervision_Acting(1)
    # eos: $PERFORMANCE_PROGRESS_LIST[2] = 1; (unlocks EoS menus: nothing on the GBA)
    WAIT 30
    MSG_INSTANT text="{CENTER_ALIGN}Wigglytuff set down\n{CENTER_ALIGN}a Pokémon Exploration Team Kit!"   # EoS message_Mail
    TEXTBOX_CLEAR
    ALERT_CUE 66   # -> WIGGLYTUFF
    AWAIT_CUE 67   # <- WIGGLYTUFF done
    ALERT_CUE 66   # -> WIGGLYTUFF
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" A Pokémon Exploration\nTeam Kit?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=WIGGLYTUFF emotion=NORMAL
    MSG_NPC who=WIGGLYTUFF text=" Yup. It's what every exploration\nteam needs."
    MSG_NPC who=WIGGLYTUFF text=" Quick, open it up."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 71   # <- PARTNER done
    ALERT_CUE 70   # -> PARTNER
    AWAIT_CUE 69   # <- PLAYER done
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 69   # <- PLAYER done
    WAIT 15
    FANFARE_PLAY2 SE_SKY_KIT_OPEN   # EoS se_Play(6411)
    AWAIT_CUE_COND 72 0   # -> G01P05A1_106 (waits until it is ready)
    AWAIT_CUE 73   # <- G01P05A1_106 done
    WAIT 30
    MSG_INSTANT text="{CENTER_ALIGN}{NAME_1} opened the\n{CENTER_ALIGN}Pokémon Exploration Team Kit."   # EoS message_Mail
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=30
    WAIT 10
    SELECT_MAP SKY_KIT_OPEN
    # eos: supervision_RemoveActing(0);
    # eos: supervision_Acting(2); (only the camera's performer)
    SKY_CAMERA_SET x=12 y=32   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    WAIT 30
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}There was an\n{CENTER_ALIGN}Explorer Badge inside..."   # EoS message_Mail
    WAIT_FANFARE1 203
    # eos: message_KeyWait(); (the line above waits for a button)
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}And a Wonder Map..."   # EoS message_Mail
    WAIT_FANFARE1 203
    # eos: message_KeyWait(); (the line above waits for a button)
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}And a Treasure Bag!"   # EoS message_Mail
    WAIT_FANFARE1 203
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" Yes! There are all sorts of\ngreat items in here!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=WIGGLYTUFF emotion=NORMAL
    MSG_NPC who=WIGGLYTUFF text=" That's your Explorer Badge! It's\nyour official team identification!"
    MSG_NPC who=WIGGLYTUFF text=" And there's the Wonder Map,\nwhich is a wonder of convenience!"
    MSG_NPC who=WIGGLYTUFF text=" Finally, there's a Treasure Bag.{WAIT_PRESS} \nIt lets you carry items you find in dungeons."
    MSG_NPC who=WIGGLYTUFF text=" Your successes as an exploration\nteam can lead to bigger and bigger space for\nyour Treasure Bag."
    MSG_NPC who=WIGGLYTUFF text=" It's a very wonderful bag! ♪"
    MSG_NPC who=WIGGLYTUFF text=" Have a peek inside your\nTreasure Bag."
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=30
    # eos: supervision_RemoveActing(2);
    SELECT_MAP SKY_GUILD_WIGGLYTUFF
    SELECT_ENTITIES group=-1 sector=3   # EoS supervision_Acting(3)
    SKY_CAMERA_SET x=88 y=152   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 74 0   # -> G01P05A1_106 (waits until it is ready)
    AWAIT_CUE 75   # <- G01P05A1_106 done
    FADE_IN wait=TRUE frames=30
    WAIT 30
    MSG_INSTANT text="{CENTER_ALIGN}{NAME_1} peered into\n{CENTER_ALIGN}the Treasure Bag."   # EoS message_Mail
    # eos: message_KeyWait(); (the line above waits for a button)
    # eos: switch ( ProcessSpecial(PROCESS_SPECIAL_GET_HERO_KIND, 0, 0) ) { (the story's hero: case 0)
    JUMP_LABEL 0
  LABEL 0
  LABEL 1
    # eos: item_Set(0, 37, 0); (item slot 0: Def. Scarf)
    SKY_GIVE_ITEM item=ITEM_DEF_SCARF   # EoS item_Set(0, 37); message_Menu(MENU_GIVE_ITEM)
    WAIT 10
  LABEL 2
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}The Def. Scarf\n{CENTER_ALIGN}was inside!"   # EoS message_Mail
    WAIT_FANFARE1 203
    # eos: message_KeyWait(); (the line above waits for a button)
