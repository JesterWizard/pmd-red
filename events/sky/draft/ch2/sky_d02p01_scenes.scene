    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    ROTATE_TO speed=1 turn=SPINLEFT1 direction=SOUTH
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    CALL_SCRIPT JUMP_ANGRY_FUNC   # EoS CORO_JUMP_ANGRY_FUNC_SERIES
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    WALK_RELATIVE speed=204 dx=16 dy=-32   # EoS MovePositionMark to Position<'m6', 45.5, 22.5>
