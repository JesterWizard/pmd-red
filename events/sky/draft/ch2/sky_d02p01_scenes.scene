script g3_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    # eos: back2_SetMode(4); (the top screen)
    SELECT_MAP SKY_GUILD_ENTRANCE
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    SELECT_OBJECTS group=-1 sector=2   # EoS supervision_Acting(2)
    SKY_CAMERA_SET x=118 y=112   # the pan's last view (EoS's centre: (124, 120))
    AWAIT_CUE_COND 64 0   # -> G01P01A3_95 (waits until it is ready)
    BGM_FADEIN frames=120 song=SKY_FIRE_CRACKLING
    # eos: screen2_FadeIn(0, 30); (the top screen)
    WAIT 1   # the actors take their poses; the pan draws them
    SKY_CUTAWAY cg=GUILD_SKY_SCROLL frames=90   # EoS: the top screen's picture over the map: pan down to it
    FADE_IN wait=TRUE frames=0   # the pan ends on this exact view
    SET_PLACE_MODE 4
    WAIT 60
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    WAIT 60
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" What?{WAIT_PRESS} Are they arguing?"
    TEXTBOX_CLEAR
    WAIT 30
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" ...Sorry to make you WAIT."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=-1 text=" Well, it's TRUE that you don't see any\n{POKEMON_0} in these parts..."
    MSG_NPC who=-1 text=" But you don't SEEM to be bad..."
    MSG_NPC who=-1 text=" OK, good enough!{WAIT_PRESS} ENTER!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_GATE_OPEN   # EoS se_Play(6408)
    CAMERA_SHAKE mode=CUSTOM amp=1 period=1   # EoS camera_SetEffect(2, 1, 1.0);
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE_COND 64 0   # -> G01P01A3_95 (waits until it is ready)
    AWAIT_CUE 65   # <- G01P01A3_95 done
    CAMERA_SHAKE mode=OFF amp=0 period=0
    WAIT 20
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Yipes!"
    AWAIT_CUE 69   # <- PARTNER done
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=PARTNER text=" I'm so nervous! So jittery!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" But I'm glad we're finally\nallowed in.{WAIT_PRESS} My heart's pounding, though..."
    MSG_NPC who=PARTNER text=" Anyway, let's go."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 67   # <- PLAYER done
    ALERT_CUE 66   # -> PLAYER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    BGM_FADEOUT 120
    # eos: screen2_FadeOut(0, 30); (the top screen)
    FADE_OUT wait=TRUE frames=30
    # eos: back2_SetMode(0); (the top screen)
    RET
end

script g3_s0_player   # EoS actor PLAYER, layer 0
