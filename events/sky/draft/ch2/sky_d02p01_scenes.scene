# ------------------------------------------------------------------------
# group 20: EoS m02a0501 (G01P03A)
# ------------------------------------------------------------------------

script g20_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_STOP
    # eos: if ( variation ): never in the story (EoS's variation run)
    SELECT_MAP SKY_GUILD_B1F   # EoS LEVEL_S04P01A: a black screen
    SKY_SHOW_MAP FALSE
    FADE_IN wait=TRUE frames=0
    SET_PLACE_MODE 4
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Ugh... That didn't work at all..."
    # eos: message_KeyWait(); (the line above waits for a button)
    FADE_OUT wait=TRUE frames=60
    FADE2_OUT wait=TRUE frames=0
    TEXTBOX_CLEAR
    WAIT 60
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    # eos: if ( variation ): never in the story (EoS's variation run)
    SKY_SHOW_MAP TRUE
    SELECT_MAP SKY_GUILD_B1F
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=136 y=160   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    FADE2_IN wait=TRUE frames=0   # the text layer (screen_FadeOutAll faded it)
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    WAIT 30
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Well...{WAIT_PRESS} It appears that your\nouting was less than a total success."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 64 1   # -> PARTNER: batch 1
    AWAIT_CUE 65   # <- PARTNER done
    MSG_NPC who=PARTNER text=" Ugh..."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" Of course, you're just beginners\nat all this. No need to fret! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 1   # -> CHATOT: batch 1
    PORTRAIT place=KEEP who=CHATOT emotion=HAPPY
    MSG_NPC who=CHATOT text=" These things happen! ♪{WAIT_PRESS} You can\nattempt another challenge tomorrow! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 2   # -> CHATOT: batch 2
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_WIGGLYTUFFS_GUILD
    RET
    JUMP_LABEL 1
  LABEL 0
    # eos: supervision_ExecuteActing(LEVEL_D02P11A, 'M02A0701', 0): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    HALT
    JUMP_LABEL 1
  LABEL 1
    JUMP_LABEL 4
  LABEL 2
  LABEL 3
    # eos: switch ( ProcessSpecial(53, -1, 0) ) (EoS's demo version only)
    TEXTBOX_AUTO_PRESS 300 300   # EoS message_SetWaitMode
    MSG_NPC who=-1 text="{CENTER_ALIGN}Thanks for playing!\n{CENTER_ALIGN}We hope you enjoyed\n{CENTER_ALIGN}the demo!"   # EoS message_Explanation
    # eos: message_KeyWait(); (the line above waits for a button)
    SKY_DEMO_TO_TITLE   # EoS ProcessSpecial(PROCESS_SPECIAL_JUMP_TO_TITLE_SCREEN)
    RET
    JUMP_LABEL 4
  LABEL 4
    RET
end

