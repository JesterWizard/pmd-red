    EMOTION_EFFECT NONE
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    WAIT_RANDOM 120 180
    WAIT 1   # (a forever loop)
    JUMP_LABEL 1
  LABEL 2
end

script g5_s1_chatot   # EoS actor NPC_PERAPPU, layer 1
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=CHATOT id=0x0
