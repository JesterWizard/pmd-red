    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    ROTATE_RELATIVE 4 1 DIR_TRANS_FLIP
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
    ROTATE_TO speed=1 turn=SPINLEFT1 direction=SOUTH
    EMOTION_EFFECT SWEAT
    AWAIT_CUE_COND 73 0   # done: the station waits for this
    AWAIT_CUE 72
