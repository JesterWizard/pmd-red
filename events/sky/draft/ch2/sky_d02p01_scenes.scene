script g6_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    SELECT_MAP SKY_GUILD_B2F_DOOR
    # eos: supervision_LoadStation(LEVEL_G01P04A, 'UM02'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # TODO eos: SetPositionInitial<actor ACTOR_NPC_GUREGGURU>();
    # TODO eos: SetAnimation<actor ACTOR_NPC_GUREGGURU>(2);
    SKY_CAMERA_SET x=208 y=144   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" This is the guild's second\nunderground floor."
    MSG_NPC who=CHATOT text=" This is mainly where the\napprentices work."
    MSG_NPC who=CHATOT text=" Team registration is this way.\nCome along, please."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=4 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m0', 52, 27.5>);
    SKY_CAMERA_MOVE_X dx=96 speed=256
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE 67   # <- PLAYER done
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    WAIT 15
    FANFARE_PLAY2 466   # EoS se_Play(8967)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    WAIT 10
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    PORTRAIT place=MIDRIGHT_TOP who=PARTNER emotion=INSPIRED
    MSG_NPC who=PARTNER text=" Wow! We're two floors under\nthe ground, but you can see outside!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    PORTRAIT place=CENTERLEFT_TOP who=CHATOT emotion=ANGRY
    MSG_NPC who=CHATOT text=" Oh, please! Hush now!"
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" The guild is built into the side\nof a cliff."
    MSG_NPC who=CHATOT text=" It's only natural that you would\nbe able to see outside."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    WAIT 20
    ALERT_CUE 68   # -> PARTNER
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Now, here we are at Guildmaster\nWigglytuff's chamber."
    MSG_NPC who=CHATOT text=" On no account...{WAIT_PRESS} I repeat, on no\naccount should you be discourteous to our\nGuildmaster."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    WAIT 30
    MSG_NPC who=CHATOT text=" Guildmaster!{WAIT_PRESS} It's Chatot! ♪\nI'm coming in!"
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_WIGGLYTUFFS_GUILD
    RET
end

