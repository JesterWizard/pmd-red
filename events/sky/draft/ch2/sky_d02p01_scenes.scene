# ------------------------------------------------------------------------
# group 25: EoS c00a0201 (G01P07A)
# ------------------------------------------------------------------------

script g25_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=LOUDRED id=SKY_LIVES_LOUDRED   # the text names it
    BGM_STOP
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 0   # EoS scenario numbers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 5 0 6   # EoS scenario numbers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 6 0 7   # EoS scenario numbers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 7 0 8   # EoS scenario numbers
    JUMP_LABEL 2
    JUMP_LABEL 9
  LABEL 0
  LABEL 1
    # TODO eos: chapter card "The Scream" (back_SetBanner2(LEVEL_S21P01A, 0, 128, 96, 3,): sky_chapter_card / chapter_titles.h
    FADE_IN wait=TRUE frames=45
    SET_PLACE_MODE 4
    WAIT 160
    FADE_OUT wait=TRUE frames=45
    WAIT 15
  LABEL 2
    SET_ARRAYVAL SKY_SCENARIO_MAIN_BIT_FLAG 1 1   # EoS $SCENARIO_MAIN_BIT_FLAG[1] = 1;
    FADE2_OUT wait=TRUE frames=0   # the text on black (message_Narration)
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}The next morning..."
    TEXTBOX_CLEAR
    WAIT 1
    FADE2_IN wait=TRUE frames=0   # the text layer back after the text on black
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=LOUDRED emotion=NORMAL
    MSG_NPC who=LOUDRED text=" UP AND AT 'EM!{WAIT_PRESS} IT'S MORNING!"
    TEXTBOX_CLEAR
    SELECT_MAP SKY_GUILD_CREW_ROOM
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    FADE_IN wait=TRUE frames=30
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    CAMERA_SHAKE mode=CUSTOM amp=2 period=3   # EoS camera_SetEffect(2, 2, 3.0);
    AWAIT_CUE_COND 68 1   # -> LOUDRED: batch 1
    AWAIT_CUE 69   # <- LOUDRED done
    AWAIT_CUE_COND 68 2   # -> LOUDRED: batch 2
    CAMERA_SHAKE mode=OFF amp=0 period=0
    WAIT 10
    AWAIT_CUE_COND 68 3   # -> LOUDRED: batch 3
    AWAIT_CUE 69   # <- LOUDRED done
    AWAIT_CUE_COND 68 4   # -> LOUDRED: batch 4
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 2
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    AWAIT_CUE_COND 66 3   # -> PARTNER: batch 3
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 2
    AWAIT_CUE_COND 64 3   # -> PLAYER: batch 3
    AWAIT_CUE_COND 66 4   # -> PARTNER: batch 4
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 2
    AWAIT_CUE_COND 64 4   # -> PLAYER: batch 4
    AWAIT_CUE_COND 66 5   # -> PARTNER: batch 5
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 2
    AWAIT_CUE_COND 64 5   # -> PLAYER: batch 5
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL   # TODO emotion: EoS FACE_DIZZY (not among Red's faces yet)
    MSG_NPC who=PARTNER text=" Ugh! Good morning,\n{NAME_0}..."
    TEXTBOX_CLEAR
    WAIT 30
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    AWAIT_CUE_COND 64 6   # -> PLAYER: batch 6
    AWAIT_CUE_COND 66 6   # -> PARTNER: batch 6
    WAIT 10
    AWAIT_CUE_COND 64 7   # -> PLAYER: batch 7
    AWAIT_CUE_COND 66 7   # -> PARTNER: batch 7
    WAIT 30
    # eos: main_SetGround(LEVEL_G01P07A): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    SET_ARRAYVAL SKY_SCENARIO_MAIN_BIT_FLAG 7 1   # EoS $SCENARIO_MAIN_BIT_FLAG[7] = 1;
    ASK2 flag=FALSE default=-1 who=-1 text="{CENTER_ALIGN}Would you like to save your adventure?"
    CHOICE label=3 text="Save"
    CHOICE label=5 text="Don't save"
  LABEL 3
    TEXTBOX_CLEAR
    SKY_SAVE_GAME   # EoS CORO_HANYOU_SAVE_FUNC
    COND_EQUAL 0 4
    MSG_INSTANT text="{CENTER_ALIGN}Your adventure has been saved."
    JUMP_LABEL 5
  LABEL 4
    MSG_INSTANT text="{CENTER_ALIGN}The data could not be saved."
  LABEL 5
    TEXTBOX_CLEAR
    # eos: CallCommon(CORO_EVENT_END_MAPIN): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_ExecuteStationCommon(LEVEL_G01P07A, 1): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    RET
    JUMP_LABEL 9
  LABEL 6
    # TODO eos: chapter card "The Gatekeepers" (back_SetBanner2(LEVEL_V04P02A, 0, 156, 136, 4,): sky_chapter_card / chapter_titles.h
    FADE_IN wait=TRUE frames=45
    WAIT 160
    FADE_OUT wait=TRUE frames=45
    WAIT 15
    JUMP_LABEL 2
    JUMP_LABEL 9
  LABEL 7
    # TODO eos: chapter card "The First Official Exploration" (back_SetBanner2(LEVEL_D04P11A, 0, 252, 180, 5,): sky_chapter_card / chapter_titles.h
    FADE_IN wait=TRUE frames=45
    WAIT 160
    FADE_OUT wait=TRUE frames=45
    WAIT 15
    JUMP_LABEL 2
    JUMP_LABEL 9
  LABEL 8
    # TODO eos: chapter card "Team Skull" (back_SetBanner2(LEVEL_D05P31A, 0, 276, 128, 6,): sky_chapter_card / chapter_titles.h
    FADE_IN wait=TRUE frames=45
    WAIT 160
    FADE_OUT wait=TRUE frames=45
    WAIT 15
    JUMP_LABEL 2
    JUMP_LABEL 9
  LABEL 9
    RET
end

script g25_s0_player   # EoS actor PLAYER, layer 0
