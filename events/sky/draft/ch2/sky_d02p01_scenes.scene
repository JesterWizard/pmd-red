script g11_s1_player   # EoS actor PLAYER, layer 1
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 74
    WALK_RELATIVE speed=384 dx=-88 dy=4   # EoS MovePositionMark to Position<'m1', 64, 34.5>
