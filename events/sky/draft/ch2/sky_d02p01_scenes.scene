    COND_EQUAL 1 1
    COND_EQUAL 2 2
    JUMP_LABEL 0
  LABEL 1
    SELECT_ANIMATION 6   # TODO anim: EoS SetAnimation(76) is SELECT_ANIMATION 52 once the hero and partner have EoS ground groups (ch2-heroanims)
    JUMP_LABEL 0
