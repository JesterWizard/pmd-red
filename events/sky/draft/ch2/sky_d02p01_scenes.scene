    AWAIT_CUE 66
    EMOTION_EFFECT SHOCK
    AWAIT_CUE 66
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 66
    WALK_RELATIVE speed=256 dx=0 dy=-28   # EoS MovePositionMark to Position<'m1', 30, 18.5>
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    END_DELETE
end

script g3_s1_partner   # EoS actor ATTENDANT1, layer 1
