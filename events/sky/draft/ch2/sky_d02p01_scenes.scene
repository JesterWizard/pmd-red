# ------------------------------------------------------------------------
# group 27: EoS m02a0701 (D02P11A)
# ------------------------------------------------------------------------

script g27_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    SELECT_MAP SKY_DRENCHED_BLUFF_ENTRANCE
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=148 y=64   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_DRENCHED_BLUFF
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 45
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Spoink's pearl should be down on\nthe B7F level."
    TEXTBOX_CLEAR
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=PARTNER text=" Let's hang in there and finish\nthe job this time, {NAME_0}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    WAIT 20
    ALERT_CUE 66   # -> PARTNER
    WAIT 20
    FADE_OUT wait=TRUE frames=30
    CJUMP_SCENARIO_1 SCENARIO_MAIN   # EoS switch ( scn($SCENARIO_MAIN)[1] )
    COND_EQUAL 3 0
    COND_EQUAL 4 3
    JUMP_LABEL 4
  LABEL 0
  LABEL 1
    SCENARIO_CALC SCENARIO_MAIN 3 4   # EoS scenario numbers
  LABEL 2
    NEXT_DUNGEON frames=30 dungeon=THUNDERWAVE_CAVE   # EoS main_EnterDungeon(3)
    # eos: switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) (EoS's team set-up before a dungeon: Red's own runs)
    NEXT_DUNGEON frames=30 dungeon=THUNDERWAVE_CAVE   # EoS main_EnterDungeon(-1)
    HALT
    RET
  LABEL 3
    SCENARIO_CALC SCENARIO_MAIN 3 5   # EoS scenario numbers
    JUMP_LABEL 2
  LABEL 4
    JUMP_LABEL 2
  LABEL 5
    RET
end

