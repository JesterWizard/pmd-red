    EMOTION_EFFECT NONE
    AWAIT_CUE 68
    SELECT_ANIMATION 18
    STOP_ANIMATION_ON_CURRENT_FRAME   # EoS WaitAnimation
    SELECT_ANIMATION 2
    AWAIT_CUE 68
    ROTATE_RELATIVE 4 10 DIR_TRANS_FLIP
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    SELECT_ANIMATION 9
    AWAIT_CUE 68
    SELECT_ANIMATION 2
    AWAIT_CUE 68
    ROTATE_RELATIVE 1 10 DIR_TRANS_FLIP
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    SELECT_ANIMATION 18
    STOP_ANIMATION_ON_CURRENT_FRAME   # EoS WaitAnimation
    AWAIT_CUE_COND 69 0   # done: the station waits for this
