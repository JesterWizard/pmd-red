# ------------------------------------------------------------------------
# group 14: EoS m02a0401 (D02P11A)
# ------------------------------------------------------------------------

script g14_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    SELECT_MAP SKY_DRENCHED_BLUFF_ENTRANCE
    # eos: if ( variation ): never in the story (EoS's variation run)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=148 y=64   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_DRENCHED_BLUFF
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 30
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" This must be the\nbluff's entrance."
    MSG_NPC who=PARTNER text=" Spoink's mission description said\nthe pearl is deep down on the B7F level."
    MSG_NPC who=PARTNER text=" It's supposedly very dangerous.\nLet's be really careful."
    MSG_NPC who=PARTNER text=" Let's do our best, {NAME_0}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 3   # -> PLAYER: batch 3
    AWAIT_CUE_COND 66 3   # -> PARTNER: batch 3
    AWAIT_CUE 65   # <- PLAYER done
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 64 4   # -> PLAYER: batch 4
    AWAIT_CUE_COND 66 4   # -> PARTNER: batch 4
    WAIT 30
    AWAIT_CUE_COND 64 5   # -> PLAYER: batch 5
    WAIT 20
    AWAIT_CUE_COND 66 5   # -> PARTNER: batch 5
    WAIT 20
    FADE_OUT wait=TRUE frames=30
    SCENARIO_CALC SCENARIO_MAIN 3 3   # EoS scenario numbers
    NEXT_DUNGEON frames=30 dungeon=THUNDERWAVE_CAVE   # EoS main_EnterDungeon(3)
    # eos: switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) (EoS's team set-up before a dungeon: Red's own runs)
    NEXT_DUNGEON frames=30 dungeon=THUNDERWAVE_CAVE   # EoS main_EnterDungeon(-1)
    HALT
    JUMP_LABEL 2
  LABEL 0
  LABEL 1
    BGM_STOP
    MSG_NPC who=-1 text="You wake up one day, only to realize that\nyou've been turned into a Pokémon and are\nnow in a world inhabited only by Pokémon!"   # EoS message_Explanation
    MSG_NPC who=-1 text="It's up to you to form an exploration team\nand embark on the adventure of a lifetime!"   # EoS message_Explanation
    MSG_NPC who=-1 text="Welcome to the fascinating world of\nPokémon Mystery Dungeon: Explorers of Sky!\nNow YOU are the Pokémon!"   # EoS message_Explanation
    FADE_OUT wait=TRUE frames=30
    SCENARIO_CALC SCENARIO_MAIN 3 3   # EoS scenario numbers
    # TODO eos: main_EnterDungeon(123, 0);
    # eos: switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) (EoS's team set-up before a dungeon: Red's own runs)
    NEXT_DUNGEON frames=30 dungeon=THUNDERWAVE_CAVE   # EoS main_EnterDungeon(-1)
    HALT
    RET
    JUMP_LABEL 2
  LABEL 2
    RET
end

