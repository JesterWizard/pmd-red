script g17_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=CHIMECHO id=SKY_LIVES_CHIMECHO   # the text names it
    BGM_STOP
    JUMPIF_SCENE_EQ SCENARIO_MAIN 0 0 0   # EoS scenario numbers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 3 3 0   # EoS scenario numbers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 3 6 0   # EoS scenario numbers
    RET
    JUMP_LABEL 2
  LABEL 0
  LABEL 1
    FANFARE_PLAY2 SE_SKY_DINNER_BELL   # EoS se_Play(5123)
    WAIT_FANFARE2 SE_SKY_DINNER_BELL
    PORTRAIT place=LEFT_BOTTOM_2 who=CHIMECHO emotion=NORMAL
    MSG_NPC who=CHIMECHO text=" Everyone!{WAIT_PRESS} Thanks for\nwaiting! ♪"
    TEXTBOX_CLEAR
    SELECT_MAP SKY_GUILD_B2F
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=92 y=196   # EoS camera_SetMyself<performer 0>
    WAIT 1
    # eos: WaitLockLives(5, ACTOR_NPC_GUREGGURU); (Unlock below waits for it)
    FADE_IN wait=FALSE frames=30
    SET_PLACE_MODE 4
    AWAIT_CUE_COND 64 1   # -> CHIMECHO: batch 1
    WAIT 40
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 66 1   # -> DIGLETT: batch 1
    WAIT 10
    AWAIT_CUE_COND 5 0   # EoS Unlock(5): once it is waiting
    WAIT 5
    AWAIT_CUE_COND 7 0   # EoS Unlock(7): once it is waiting
    WAIT 10
    AWAIT_CUE_COND 9 0   # EoS Unlock(9): once it is waiting
    WAIT 10
    AWAIT_CUE_COND 68 1   # -> PLAYER: batch 1
    AWAIT_CUE 65   # <- CHIMECHO done
    MSG_NPC who=CHIMECHO text=" I finished making dinner! ♪"
    MSG_NPC who=CHIMECHO text=" Come on! Dinner's on! ♪"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_CHEER   # EoS se_Play(5138)
    AWAIT_CUE_COND 66 2   # -> DIGLETT: batch 2
    AWAIT_CUE_COND 68 2   # -> PLAYER: batch 2
    AWAIT_CUE_COND 6 0   # EoS Unlock(6): once it is waiting
    AWAIT_CUE_COND 8 0   # EoS Unlock(8): once it is waiting
    AWAIT_CUE_COND 10 0   # EoS Unlock(10): once it is waiting
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="Everyone: YEAH!"
    TEXTBOX_CLEAR
    FANFARE_FADEOUT2 30 SE_SKY_CHEER
    FADE_OUT wait=TRUE frames=30
    RET
    JUMP_LABEL 2
  LABEL 2
    RET
end

