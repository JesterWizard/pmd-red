script g11_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=WIGGLYTUFF id=SKY_LIVES_WIGGLYTUFF   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=LOUDRED id=SKY_LIVES_LOUDRED   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_STOP
    SELECT_MAP SKY_GUILD_B2F_DOOR
    # eos: supervision_LoadStation(LEVEL_G01P04A, 'UM02'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SELECT_LIVES group=-1 sector=4   # EoS supervision_Acting(4)
    # eos: SetPositionInitial<actor ACTOR_NPC_PERAPPU>(); (already there)
    # eos: SetPositionInitial<actor ACTOR_NPC_DOGOOMU>(); (already there)
    # eos: SetPositionInitial<actor ACTOR_NPC_DIGUDA>(); (already there)
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> DIGLETT (waits until it is ready)
    # eos: SetPositionInitial<actor ACTOR_NPC_GUREGGURU>(); (already there)
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    SKY_CAMERA_SET x=304 y=176   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    WAIT 20
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 73   # <- PARTNER done
    ALERT_CUE 72   # -> PARTNER
    AWAIT_CUE 75   # <- PLAYER done
    ALERT_CUE 74   # -> PLAYER
    AWAIT_CUE 73   # <- PARTNER done
    ALERT_CUE 72   # -> PARTNER
    AWAIT_CUE_COND 76 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> DIGLETT (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 78 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE 75   # <- PLAYER done
    ALERT_CUE 74   # -> PLAYER
    WAIT 20
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    CAMERA_SHAKE mode=CUSTOM amp=2 period=3   # EoS camera_SetEffect(2, 2, 3.0);
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    PORTRAIT place=MIDLEFT_BOTTOM who=LOUDRED emotion=NORMAL
    MSG_NPC who=LOUDRED text=" You're LATE, rookies!"
    AWAIT_CUE 67   # <- LOUDRED done
    ALERT_CUE 66   # -> LOUDRED
    WAIT_FANFARE2 457
    CAMERA_SHAKE mode=OFF amp=0 period=0
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> DIGLETT (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 78 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    PORTRAIT place=RIGHT_MIDTOP_FLIP who=CHATOT emotion=ANGRY
    MSG_NPC who=CHATOT text=" Hush!"
    MSG_NPC who=CHATOT text=" Your voice is ridiculously loud!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    MSG_NPC who=LOUDRED text=" Humph..."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    WAIT 20
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    WAIT 20
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Everyone seems to be present."
    MSG_NPC who=CHATOT text=" Very well. ♪ Let us conduct our\nmorning address."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    MSG_NPC who=CHATOT text=" Guildmaster! ♪ The guild is in\nfull attendance! ♪"
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    WAIT_BGM MUS_SKY_WIGGLYTUFFS_GUILD
    FANFARE_PLAY2 SE_SKY_DOOR   # EoS se_Play(8711)
    SKY_CHANGE_GROUND map=SKY_GUILD_B2F   # EoS back_ChangeGround(LEVEL_G01P04A): the actors stay
    WAIT 30
    SELECT_LIVES group=-1 sector=2   # EoS supervision_Acting(2)
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> DIGLETT (waits until it is ready)
    AWAIT_CUE 69   # <- DIGLETT done
    WAIT 30
    AWAIT_CUE_COND 86 0   # -> WIGGLYTUFF (waits until it is ready)
    AWAIT_CUE 87   # <- WIGGLYTUFF done
    WAIT 45
    MSG_NPC who=CHATOT text=" Thank you, Guildmaster! ♪\nPlease address the crew."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=MIDLEFT_TOP who=WIGGLYTUFF emotion=NORMAL
    MSG_NPC who=WIGGLYTUFF text=" Zzzz... Zzzz... Snorfle... Zzz..."
    TEXTBOX_CLEAR
    BGM_SWITCH SKY_GUILDMASTER_WIGGLYTUFF
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="Apprentice: (Psst...! Guildmaster Wigglytuff\nnever ceases to amaze me!)"
    MSG_NPC who=-1 text="Apprentice: (Yeah, you got that right!)"
    MSG_NPC who=-1 text="Apprentice: (Yup, looks like he's wide awake.)"
    MSG_NPC who=-1 text="Apprentice: (Eek! His eyes are wide open!\nBut he's fast asleep!)"
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    MSG_NPC who=CHATOT text=" Thank you, sir! We all value\nyour...{WAIT_PRESS}words of wisdom! ♪"
    TEXTBOX_CLEAR
    BGM_FADEOUT 60
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    FANFARE_PLAY2 SE_SKY_WING_FLAP   # EoS se_Play(5122)
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    MSG_NPC who=CHATOT text=" OK, Pokémon! ♪ Take our\nGuildmaster's words of wisdom to heart! ♪"
    MSG_NPC who=CHATOT text=" Finally, let's not forget our\nmorning cheers! All together now! ♪"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="Everyone: A ONE, A TWO...A ONE-TWO-THREE!"
    TEXTBOX_CLEAR
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    MSG_NPC who=-1 text="Everyone: ONE!{WAIT_PRESS} DON'T SHIRK WORK!"
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    TEXTBOX_CLEAR
    MSG_NPC who=-1 text="Everyone: TWO!{WAIT_PRESS} RUN AWAY AND PAY!"
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    TEXTBOX_CLEAR
    MSG_NPC who=-1 text="Everyone: THREE!{WAIT_PRESS} SMILES GO FOR MILES!"
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    TEXTBOX_CLEAR
    WAIT 15
    MSG_NPC who=CHATOT text=" OK, Pokémon! Get to work! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    WAIT 1
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    ALERT_CUE 68   # -> DIGLETT
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="Everyone: HOORAY!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> DIGLETT (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    ALERT_CUE 86   # -> WIGGLYTUFF
    WAIT 10
    AWAIT_CUE_COND 76 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 86 0   # -> WIGGLYTUFF (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> CROAGUNK (waits until it is ready)
    # eos: supervision_RemoveActing(0);
    # eos: supervision_RemoveActing(2);
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    RET
end

