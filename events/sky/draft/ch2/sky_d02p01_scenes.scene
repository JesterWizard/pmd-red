script g10_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=LOUDRED id=SKY_LIVES_LOUDRED   # the text names it
    BGM_STOP
    FADE2_OUT wait=TRUE frames=0   # the text on black (message_Narration)
    MSG_ON_BG_AUTO frames=30 text="{CENTER_ALIGN}The next morning..."
    TEXTBOX_CLEAR
    WAIT 1
    FADE2_IN wait=TRUE frames=0   # the text layer back after the text on black
    WAIT 30
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" HEY!{WAIT_PRESS} HEY THERE!"
    # eos: message_KeyWait(); (the line above waits for a button)
    FANFARE_PLAY2 471   # EoS se_Play(8970)
    MSG_NPC who=-1 text=" RISE AND SHINE!"
    WAIT_FANFARE2 471
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=NORMAL   # TODO emotion: EoS FACE_DIZZY (not among Red's faces yet)
    MSG_QUIET who=PLAYER text="(Ugh!)"
    MSG_QUIET who=PLAYER text="(M-my head is pounding!)"
    MSG_QUIET who=PLAYER text="(Wh-what a ridiculously loud voice! It almost\nblasted my eardrums!)"
    TEXTBOX_CLEAR
    SELECT_MAP SKY_GUILD_CREW_ROOM
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    CAMERA_SHAKE mode=CUSTOM amp=2 period=3   # EoS camera_SetEffect(2, 2, 3.0);
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    CAMERA_SHAKE mode=OFF amp=0 period=0
    PORTRAIT place=LEFT_MIDTOP who=LOUDRED emotion=ANGRY
    MSG_NPC who=LOUDRED text=" Why are you still ASLEEP?!{WAIT_PRESS} WAKE UP!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    MSG_QUIET who=PLAYER text="(Ugh!)"
    TEXTBOX_CLEAR
    PORTRAIT place=CENTERRIGHT_CENTER_FLIP who=PARTNER emotion=NORMAL   # TODO emotion: EoS FACE_DIZZY (not among Red's faces yet)
    # eos: message_FacePositionOffset(-3, 0); (the face stays at its place on the GBA)
    MSG_NPC who=PARTNER text=" M-my poor ears..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    CAMERA_SHAKE mode=CUSTOM amp=2 period=3   # EoS camera_SetEffect(2, 2, 3.0);
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    CAMERA_SHAKE mode=OFF amp=0 period=0
    PORTRAIT place=KEEP who=LOUDRED emotion=NORMAL
    MSG_NPC who=LOUDRED text=" C'mon! Snap OUT of it!"
    MSG_NPC who=LOUDRED text=" I'm Loudred!{WAIT_PRESS} And I'm a fellow apprentice!"
    MSG_NPC who=LOUDRED text=" If you're late for our morning\nbriefing, you'll be SORRY! So MOVE it!"
    MSG_NPC who=LOUDRED text=" Guildmaster Wigglytuff has got\na BIG temper. If you make him lose it..."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE 69   # <- LOUDRED done
    PORTRAIT place=LEFT_MIDTOP_FLIP who=LOUDRED emotion=NORMAL
    MSG_NPC who=LOUDRED text=" YOWEEE! That would be one very\nscary scene!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 5
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 30
    ALERT_CUE 68   # -> LOUDRED
    MSG_NPC who=LOUDRED text=" I've got goose bumps just\nthinking about it! YEESH!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    WAIT 45
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE 69   # <- LOUDRED done
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    CAMERA_SHAKE mode=CUSTOM amp=2 period=3   # EoS camera_SetEffect(2, 2, 3.0);
    ALERT_CUE 68   # -> LOUDRED
    AWAIT_CUE 69   # <- LOUDRED done
    ALERT_CUE 68   # -> LOUDRED
    CAMERA_SHAKE mode=OFF amp=0 period=0
    PORTRAIT place=LEFT_MIDTOP who=LOUDRED emotion=NORMAL
    MSG_NPC who=LOUDRED text=" So ANYWAY..."
    MSG_NPC who=LOUDRED text=" I'm not about to get in trouble\nbecause you rookies got up LATE!"
    MSG_NPC who=LOUDRED text=" SO GET IT IN GEAR!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE 69   # <- LOUDRED done
    ALERT_CUE 68   # -> LOUDRED
    WAIT 60
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL   # TODO emotion: EoS FACE_DIZZY (not among Red's faces yet)
    MSG_NPC who=PARTNER text=" Urk! My ears are still ringing..."
    MSG_NPC who=PARTNER text=" What did he say? Something\nabout getting ready?"
    TEXTBOX_CLEAR
    WAIT 20
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 66   # -> PARTNER
    FANFARE_PLAY2 466   # EoS se_Play(8967)
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Er...{WAIT_PRESS} Oh yeah!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" We signed up as apprentices at\nWigglytuff's guild, that's right!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" But that means..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Waaaah! We overslept!\nCome on, {NAME_0}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 66   # -> PARTNER
    WAIT 45
    FADE_OUT wait=TRUE frames=30
    RET
end

