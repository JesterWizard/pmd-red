script g26_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    SET_ARRAYVAL SKY_SCENARIO_MAIN_BIT_FLAG 1 0   # EoS $SCENARIO_MAIN_BIT_FLAG[1] = 0;
    # eos: debug_Print('CHOUREI');
    SELECT_MAP SKY_GUILD_B2F
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(10); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    SELECT_LIVES group=-1 sector=2   # EoS supervision_Acting(2)
    # eos: SetPositionInitial<actor ACTOR_NPC_GUREGGURU>(); (already there)
    AWAIT_CUE_COND 64 0   # -> CROAGUNK (waits until it is ready)
    # eos: SetPositionInitial<actor ACTOR_NPC_DOGOOMU>(); (already there)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    # eos: SetPositionInitial<actor ACTOR_NPC_PERAPPU>(); (already there)
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    # eos: SetPositionInitial<actor ACTOR_NPC_BIPPA>(); (already there)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    SKY_CAMERA_SET x=304 y=176   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    AWAIT_CUE_COND 72 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> PARTNER (waits until it is ready)
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="Everyone: AND...THREE!{WAIT_PRESS} SMILES GO FOR MILES!"
    AWAIT_CUE_COND 72 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> PARTNER (waits until it is ready)
    TEXTBOX_CLEAR
    WAIT 15
    PORTRAIT place=RIGHT_MIDTOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" OK, Pokémon! ♪{WAIT_PRESS} Time to get\nto work! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 72 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> PARTNER (waits until it is ready)
    WAIT 1
    AWAIT_CUE_COND 64 0   # -> CROAGUNK (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> DIGLETT (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> PARTNER (waits until it is ready)
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="Everyone: HOORAY!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CROAGUNK (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 80 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 82 0   # -> DIGLETT (waits until it is ready)
    AWAIT_CUE_COND 84 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 78 0   # -> PARTNER (waits until it is ready)
    SKY_CAMERA_MOVE_X dx=64 speed=256   # EoS MovePositionLives<performer 0>(1, ACTOR_PLAYER);
    AWAIT_CUE_COND 86 0   # -> WIGGLYTUFF (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 80 0   # -> CORPHISH (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> LOUDRED (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 76 0   # -> SUNFLORA (waits until it is ready)
    AWAIT_CUE_COND 86 0   # -> WIGGLYTUFF (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> CHIMECHO (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> CROAGUNK (waits until it is ready)
    # eos: supervision_RemoveActing(1);
    TEXTBOX_CLEAR
    # TODO eos: switch ( sector() ) { (the first case is taken)
    JUMP_LABEL 0
  LABEL 0
  LABEL 1
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_WIGGLYTUFFS_GUILD
    RET
  LABEL 2
    RET
  LABEL 3
    # eos: CallCommon(CORO_EVENT_END_MAPIN): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: main_SetGround(LEVEL_G01P04A): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_ExecuteStationCommon(LEVEL_G01P04A, 1): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    RET
  LABEL 4
    RET
end

