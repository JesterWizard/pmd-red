script g0_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 68
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 68
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 68
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 68
    WALK_RELATIVE speed=256 dx=0 dy=-12
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHWEST
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    HALT
end

script g0_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 70
    CALL_SCRIPT JUMP_SURPRISE_FUNC   # EoS CORO_JUMP_SURPRISE_FUNC_SERIES
    AWAIT_CUE 70
    CALL_SCRIPT SWEAT_FUNC
    AWAIT_CUE 70
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE 70
    SELECT_ANIMATION 47   # EoS SetAnimation(71)
    STOP_ANIMATION_ON_CURRENT_FRAME   # EoS WaitAnimation
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    SELECT_ANIMATION 47   # EoS SetAnimation(71)
    STOP_ANIMATION_ON_CURRENT_FRAME   # EoS WaitAnimation
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    SELECT_ANIMATION 2
    AWAIT_CUE 70
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 70
    CALL_SCRIPT QUESTION_FUNC
    AWAIT_CUE 70
    WALK_RELATIVE speed=256 dx=0 dy=-12
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHEAST
    HALT
end

