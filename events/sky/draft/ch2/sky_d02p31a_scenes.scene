# Explorers of Sky chapter 2 (m02a0801, m02a0901), on D02P31A.
# Draft: translated by tools/event_editor/eos_import.py --chapter2; not built yet.
# Hand-tune it; lines marked `TODO eos` are what the translator could not do.
#
#   group 0  m02a0801  (EoS SCRIPT/D02P31A/m02a0801.ssb)
#   group 1  m02a0901  (EoS SCRIPT/D02P31A/m02a0901.ssb)

```c
#include "sky_story.h"
```

```c
#define NPC_PLAYER 0
#define NPC_PARTNER 1
#define NPC_ADVENTURE_NPC1 2
#define NPC_ADVENTURE_NPC2 2
#define NPC_ADVENTURE_NPC3 2
#define NPC_PLAYER_APPOINT 2
#define NPC_UNIT_NPC1 2
#define NPC_UNIT_NPC2 2
```

# ROTATE_TO_LIVES takes a lives kind, not an NPC slot.
```c
#define LIVES_KIND_PLAYER 0
#define LIVES_KIND_PARTNER 34
```

# ------------------------------------------------------------------------
# group 0: EoS m02a0801 (D02P31A)
# ------------------------------------------------------------------------

script g0_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    BGM_STOP
    # eos: if ( variation ): never in the story (EoS's variation run)
    # eos: back_SetDungeonBanner(3, 0): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    FADE_IN wait=TRUE frames=16
    SET_PLACE_MODE 4
    WAIT 60
    FADE_OUT wait=TRUE frames=16
    WAIT 15
    CJUMP_SCENARIO_1 SCENARIO_MAIN   # EoS switch ( scn($SCENARIO_MAIN)[1] )
    COND_EQUAL 3 0
    JUMP_LABEL 2
  LABEL 0
    SCENARIO_CALC SCENARIO_MAIN 3 6   # EoS scenario numbers
  LABEL 1
    SELECT_MAP SKY_DRENCHED_BLUFF_END
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=124 y=216   # EoS camera_SetMyself<performer 0>
    WAIT 1
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    FADE_IN wait=TRUE frames=30
    AWAIT_CUE 65   # <- PLAYER done
    AWAIT_CUE 67   # <- PARTNER done
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh! Over there!"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=-92 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m2', 30, 24.5>);
    SKY_CAMERA_MOVE_X dx=4 speed=256
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    WAIT 5
    AWAIT_CUE_COND 66 3   # -> PARTNER: batch 3
    AWAIT_CUE 65   # <- PLAYER done
    AWAIT_CUE_COND 64 3   # -> PLAYER: batch 3
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 66 4   # -> PARTNER: batch 4
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 30
    AWAIT_CUE_COND 66 5   # -> PARTNER: batch 5
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 64 4   # -> PLAYER: batch 4
    MSG_NPC who=PARTNER text=" This has to be Spoink's pearl!"
    MSG_NPC who=PARTNER text=" Quick! Let's take it back!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 5   # -> PLAYER: batch 5
    AWAIT_CUE_COND 66 6   # -> PARTNER: batch 6
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 30
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_IN_THE_DEPTHS_OF_THE_PIT
    # eos: switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) (EoS's team set-up before a dungeon: Red's own runs)
    RET
  LABEL 2
  LABEL 3
    SCENARIO_CALC SCENARIO_MAIN 3 7   # EoS scenario numbers
    JUMP_LABEL 1
  LABEL 4
    JUMP_LABEL 7
  LABEL 5
  LABEL 6
    # eos: switch ( ProcessSpecial(53, -1, 0) ) (EoS's demo version only)
    TEXTBOX_AUTO_PRESS 300 300   # EoS message_SetWaitMode
    MSG_NPC who=-1 text="{CENTER_ALIGN}Thanks for playing!\n{CENTER_ALIGN}We hope you enjoyed\n{CENTER_ALIGN}the demo!"   # EoS message_Explanation
    # eos: message_KeyWait(); (the line above waits for a button)
    SKY_DEMO_TO_TITLE   # EoS ProcessSpecial(PROCESS_SPECIAL_JUMP_TO_TITLE_SCREEN)
    RET
    JUMP_LABEL 7
  LABEL 7
    RET
end

script g0_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
  LABEL 0
    AWAIT_CUE 64
    COND_EQUAL 1 1
    COND_EQUAL 2 2
    COND_EQUAL 3 3
    COND_EQUAL 4 4
    COND_EQUAL 5 5
    JUMP_LABEL 0
  LABEL 1
    WALK_RELATIVE speed=256 dx=0 dy=-60   # EoS MovePositionMark to Position<'m0', 32, 35.5>
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 2
    WALK_RELATIVE speed=256 dx=0 dy=-80   # EoS MovePositionMark to Position<'m3', 32, 25.5>
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 3
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHWEST
    JUMP_LABEL 0
  LABEL 4
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    JUMP_LABEL 0
  LABEL 5
    WALK_RELATIVE speed=204 dx=-16 dy=-16
    JUMP_LABEL 0
end

script g0_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
  LABEL 0
    AWAIT_CUE 66
    COND_EQUAL 1 1
    COND_EQUAL 2 2
    COND_EQUAL 3 3
    COND_EQUAL 4 4
    COND_EQUAL 5 5
    COND_EQUAL 6 6
    JUMP_LABEL 0
  LABEL 1
    WALK_RELATIVE speed=256 dx=0 dy=-68   # EoS MovePositionMark to Position<'m1', 28, 35.5>
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 2
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 3
    WALK_RELATIVE speed=256 dx=0 dy=-80   # EoS MovePositionMark to Position<'m4', 28, 25.5>
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 4
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHEAST
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 5
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
  LABEL 6
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTHEAST
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    JUMP_LABEL 0
end

script g0_s0_obj0_d02p31a1   # EoS object D02P31A1_17, layer 0
    DEBUGINFO
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    HALT
end

actors g0_s0_lives
    actor kind=0 facing=NORTH x=32 y=43.5 script=g0_s0_player   # EoS PLAYER
    actor kind=34 facing=NORTH x=28 y=44.5 script=g0_s0_partner   # EoS ATTENDANT1
end

