script g1_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    BGM_STOP
    # eos: back_SetDungeonBanner(3, 0): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    FADE_IN wait=TRUE frames=16
    SET_PLACE_MODE 4
    WAIT 60
    FADE_OUT wait=TRUE frames=16
    WAIT 15
    SELECT_MAP SKY_DRENCHED_BLUFF_END
    JUMPIF_ARRAY PERFORMANCE_PROGRESS_LIST 7 0
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=124 y=120   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    AWAIT_CUE_COND 64 1   # -> PARTNER: batch 1
    AWAIT_CUE_COND 66 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 68 1   # -> UNIT_NPC1: batch 1
    AWAIT_CUE_COND 70 1   # -> UNIT_NPC2: batch 1
    AWAIT_CUE 67   # <- PLAYER done
    WAIT 15
    AWAIT_CUE_COND 64 2   # -> PARTNER: batch 2
    WAIT 12
    AWAIT_CUE_COND 66 2   # -> PLAYER: batch 2
    WAIT 4
    AWAIT_CUE_COND 68 2   # -> UNIT_NPC1: batch 2
    WAIT 7
    AWAIT_CUE_COND 70 2   # -> UNIT_NPC2: batch 2
    AWAIT_CUE 67   # <- PLAYER done
    WAIT 15
    JUMP_LABEL 2
    JUMP_LABEL 3
  LABEL 0
  LABEL 1
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    SKY_CAMERA_SET x=124 y=120   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    AWAIT_CUE_COND 72 1   # -> PLAYER_APPOINT: batch 1
    AWAIT_CUE_COND 74 1   # -> ADVENTURE_NPC1: batch 1
    AWAIT_CUE_COND 76 1   # -> ADVENTURE_NPC2: batch 1
    AWAIT_CUE_COND 78 1   # -> ADVENTURE_NPC3: batch 1
    AWAIT_CUE 73   # <- PLAYER_APPOINT done
    WAIT 15
    AWAIT_CUE_COND 72 2   # -> PLAYER_APPOINT: batch 2
    WAIT 12
    AWAIT_CUE_COND 74 2   # -> ADVENTURE_NPC1: batch 2
    WAIT 4
    AWAIT_CUE_COND 76 2   # -> ADVENTURE_NPC2: batch 2
    WAIT 7
    AWAIT_CUE_COND 78 2   # -> ADVENTURE_NPC3: batch 2
    AWAIT_CUE 73   # <- PLAYER_APPOINT done
    WAIT 15
  LABEL 2
    MSG_INSTANT text="{CENTER_ALIGN}This appears to be the end of the dungeon."   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}It's impossible to go any farther.{WAIT_PRESS}\n{CENTER_ALIGN}It's time to go back."   # EoS message_Mail
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_IN_THE_DEPTHS_OF_THE_PIT
    MSG_NPC who=-1 text="{CENTER_ALIGN}{NAME_0} cleared Drenched Bluff!\n{CENTER_ALIGN}Very impressive!"   # EoS message_Explanation
    TEXTBOX_CLEAR
    RET
    JUMP_LABEL 3
  LABEL 3
    RET
end

