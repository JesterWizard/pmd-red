script g0_s0_wigglytuff   # EoS actor NPC_PUKURIN, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=WIGGLYTUFF id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    # EoS: its own coroutine (def ... for actor NPC_PUKURIN)
    SELECT_ANIMATION 5
    # TODO eos: SetEffect(EFFECT_APPLE_ON_HEAD, 3);
    AWAIT_CUE 5   # EoS Lock(5)
  LABEL 3
  LABEL 2001
    ROTATE_TO speed=8 turn=SPINRIGHT1 direction=NORTH
    WAIT 20
    ROTATE_TO speed=8 turn=SPINRIGHT1 direction=SOUTH
    WAIT 20
    WAIT 1   # (a forever loop)
    JUMP_LABEL 2001
  LABEL 2002
    # TODO eos: the station also sends this one commands (below), which its own coroutine never reaches
    AWAIT_CUE 86
    END_DELETE
end

