script g0_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    BGM_STOP
    SELECT_MAP SKY_GUILD_MESS_HALL
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=252 y=136   # EoS camera_SetMyself<performer 0>
    SKY_CAMERA_MOVE_X dx=-200 speed=128   # EoS MovePositionOffset<performer 0>(0.5, -200, 0);
    WAIT 1
    AWAIT_CUE_COND 64 1   # -> PLAYER: batch 1
    AWAIT_CUE_COND 66 1   # -> PARTNER: batch 1
    AWAIT_CUE_COND 68 1   # -> CHATOT: batch 1
    AWAIT_CUE_COND 70 1   # -> LOUDRED: batch 1
    AWAIT_CUE_COND 72 1   # -> DIGLETT: batch 1
    AWAIT_CUE_COND 74 1   # -> DUGTRIO: batch 1
    AWAIT_CUE_COND 76 1   # -> SUNFLORA: batch 1
    AWAIT_CUE_COND 78 1   # -> CORPHISH: batch 1
    AWAIT_CUE_COND 80 1   # -> BIDOOF: batch 1
    AWAIT_CUE_COND 82 1   # -> CROAGUNK: batch 1
    AWAIT_CUE_COND 84 1   # -> CHIMECHO: batch 1
    # TODO eos: SetEffect<actor ACTOR_NPC_PERAPPU>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_HEIGANI>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_DOGOOMU>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_PLAYER>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_EATING, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_DIGUDA>(EFFECT_EATING_SLOW, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_EATING_SLOW, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_GUREGGURU>(EFFECT_EATING_SLOW, 3);
    # TODO eos: SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_EATING_SLOW, 3);
    # TODO eos: switch ( sector() ) { (the first case is taken)
    JUMP_LABEL 1002
  LABEL 1002
  LABEL 0
    ALERT_CUE 86   # -> WIGGLYTUFF
  LABEL 1
    BGM_FADEIN frames=60 song=SKY_EATING
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    MSG_OVERHEARD text="Crunch-munch! Chew-chew! Snuffle-slurp!\nCrunch-munch! Chew-chew! Snuffle-slurp!"   # EoS message_ImitationSound
    MSG_OVERHEARD text="Crunch-munch! Chew-chew! Snuffle-slurp!\nCrunch-munch! Chew-chew! Snuffle-slurp!"   # EoS message_ImitationSound
    MSG_OVERHEARD text="Crunch-munch! Chew-chew! Snuffle-slurp!\nCrunch-munch! Chew-chew! Snuffle-slurp!"   # EoS message_ImitationSound
    MSG_OVERHEARD text="Crunch-munch! Chew-chew! Snuffle-slurp!\nCrunch-munch! Chew-chew! Snuffle-slurp!"   # EoS message_ImitationSound
    MSG_OVERHEARD text="Crunch-munch! Chew-chew! Snuffle-slurp!\nCrunch-munch! Chew-chew! Snuffle-slurp!"   # EoS message_ImitationSound
    MSG_OVERHEARD text="Crunch-munch! Chew-chew! Snuffle-slurp!\nCrunch-munch! Chew-chew! Snuffle-slurp!"   # EoS message_ImitationSound
    TEXTBOX_CLEAR
    BGM_FADEOUT 60
    FADE_OUT wait=TRUE frames=30
    WAIT_BGM MUS_SKY_EATING
    WAIT 30
    JUMPIF_SCENE_EQ SCENARIO_MAIN 3 3 1005   # EoS scenario numbers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 3 6 1005   # EoS scenario numbers
    RET
    JUMP_LABEL 1004
  LABEL 1005
    AWAIT_CUE_COND 66 2   # -> PARTNER: batch 2
    AWAIT_CUE_COND 64 2   # -> PLAYER: batch 2
    AWAIT_CUE_COND 70 2   # -> LOUDRED: batch 2
    AWAIT_CUE_COND 80 2   # -> BIDOOF: batch 2
    AWAIT_CUE_COND 78 2   # -> CORPHISH: batch 2
    AWAIT_CUE_COND 84 2   # -> CHIMECHO: batch 2
    AWAIT_CUE_COND 68 2   # -> CHATOT: batch 2
    AWAIT_CUE_COND 72 2   # -> DIGLETT: batch 2
    AWAIT_CUE_COND 74 2   # -> DUGTRIO: batch 2
    AWAIT_CUE_COND 82 2   # -> CROAGUNK: batch 2
    AWAIT_CUE_COND 76 2   # -> SUNFLORA: batch 2
    AWAIT_CUE_COND 88 1   # -> G01P06B1_107: batch 1
    # eos: supervision_RemoveActing(0);
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Aaaaah! I'm done eating! Excellent meal!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" I'm stuffed, and now I'm getting sleepy..."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" Yep, I'm off to bed! Good night, gang!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=-1 text=" Good night!"
    TEXTBOX_CLEAR
    WAIT 30
    RET
    JUMP_LABEL 1004
  LABEL 1004
    JUMP_LABEL 1001
  LABEL 1003
    # eos: WaitLockLives(5, ACTOR_NPC_PUKURIN); (Unlock below waits for it)
    AWAIT_CUE_COND 5 0   # EoS Unlock(5): once it is waiting
    JUMP_LABEL 1
  LABEL 1001
    RET
end

