script g35_s0_kecleon   # EoS actor NPC_KAKUREON1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=KECLEON id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    SELECT_ANIMATION 2
    AWAIT_CUE 64
    ROTATE_TO speed=8 turn=DIR_TRANS_10 direction=EAST
    AWAIT_CUE 64
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=SOUTH
    AWAIT_CUE 64
    EMOTION_EFFECT QUESTION
    HALT
end

