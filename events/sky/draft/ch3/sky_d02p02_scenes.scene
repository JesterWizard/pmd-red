    ROTATE_RELATIVE 4 10 DIR_TRANS_SPINRIGHT2
    AWAIT_CUE 64
    ROTATE_RELATIVE 4 10 DIR_TRANS_SPINLEFT2
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    WALK_RELATIVE speed=256 dx=32 dy=28   # EoS Move2PositionMark to Position<'m0', 44, 29.5>
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    WALK_RELATIVE speed=256 dx=160 dy=0
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    END_DELETE
end

actors g29_s0_lives
    actor kind=0 facing=WEST x=48 y=24.5 script=g29_s0_player   # EoS PLAYER
    actor kind=34 facing=WEST x=48 y=27.5 script=g29_s0_partner   # EoS ATTENDANT1
    actor kind=SKY_LIVES_BIDOOF facing=EAST x=40 y=26.5 script=g29_s0_bidoof   # EoS NPC_BIPPA
end

# ------------------------------------------------------------------------
# group 30: EoS m03a0201 (T01P01A)
# ------------------------------------------------------------------------

script g30_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    SELECT_MAP SKY_TREASURE_TOWN_SQUARE   # EoS: the scene goes on on the map as it is
    SELECT_ENTITIES group=-1 sector=0   # (its layer 0: who is there)
    FADE_IN wait=TRUE frames=0
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_TREASURE_TOWN
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" The Kecleon Market isn't over\nthis way."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 65   # <- PLAYER done
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_FLIP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" The Kecleon Market is this way."
    MSG_NPC who=PARTNER text=" Let's go, {NAME_0}!"
    TEXTBOX_CLEAR
    RET
end

script g30_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    SELECT_ANIMATION 2
    AWAIT_CUE 64
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    HALT
end

script g30_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    SELECT_ANIMATION 2
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=WEST
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    HALT
end

actors g30_s0_lives
    actor kind=0 facing=SOUTH x=72 y=28.5 script=g30_s0_player   # EoS PLAYER
    actor kind=34 facing=SOUTH x=72 y=26.5 script=g30_s0_partner   # EoS ATTENDANT1
end

# ------------------------------------------------------------------------
# group 31: EoS m03a0301 (T01P02A)
# ------------------------------------------------------------------------

script g31_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=MARILL id=SKY_LIVES_MARILL   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=KECLEON id=SKY_LIVES_KECLEON   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    SELECT_MAP SKY_TREASURE_TOWN_WEST   # EoS: the scene goes on on the map as it is
    SELECT_ENTITIES group=-1 sector=0   # (its layer 0: who is there)
    FADE_IN wait=TRUE frames=0
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_TREASURE_TOWN
    SCENARIO_CALC SCENARIO_MAIN 4 2   # EoS scenario numbers
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    WAIT 1
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> AZURILL (waits until it is ready)
    BGM_FADEOUT 120
    # eos: message_SetActor(ACTOR_NPC_MARIRU);
    MSG_NPC who=MARILL text=" Misters Kecleon!"
    WAIT 5
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    WAIT 90
    TEXTBOX_CLEAR
    # eos: SetPositionLives<performer 0>(0); (the camera's performer at PLAYER)
    SKY_CAMERA_SET x=216 y=104   # EoS camera_SetMyself<performer 0>
    SKY_CAMERA_MOVE dy=20 speed=256   # EoS Move2PositionMark<performer 0>(1, Position<'m2', 42, 24.5>);
    SKY_CAMERA_MOVE_X dx=8 speed=256
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 75   # <- PLAYER done
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 74   # -> PLAYER
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE 71   # <- MARILL done
    ALERT_CUE 70   # -> MARILL
    AWAIT_CUE 73   # <- AZURILL done
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 73   # <- AZURILL done
    BGM_SWITCH SKY_HEARTWARMING
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    PORTRAIT place=MIDLEFT_TOP who=KECLEON emotion=NORMAL
    MSG_NPC who=KECLEON text=" Ah! Little Marill and Azurill!{WAIT_PRESS}\nWelcome, my young friends! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 73   # <- AZURILL done
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" Hello. May I buy an Apple?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=KECLEON text=" Oh, most certainly!"
    TEXTBOX_CLEAR
    MSG_INSTANT text="{CENTER_ALIGN}Marill and Azurill bought\n{CENTER_ALIGN}an Apple at Kecleon Market."   # EoS message_Mail
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=MARILL emotion=JOYOUS
    # eos: message_FacePositionOffset(-3, -1); (the face stays at its place on the GBA)
    MSG_NPC who=MARILL text=" Thank you, Misters Kecleon!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    MSG_NPC who=KECLEON text=" No, thank you, my young friends!\nYou are to be admired! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    WAIT 4
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    WAIT 20
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 71   # <- MARILL done
    AWAIT_CUE 73   # <- AZURILL done
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE 65   # <- KECLEON done
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE 67   # <- KECLEON_PURPLE done
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    MSG_NPC who=KECLEON text=" You see, those delightful\nchildren are brothers."
    MSG_NPC who=KECLEON text=" Lately, their poor mother has\nfallen sick. So those youngsters come and\ndo the shopping for her."
    MSG_NPC who=KECLEON text=" It's quite remarkable. Though\nvery young, they've stepped up and\ntaken charge. ♪"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> MARILL
    WAIT 20
    ALERT_CUE 72   # -> AZURILL
    ALERT_CUE 64   # -> KECLEON
    # eos: message_SetActor(ACTOR_NPC_MARIRU);
    MSG_NPC who=MARILL text=" Misters Kecleon!"
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    ALERT_CUE 66   # -> KECLEON_PURPLE
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 71   # <- MARILL done
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    ALERT_CUE 70   # -> MARILL
    AWAIT_CUE 73   # <- AZURILL done
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 73   # <- AZURILL done
    TEXTBOX_CLEAR
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    MSG_NPC who=KECLEON text=" Oh? What's the hurry? What\nmakes you return in such a rush?"
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 73   # <- AZURILL done
    MSG_NPC who=AZURILL text=" There was an extra Apple!"
    TEXTBOX_CLEAR
    PORTRAIT place=KEEP who=MARILL emotion=NORMAL
    # eos: message_FacePositionOffset(-3, -1); (the face stays at its place on the GBA)
    MSG_NPC who=MARILL text=" We didn't pay for this many."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=KECLEON text=" Oh, yes... That, young friends,\nis a gift from me and my brother."
    MSG_NPC who=KECLEON text=" Please, share it among\nyourselves and do enjoy."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    # eos: message_FacePositionOffset(-3, -1); (the face stays at its place on the GBA)
    MSG_NPC who=MARILL text=" Really?!"
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> AZURILL
    PORTRAIT place=KEEP who=AZURILL emotion=JOYOUS
    MSG_NPC who=AZURILL text=" Yay! Thank you, Mr. Kecleon\nand Mr. Kecleon!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 72 0   # -> AZURILL (waits until it is ready)
    MSG_NPC who=KECLEON text=" Oh, not to worry, my friends.\nDo take care on your way home. ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> AZURILL (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 72 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 73   # <- AZURILL done
    BGM_FADEOUT 10
    FANFARE_PLAY2 SE_SKY_AZURILL   # EoS se_Play(6412)
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=MIDRIGHT_BOTTOM who=AZURILL emotion=TEARY_EYE
    # eos: message_FacePositionOffset(2, -3); (the face stays at its place on the GBA)
    MSG_NPC who=AZURILL text=" Yowch!"
    FANFARE_PLAY2 SE_SKY_APPLE   # EoS se_Play(6413)
    SELECT_OBJECTS group=-1 sector=2   # EoS supervision_Acting(2)
    AWAIT_CUE_COND 76 0   # -> P03P02A1_128 (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    WAIT 4
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE 77   # <- P03P02A1_128 done
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 74 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 75   # <- PLAYER done
    FANFARE_PLAY2 SE_SKY_PICK_UP   # EoS se_Play(8710)
    ALERT_CUE 76   # -> P03P02A1_128
    WAIT 30
    AWAIT_CUE_COND 72 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 73   # <- AZURILL done
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 73   # <- AZURILL done
    WAIT 20
    ALERT_CUE 72   # -> AZURILL
    AWAIT_CUE 73   # <- AZURILL done
    ALERT_CUE 72   # -> AZURILL
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" W-we're sorry to bother you.\nThank you so much."
    TEXTBOX_CLEAR
    ALERT_CUE 74   # -> PLAYER
    AWAIT_CUE 75   # <- PLAYER done
    MSG_INSTANT text="{CENTER_ALIGN}{NAME_0} gave the Apple\n{CENTER_ALIGN}back to Azurill."   # EoS message_Mail
    MSG_INSTANT text="\n{CENTER_ALIGN}But then suddenly..."   # EoS message_Mail
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_DIZZY   # EoS se_Play(5133)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PLAYER emotion=PAINED
    MSG_QUIET who=PLAYER text="(Huh? What was that?)"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_DIZZY   # EoS se_Play(5133)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    WAIT 30
    MSG_QUIET who=PLAYER text="(D-dizzy? Or am I...?)"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_DIZZY   # EoS se_Play(5133)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    FADE_OUT wait=TRUE frames=5
    FADE2_OUT wait=TRUE frames=0
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    FADE2_IN wait=TRUE frames=0   # the text layer back for the next scene
    RET
end

script g31_s0_kecleon   # EoS actor NPC_KAKUREON1, layer 0
