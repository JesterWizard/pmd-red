# ------------------------------------------------------------------------
# group 63: EoS m03a1313 (V03P06A)
# ------------------------------------------------------------------------

script g63_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_SWITCH SKY_TIME_GEAR_REMIX
    SKY_AMBIENCE song=SKY_STORM frames=0
    SELECT_MAP SKY_TIME_GEAR_FOREST
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=88 y=112   # EoS camera_SetMyself<performer 0>
    WAIT 1
    AWAIT_CUE_COND 64 0   # -> GROVYLE (waits until it is ready)
    SKY_BUBBLES RAIN   # EoS SetEffect<performer 3>(EFFECT_VERY_HEAVY_RAIN, 3);
    AWAIT_CUE_COND 66 0   # -> V03P06A2_200 (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> V03P06A1_196 (waits until it is ready)
    FADE_IN wait=TRUE frames=15   # EoS screen_FadeChange(1, 15, 0, 192); (to full brightness)
    SET_PLACE_MODE 4
    AWAIT_CUE_COND 64 0   # -> GROVYLE (waits until it is ready)
    AWAIT_CUE 65   # <- GROVYLE done
    ALERT_CUE 64   # -> GROVYLE
    WAIT 60
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 3
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 10
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 3
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FADE_IN wait=TRUE frames=0   # EoS screen_FadeChange(1, 0, 0, 192); (to full brightness)
    WAIT 60
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" But my guess is that if a Time\nGear is removed from a region..."
    MSG_NPC who=PARTNER text=" The flow of time in that region\nwill probably stop too."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> GROVYLE (waits until it is ready)
    AWAIT_CUE 65   # <- GROVYLE done
    ALERT_CUE 64   # -> GROVYLE
    WAIT 30
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 3
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 10
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 3
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FADE_IN wait=TRUE frames=0   # EoS screen_FadeChange(1, 0, 0, 192); (to full brightness)
    WAIT 45
    MSG_NPC who=PARTNER text=" That's why everyone makes sure\nnever to disturb the Time Gears."
    MSG_NPC who=PARTNER text=" Everyone has long been certain\nthat some kind of disaster would strike."
    MSG_NPC who=PARTNER text=" So everyone stays away from\nthe Time Gears and doesn't tamper with them."
    MSG_NPC who=PARTNER text=" Even the most hardened criminal\nPokémon know to avoid messing with them."
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=15
    RET
end

