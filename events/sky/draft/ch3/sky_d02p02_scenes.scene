    SKY_BUBBLES RAIN   # EoS SetEffect<performer 3>(EFFECT_VERY_HEAVY_RAIN, 3);
    SKY_AMBIENCE song=SKY_STORM frames=60
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 60
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    SKY_STORM_BOLT   # EoS SetAnimation<object OBJECT_V01P07B1_191>(18); (chapter 1's lightning, src/sky_storm.c)
    WAIT 118   # EoS WaitAnimation: the storm cloud's lightning (118 frames)
    # eos: WaitExecuteObject(OBJECT_V01P07B1_191); (SKY_STORM_BOLT)
    WAIT 60
    FADE_OUT wait=TRUE frames=15
    SKY_BUBBLES OFF   # EoS SetEffect<performer 3>(EFFECT_NONE, 3);
    RET
end

