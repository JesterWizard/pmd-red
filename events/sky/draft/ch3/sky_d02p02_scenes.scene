script g44_s1_partner   # EoS actor ATTENDANT1, layer 1
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    # EoS: its own coroutine (def ... for actor ATTENDANT1)
    SELECT_ANIMATION 2
    AWAIT_CUE 5   # EoS Lock(5)
    WALK_RELATIVE speed=256 dx=0 dy=-52   # EoS MovePositionMark(1, Position to Position<'m10', 41, 40.5>
    AWAIT_CUE 6   # EoS Lock(6)
    SELECT_ANIMATION 3
  LABEL 0
  LABEL 1
    MOVE_RELATIVE speed=256 dx=1 dy=0
    WAIT 1
    MOVE_RELATIVE speed=256 dx=-1 dy=0
    WAIT 1
    JUMPIF_EQUAL EVENT_LOCAL 1 2
    JUMP_LABEL 3
  LABEL 2
    JUMP_LABEL 5
    JUMP_LABEL 4
  LABEL 3
    JUMP_LABEL 4
  LABEL 4
    WAIT 1   # (a forever loop)
    JUMP_LABEL 1
  LABEL 5
  LABEL 6
    SELECT_ANIMATION 2
    AWAIT_CUE_COND 7 0   # EoS Lock(7); hold: the station takes over
    # eos: hold (handed over to the station: its commands follow)
    # (then the station's commands, below)
    AWAIT_CUE 70
    CALL_SCRIPT JUMP_ANGRY_FUNC   # EoS CORO_JUMP_ANGRY_FUNC_SERIES
    AWAIT_CUE 70
    CALL_SCRIPT SWEAT_FUNC
    HALT
end

