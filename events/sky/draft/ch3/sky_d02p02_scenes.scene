script g24_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    SELECT_MAP SKY_GUILD_B2F_CH3
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # eos: supervision_LoadStation(LEVEL_G01P04A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(1); (the map's own NPCs: none in a scene)
    SKY_CAMERA_SET x=208 y=144   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" First things first!"
    AWAIT_CUE 65   # <- BIDOOF done
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> BIDOOF
    AWAIT_CUE 65   # <- BIDOOF done
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 69   # <- PLAYER done
    SKY_CAMERA_MOVE dy=4 speed=384   # EoS MovePositionMark<performer 0>(1.5, Position<'m0', 28.5, 27.5>);
    SKY_CAMERA_MOVE_X dx=-92 speed=384
    WAIT 62   # EoS WaitExecutePerformer(0): the rest of the camera's move
    # eos: message_SetActor(ACTOR_NPC_BIPPA);
    MSG_NPC who=BIDOOF text=" Here, we have Croagunk..."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> BIDOOF
    AWAIT_CUE 65   # <- BIDOOF done
    MSG_NPC who=BIDOOF text=" But to tell the truth, I don't\nhave any idea what that Pokémon's up to..."
    MSG_NPC who=BIDOOF text=" He always seems to be fiddling\naround with that big cauldron back there.\nIt's all a mystery to me! Yup yup!"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=56 speed=384   # EoS MovePositionMark<performer 0>(1.5, Position<'m1', 15.5, 34.5>);
    SKY_CAMERA_MOVE_X dx=-104 speed=384
    ALERT_CUE 64   # -> BIDOOF
    WAIT 79   # EoS WaitExecutePerformer(0): the rest of the camera's move
    MSG_NPC who=BIDOOF text=" Over this way's the mess hall."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE_X dx=176 speed=512   # EoS MovePositionMark<performer 0>(2, Position<'m2', 37.5, 34.5>);
    SKY_CAMERA_MOVE_X dx=208 speed=512   # EoS MovePositionMark<performer 0>(2, Position<'m3', 63.5, 34.5>);
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    ALERT_CUE 66   # -> PARTNER
    WAIT 10
    ALERT_CUE 68   # -> PLAYER
    WAIT 94   # EoS WaitExecutePerformer(0): the rest of the camera's move
    MSG_NPC who=BIDOOF text=" And if you all look that way,\nyou'll find the crew rooms."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=-56 speed=384   # EoS MovePositionMark<performer 0>(1.5, Position<'m4', 52.5, 27.5>);
    SKY_CAMERA_MOVE_X dx=-88 speed=384
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 70   # EoS WaitExecutePerformer(0): the rest of the camera's move
    MSG_NPC who=BIDOOF text=" And this here leads to the\nGuildmaster's Chamber."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE_X dx=-96 speed=384   # EoS MovePositionMark<performer 0>(1.5, Position<'m5', 40.5, 27.5>);
    WAIT 64   # EoS WaitExecutePerformer(0): the rest of the camera's move
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    MSG_NPC who=BIDOOF text=" Next, I'll guide you both around\nplaces outside the guild."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> BIDOOF
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 45
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    FADE_OUT wait=TRUE frames=30
    RET
end

