# ------------------------------------------------------------------------
# group 48: EoS m03a1201 (G01P03A)
# ------------------------------------------------------------------------

script g48_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    BGM_STOP
    SELECT_MAP SKY_GUILD_B1F_CH3
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=328 y=152   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_JOB_CLEAR
    WAIT 30
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" I've gotten the bounty from\nOfficer Magnezone for the captured outlaw! ♪"
    MSG_NPC who=CHATOT text=" Well done, you two! ♪"
    MSG_NPC who=CHATOT text=" Here's your share for the job.{WAIT_PRESS}\nIt's yours to keep! ♪"
    TEXTBOX_CLEAR
    FANFARE_PLAY 203   # EoS me_Play(4)
    MSG_INSTANT text="{CENTER_ALIGN}{NAME_0}'s team received\n{CENTER_ALIGN}the 3,000 Poké bounty that was on\n{CENTER_ALIGN}the head of the captured outlaw!"   # EoS message_Mail
    WAIT_FANFARE1 203
    TEXTBOX_CLEAR
    MSG_INSTANT text="{CENTER_ALIGN}However..."   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}Because 2,700 Poké of that\n{CENTER_ALIGN}is the guild's share..."   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}That portion was withheld..."   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}As a result,\n{CENTER_ALIGN}{NAME_0}'s team..."   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}Received only the\n{CENTER_ALIGN}remaining 300 Poké!"   # EoS message_Mail
    TEXTBOX_CLEAR
    UPDATE_VARINT CALC_ADD GOLD 300   # EoS $CARRY_GOLD += 300;
    BGM_STOP
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    WAIT_FANFARE2 463
    WAIT 15
    BGM_SWITCH SKY_GUILDMASTER_WIGGLYTUFF
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" No way! This is all we get?!"
    # eos: WaitExecuteLives(ATTENDANT1): nothing to wait for
    # eos: message_KeyWait(); (the line above waits for a button)
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" After all our effort..."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" ...{WAIT_PRESS}But of course!{WAIT_PRESS} It's all part\nof the training!"
    PORTRAIT place=KEEP who=CHATOT emotion=HAPPY
    MSG_NPC who=CHATOT text=" And we expect just as much\neffort tomorrow!{WAIT_PRESS} Hee-heeee! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE_COND 68 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 69   # <- CHATOT done
    ALERT_CUE 68   # -> CHATOT
    AWAIT_CUE 69   # <- CHATOT done
    ALERT_CUE 68   # -> CHATOT
    WAIT 60
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_FLIP who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Urf..."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" It would be nice if they'd give\nus a slightly bigger share of the reward."
    TEXTBOX_CLEAR
    WAIT 30
    ALERT_CUE 66   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" But that's all right.{WAIT_PRESS} We managed\nto rescue Azurill."
    TEXTBOX_CLEAR
    BGM_FADEOUT 190
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" And it's all thanks to you,\n{NAME_0}!"
    MSG_NPC who=PARTNER text=" Because you had that dream,\n{NAME_0}..."
    MSG_NPC who=PARTNER text=" We learned about Azurill's\ntrouble in advance."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=NORMAL
    MSG_QUIET who=PLAYER text="(It's true!)"
    MSG_QUIET who=PLAYER text="(I can't explain it, but...)"
    MSG_QUIET who=PLAYER text="(That first shout I heard from Azurill...)"
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=15
    WAIT 20
    MSG_NPC who=-1 text="{CENTER_ALIGN}H-h-h...HELP!"   # EoS message_Explanation
    TEXTBOX_CLEAR
    FADE_IN wait=TRUE frames=15
    WAIT 20
    MSG_QUIET who=PLAYER text="(And that dream I had...)"
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=15
    RET
end

