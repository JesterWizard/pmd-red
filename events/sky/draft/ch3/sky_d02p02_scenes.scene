    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    ROTATE_TO speed=16 turn=DIR_TRANS_10 direction=NORTHWEST
    AWAIT_CUE 66
    CALL_SCRIPT SWEAT_FUNC
    AWAIT_CUE 66
    ROTATE_TO_LIVES speed=4 turn=SPINRIGHT1 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    EMOTION_EFFECT SMILE
    AWAIT_CUE 66
    EMOTION_EFFECT NONE
    HALT
end

