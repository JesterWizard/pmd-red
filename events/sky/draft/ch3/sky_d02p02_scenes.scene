script g49_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=DROWZEE id=SKY_LIVES_DROWZEE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    SELECT_MAP SKY_MT_BRISTLE_PEAK
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=232 y=192   # EoS camera_SetMyself<performer 0>
    # eos: switch ( sector() ): sector 0
    JUMP_LABEL 0
  LABEL 0
  LABEL 1
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=8 color=RGB_U32(0x00, 0x00, 0x00)
    FADE_IN wait=TRUE frames=15
    SET_PLACE_MODE 4
    WAIT 30
  LABEL 2
    PORTRAIT place=LEFT_BOTTOM_2 who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" If you keep being difficult, it\nwill mean big trouble for you!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 1   # -> AZURILL: batch 1
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=AZURILL emotion=TEARY_EYE
    MSG_NPC who=AZURILL text=" H-h-h...HELP!"
    TEXTBOX_CLEAR
    # eos: switch ( sector() ): sector 0
    JUMP_LABEL 3
  LABEL 3
    FADE_OUT wait=TRUE frames=15
  LABEL 4
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    RET
  LABEL 5
    FANFARE_PLAY2 SE_SKY_VISION_CUT   # EoS se_Play(5139)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=5 color=RGB_U32(0xFF, 0xFF, 0xFF)
    JUMP_LABEL 4
  LABEL 6
    JUMP_LABEL 8
  LABEL 7
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=6 color=RGB_U32(0x00, 0x00, 0x00)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=5 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 30
    JUMP_LABEL 2
  LABEL 8
    RET
end

