# ------------------------------------------------------------------------
# group 44: EoS m03a0801 (D03P41A)
# ------------------------------------------------------------------------

script g44_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=DROWZEE id=SKY_LIVES_DROWZEE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    BGM_STOP
    # eos: back_SetDungeonBanner(5, 0): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    FADE_IN wait=TRUE frames=16
    SET_PLACE_MODE 4
    WAIT 60
    FADE_OUT wait=TRUE frames=16
    WAIT 15
    SCENARIO_CALC SCENARIO_MAIN 4 6   # EoS scenario numbers
    SELECT_MAP SKY_MT_BRISTLE_PEAK
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=232 y=112   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE 65   # <- AZURILL done
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    ALERT_CUE 64   # -> AZURILL
    AWAIT_CUE 65   # <- AZURILL done
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" Uh-oh. It's a dead end."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> AZURILL
    AWAIT_CUE 65   # <- AZURILL done
    MSG_NPC who=AZURILL text=" Excuse me, Mr. Drowzee. Where\nis my lost item?"
    MSG_NPC who=AZURILL text=" Could you show me where the\nitem is now?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=LEFT_BOTTOM_2 who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" Sorry, kiddo."
    MSG_NPC who=DROWZEE text=" Your lost item? It's not here,\nthat's for sure."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    ALERT_CUE 64   # -> AZURILL
    AWAIT_CUE 65   # <- AZURILL done
    MSG_NPC who=AZURILL text=" Huh?"
    TEXTBOX_CLEAR
    WAIT 20
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    ALERT_CUE 64   # -> AZURILL
    # eos: WaitExecuteLives(ATTENDANT1): nothing to wait for
    MSG_NPC who=AZURILL text=" My...big brother..."
    MSG_NPC who=AZURILL text=" My big brother's following us,\nright? He's coming soon?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=DROWZEE text=" Nope. Your big brother's\nnot coming."
    MSG_NPC who=DROWZEE text=" I'll let you in on a little secret.\nThis was all a trick.{WAIT_PRESS} I deceived you."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 473   # EoS se_Play(8973)
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 65   # <- AZURILL done
    PORTRAIT place=KEEP who=AZURILL emotion=TEARY_EYE
    MSG_NPC who=AZURILL text=" Huh?!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=DROWZEE text=" But let's not dwell on that.\nThere's a little favor I need to ask."
    MSG_NPC who=DROWZEE text=" See that hole behind you?"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=-24 speed=128   # EoS MovePositionOffset<performer 0>(0.5, 0, -24);
    ALERT_CUE 64   # -> AZURILL
    AWAIT_CUE 65   # <- AZURILL done
    WAIT 40   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 80
    SKY_CAMERA_MOVE dy=24 speed=128   # EoS MovePositionOffset<performer 0>(0.5, 0, 24);
    WAIT 48   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 15
    MSG_NPC who=DROWZEE text=" Well..."
    MSG_NPC who=DROWZEE text=" There's a rumor that there's a\ntrove of thief treasure inside there!"
    MSG_NPC who=DROWZEE text=" But as you can see, I'm too big\nto squirm my way through that hole."
    MSG_NPC who=DROWZEE text=" And that's where you come in!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 466   # EoS se_Play(8967)
    ALERT_CUE 64   # -> AZURILL
    AWAIT_CUE 65   # <- AZURILL done
    ALERT_CUE 64   # -> AZURILL
    AWAIT_CUE 65   # <- AZURILL done
    MSG_NPC who=DROWZEE text=" Don't worry. Just do as I say."
    MSG_NPC who=DROWZEE text=" Do that, then I'll help you get\nback out of there."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    ALERT_CUE 64   # -> AZURILL
    MSG_NPC who=AZURILL text=" B-but..."
    AWAIT_CUE 65   # <- AZURILL done
    ALERT_CUE 64   # -> AZURILL
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=DROWZEE text=" Go on, get going!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE 67   # <- DROWZEE done
    MSG_NPC who=DROWZEE text=" Go into that hole. And don't\nforget to bring back the treasure!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    PORTRAIT place=KEEP who=AZURILL emotion=SIGH
    MSG_NPC who=AZURILL text=" I want my big brother!"
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    ALERT_CUE 66   # -> DROWZEE
    TEXTBOX_CLEAR
    MSG_NPC who=DROWZEE text=" H-hey! Stop that!"
    AWAIT_CUE 65   # <- AZURILL done
    ALERT_CUE 64   # -> AZURILL
    SKY_CAMERA_MOVE dy=84 speed=640   # EoS MovePositionMark<performer 0>(2.5, Position<'m5', 43.5, 33.5>);
    SKY_CAMERA_MOVE_X dx=4 speed=640
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE 67   # <- DROWZEE done
    ALERT_CUE 66   # -> DROWZEE
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    TEXTBOX_CLEAR
    WAIT 30
    MSG_NPC who=DROWZEE text=" Sheesh! I said that I'll take you\nhome when you're done!"
    MSG_NPC who=DROWZEE text=" If you keep being difficult, it\nwill mean big trouble for you!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=AZURILL emotion=TEARY_EYE
    MSG_NPC who=AZURILL text=" H-h-h...HELP!"
    TEXTBOX_CLEAR
    BGM_STOP
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" Stop right there!"
    FANFARE_PLAY2 466   # EoS se_Play(8967)
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    TEXTBOX_CLEAR
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    SKY_CAMERA_MOVE dy=104 speed=384   # EoS MovePositionMark<performer 0>(1.5, Position<'m7', 43.5, 46.5>);
    WAIT 70   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 60
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    SKY_CAMERA_MOVE dy=-64 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m8', 43.5, 38.5>);
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 5 0   # EoS Unlock(5): once it is waiting
    WAIT 59   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" We won't let you do that!{WAIT_PRESS}\nDrowzee, you bully!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" H-how did you find this place?!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" We're Team {TEAM_NAME}!{WAIT_PRESS}\nAn exploration team!"
    MSG_NPC who=PARTNER text=" No criminal can escape us!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    WAIT 8
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    WAIT 8
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    WAIT 8
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    UPDATE_VARINT CALC_SET EVENT_LOCAL 0   # EoS clear $EVENT_LOCAL;
    AWAIT_CUE_COND 6 0   # EoS Unlock(6): once it is waiting
    MSG_NPC who=DROWZEE text=" An exploration team?!{WAIT_PRESS} You came\nto apprehend..."
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    WAIT 45
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    MSG_NPC who=DROWZEE text=" ...Huh?{WAIT_PRESS} Are you...trembling?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 20
    MSG_NPC who=DROWZEE text=" A-ha! I've figured it out!"
    MSG_NPC who=DROWZEE text=" You say you're on an exploration\nteam, but you're total rookies!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Urk!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=DROWZEE text=" Heh.{WAIT_PRESS} That's right, I'm a wanted\nPokémon with a bounty on my head."
    MSG_NPC who=DROWZEE text=" But can you two do the job?"
    MSG_NPC who=DROWZEE text=" Can you confront this outlaw and\nbring him to justice?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" Urk!"
    TEXTBOX_CLEAR
    WAIT 60
    UPDATE_VARINT CALC_SET EVENT_LOCAL 1   # EoS $EVENT_LOCAL = 1;
    AWAIT_CUE 7   # EoS WaitLockLives(7, ACTOR_ATTENDANT1);: ATTENDANT1 waits at Lock(7), then takes the station's commands
    WAIT 20
    PORTRAIT place=KEEP who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" Y-yes. We can!{WAIT_PRESS} Yes, we can!"
    FANFARE_PLAY2 457   # EoS se_Play(8971)
    ALERT_CUE 70   # -> PARTNER
    MSG_NPC who=PARTNER text=" We'd never lose to a bad guy\nlike you!"
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    MSG_NPC who=DROWZEE text=" Ha ha ha!{WAIT_PRESS} I've been chased by\nall sorts of exploration teams in my day..."
    MSG_NPC who=DROWZEE text=" But never a sorrier-looking\nbunch than you two!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Urk!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> DROWZEE (waits until it is ready)
    MSG_NPC who=DROWZEE text=" This should be a laugh.{WAIT_PRESS} Let's see\nif you can take me down."
    MSG_NPC who=DROWZEE text=" Show me what you've got!"
    TEXTBOX_CLEAR
    BGM_STOP
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 10
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT_FANFARE2 SE_SKY_FLASH_HEAVY
    # eos: CallCommon(CORO_BOSS_WIPE_FUNC) (the peak's cutscene plays the boss transition: src/sky_boss_wipe.c)
    SCENARIO_CALC SCENARIO_MAIN 4 6   # EoS scenario numbers
    NEXT_DUNGEON frames=30 dungeon=3   # EoS main_EnterDungeon(5)
    # eos: main_EnterDungeon(-1, 30); (the dungeon entered above)
    HALT
    RET
end

