script g27_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    BGM_SWITCH SKY_TREASURE_TOWN
    # eos: CallCommon(CORO_FADE_OUT_ALL_BEFORE) (EoS's top screen: nothing on the GBA)
    SELECT_MAP SKY_TREASURE_TOWN_SQUARE
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # eos: supervision_LoadStation(LEVEL_T01P01A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(10); (the map's own NPCs: none in a scene)
    SKY_CAMERA_SET x=408 y=136   # EoS camera_SetMyself<performer 0>
    WAIT 1
    FADE_IN wait=FALSE frames=30
    SET_PLACE_MODE 4
    FADE2_IN wait=TRUE frames=0
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    WAIT 120
    SKY_CAMERA_MOVE dy=4 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m3', 44, 26.5>);
    SKY_CAMERA_MOVE_X dx=-168 speed=256
    AWAIT_CUE 65   # <- BIDOOF done
    ALERT_CUE 64   # -> BIDOOF
    AWAIT_CUE 67   # <- PLAYER done
    AWAIT_CUE 69   # <- PARTNER done
    # eos: WaitExecutePerformer(0); (the camera has arrived)
    WAIT 20
    PORTRAIT place=LEFT_BOTTOM_2 who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" This is the main square\nfor the local Pokémon..."
    MSG_NPC who=BIDOOF text=" It's called Treasure Town."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh, I can tell you about Treasure\nTown too."
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    WAIT 5
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 5
    ALERT_CUE 66   # -> PLAYER
    SKY_CAMERA_MOVE dy=-40 speed=512   # EoS Move2PositionMark<performer 0>(2, Position<'m4', 65, 21.5>);
    SKY_CAMERA_MOVE_X dx=168 speed=512
    WAIT 87   # EoS WaitExecutePerformer(0): the rest of the camera's move
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" That over there is Duskull Bank."
    MSG_NPC who=PARTNER text=" We can save our money there."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE_X dx=-340 speed=512   # EoS Move2PositionMark<performer 0>(2, Position<'m5', 22.5, 21.5>);
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 150   # EoS WaitExecutePerformer(0): the rest of the camera's move
    MSG_NPC who=PARTNER text=" And that over there is the\nElectivire Link Shop."
    MSG_NPC who=PARTNER text=" That's where you can do things\nlike link moves together, but..."
    MSG_NPC who=PARTNER text=" It looks as if Electivire isn't\naround today."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE_X dx=-100 speed=256   # EoS MovePositionOffset<performer 0>(1, -100, 0);
    WAIT 15
    FADE_OUT wait=TRUE frames=60
    FADE2_OUT wait=TRUE frames=0
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    FADE2_IN wait=TRUE frames=0   # the text layer back for the next scene
    RET
end

