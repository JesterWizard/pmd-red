    AWAIT_CUE 64
    SELECT_ANIMATION 2
    WALK_RELATIVE speed=384 dx=16 dy=16
    WALK_RELATIVE speed=384 dx=0 dy=32
    WALK_RELATIVE speed=384 dx=-16 dy=16
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
