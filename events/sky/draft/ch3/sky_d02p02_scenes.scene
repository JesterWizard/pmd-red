# group 45: EoS m03a0901 (D03P41A)
# ------------------------------------------------------------------------

script g45_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=DROWZEE id=SKY_LIVES_DROWZEE   # the text names it
    BGM_STOP
    # eos: back_SetDungeonBanner(5, 0): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    FADE_IN wait=TRUE frames=16
    SET_PLACE_MODE 4
    WAIT 60
    FADE_OUT wait=TRUE frames=16
    WAIT 15
    SELECT_MAP SKY_MT_BRISTLE_PEAK
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=232 y=232   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    FADE_IN wait=TRUE frames=30
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 64 0   # -> AZURILL (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" Drowzee!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE 71   # <- DROWZEE done
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" Not you again."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" Let go of Azurill, Drowzee!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=DROWZEE text=" You foolish pests. Do I have to\nembarrass you again?"
    MSG_NPC who=DROWZEE text=" You seem to hunger for\npunishment. Let me help you out!"
    MSG_NPC who=DROWZEE text=" C'mon! Whenever you want!"
    TEXTBOX_CLEAR
    BGM_STOP
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 10
    FANFARE_PLAY2 SE_SKY_FLASH_HEAVY   # EoS se_Play(5143)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT_FANFARE2 SE_SKY_FLASH_HEAVY
    # eos: CallCommon(CORO_BOSS_WIPE_FUNC) (the peak's cutscene plays the boss transition: src/sky_boss_wipe.c)
    NEXT_DUNGEON frames=30 dungeon=3   # EoS main_EnterDungeon(5)
    # eos: main_EnterDungeon(-1, 30); (the dungeon entered above)
    RET
end

