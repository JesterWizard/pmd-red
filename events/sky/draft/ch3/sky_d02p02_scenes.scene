# ------------------------------------------------------------------------

script g29_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    BGM_SWITCH SKY_TREASURE_TOWN
    # eos: CallCommon(CORO_FADE_OUT_ALL_BEFORE) (EoS's top screen: nothing on the GBA)
    SELECT_MAP SKY_TREASURE_TOWN_SQUARE
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # eos: supervision_LoadStation(LEVEL_T01P01A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(10); (the map's own NPCs: none in a scene)
    SKY_CAMERA_SET x=240 y=136   # EoS camera_SetMyself<performer 0>
    WAIT 1
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    FADE2_IN wait=TRUE frames=0
    WAIT 30
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" I guess that about covers it."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=LEFT_BOTTOM_2 who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" You sure know a lot, yes sirree!\nAnd that's good to know!"
    MSG_NPC who=BIDOOF text=" All right, then. Come find me\nwhen you're all ready to go."
    MSG_NPC who=BIDOOF text=" I'll give you a helping hand with\nselecting the right outlaw for you."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Thank you. How nice of you,\nBidoof!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    PORTRAIT place=KEEP who=BIDOOF emotion=SIGH
    MSG_NPC who=BIDOOF text=" G-golly, you're embarrassing me!\nAw, shucks..."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    PORTRAIT place=KEEP who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" I'll be waiting at the guild's\nupper underground floor for you."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> BIDOOF
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    ALERT_CUE 64   # -> BIDOOF
    AWAIT_CUE 65   # <- BIDOOF done
    ALERT_CUE 64   # -> BIDOOF
    WAIT 45
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" OK, let's go."
    MSG_NPC who=PARTNER text=" I'd like to see what kinds of\nitems are available!"
    MSG_NPC who=PARTNER text=" Let's go to the Kecleon Market!"
    MSG_NPC who=PARTNER text=" Before we head back, a visit to\nthe Kecleon Market is a must!"
    TEXTBOX_CLEAR
    RET
end

