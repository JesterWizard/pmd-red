script g43_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=MARILL id=SKY_LIVES_MARILL   # the text names it
    SELECT_MAP SKY_MT_BRISTLE_ENTRANCE
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=160 y=104   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_MT_BRISTLE
    AWAIT_CUE_COND 64 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" So you think that Drowzee and\nAzurill went off in this direction?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=MARILL emotion=SIGH
    MSG_NPC who=MARILL text=" Yes..."
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=PARTNER text=" Oh, {NAME_0}! The Drowzee\nand Azurill you saw in your dream..."
    MSG_NPC who=PARTNER text=" You said you saw them in a\nmountainous place, didn't you?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    ALERT_CUE 66   # -> PLAYER
    WAIT 30
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=PARTNER text=" I think they're up ahead here."
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" Let's get going, {NAME_0}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 15
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 67   # <- PLAYER done
    ALERT_CUE 66   # -> PLAYER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    WAIT 20
    FADE_OUT wait=TRUE frames=30
    SCENARIO_CALC SCENARIO_MAIN 4 5   # EoS scenario numbers
    NEXT_DUNGEON frames=30 dungeon=MT_STEEL   # EoS main_EnterDungeon(4)
    # eos: switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) (EoS's team set-up before a dungeon: Red's own runs)
    # eos: main_EnterDungeon(-1, 0); (the dungeon entered above)
    RET
end

