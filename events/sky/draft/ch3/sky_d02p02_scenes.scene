# ------------------------------------------------------------------------
# group 38: EoS m03a0403 (T01P01A)
# ------------------------------------------------------------------------

script g38_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    # eos: CallCommon(CORO_FADE_OUT_ALL_BEFORE) (EoS's top screen: nothing on the GBA)
    SELECT_MAP SKY_TREASURE_TOWN_SQUARE
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # eos: supervision_LoadStation(LEVEL_T01P01A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(10); (the map's own NPCs: none in a scene)
    SKY_CAMERA_SET x=240 y=104   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=5
    SET_PLACE_MODE 4
    FADE2_IN wait=TRUE frames=0
    WAIT 15
    FANFARE_PLAY2 473   # EoS se_Play(8973)
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 65   # <- PLAYER done
    WAIT_FANFARE2 473
    BGM_SWITCH SKY_GROWING_ANXIETY
    PORTRAIT place=RIGHT_BOTTOM who=PLAYER emotion=SUPRISED
    MSG_QUIET who=PLAYER text="(What was that?!)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" It would be nice if those cute\nlittle guys found their item soon."
    TEXTBOX_CLEAR
    WAIT 20
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    MSG_NPC who=PARTNER text=" Huh? Is anything the matter,\n{NAME_0}?"
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PLAYER
    AWAIT_CUE 65   # <- PLAYER done
    MSG_NPC who=PARTNER text=" Why are you looking so grim?"
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PLAYER
    AWAIT_CUE 65   # <- PLAYER done
    MSG_NPC who=PARTNER text=" ...Hmm?{WAIT_PRESS} You want to tell\nme something?"
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    FADE2_OUT wait=TRUE frames=0
    SKY_CAMERA_SET x=404 y=144   # EoS SetPositionMark<performer 0>(Position<'m0', 65, 27.5>);
    ALERT_CUE 64   # -> PLAYER
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 60
    FADE_IN wait=TRUE frames=60
    FADE2_IN wait=TRUE frames=0   # the text layer (screen_FadeOutAll faded it)
    FADE2_IN wait=TRUE frames=0
    WAIT 30
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" What? You had a dizzy spell?"
    MSG_NPC who=PARTNER text=" Then you saw Azurill being\nthreatened by Drowzee?!"
    MSG_NPC who=PARTNER text=" So you want to go rescue\nAzurill right away?"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    MSG_NPC who=PARTNER text=" It's an...emergency?!"
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" Well, what you describe does\nsound like an emergency, but..."
    MSG_NPC who=PARTNER text=" Well, it's not like I don't trust\nyou, {NAME_0}, but..."
    MSG_NPC who=PARTNER text=" I just can't believe it!"
    MSG_NPC who=PARTNER text=" After all, Drowzee seemed to\nbe a sincerely nice Pokémon, didn't he?"
    MSG_NPC who=PARTNER text=" I saw the three of them go off\ntogether earlier..."
    MSG_NPC who=PARTNER text=" They looked like they were\nhaving a good time, didn't they?"
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" You're probably just tired,\n{NAME_0}."
    MSG_NPC who=PARTNER text=" Maybe that's why you just had\nthat bad daydream."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(Was that it...?{WAIT_PRESS} Just a bad daydream?)"
    MSG_QUIET who=PLAYER text="(But come to think of it...{WAIT_PRESS} That Drowzee didn't\nseem like a bad Pokémon.)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Anyway, we're only apprentices.\nWe can't just go off on our own."
    MSG_NPC who=PARTNER text=" Sure, it's a little odd, but..."
    MSG_NPC who=PARTNER text=" We have to focus on our guild\nwork for now."
    MSG_NPC who=PARTNER text=" Let's get all set for exploring,\nthen go meet up with Bidoof."
    MSG_NPC who=PARTNER text=" Bidoof should be waiting for us\non the guild's upper underground floor."
    TEXTBOX_CLEAR
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Let's go, {NAME_0}!"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE_X dx=16 speed=256   # EoS MovePositionLives<performer 0>(1, ACTOR_PLAYER);
    WAIT 16   # EoS WaitExecutePerformer(0): the rest of the camera's move
    BGM_SWITCH SKY_TREASURE_TOWN
    RET
end

script g38_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO_LIVES speed=4 turn=SPINRIGHT1 kind=LIVES_KIND_PARTNER
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    SELECT_ANIMATION 5
    WAIT 45
    SELECT_ANIMATION 2
    WAIT 30
    # (EoS CORO_EXPLANATION_FUNC_SERIES)
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    MOVE_RELATIVE_POS 0 160 36   # EoS SetPositionMark
    SET_DIR_WAIT DIRECTION_WEST 0
    HALT
end

script g38_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE 66
    MOVE_RELATIVE_POS 0 160 36   # EoS SetPositionMark
    SET_DIR_WAIT DIRECTION_EAST 0
    AWAIT_CUE 66
    CALL_SCRIPT JUMP_SURPRISE_FUNC   # EoS CORO_JUMP_SURPRISE_FUNC_SERIES
    AWAIT_CUE 66
    CALL_SCRIPT SWEAT_FUNC
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    AWAIT_CUE 66
    CALL_SCRIPT JUMP_HAPPY_FUNC   # EoS CORO_JUMP_HAPPY_FUNC_SERIES
    AWAIT_CUE_COND 67 0   # done: the station waits for this
    HALT
end

actors g38_s0_lives
    actor kind=0 facing=EAST x=47 y=23.5 script=g38_s0_player   # EoS PLAYER
    actor kind=34 facing=EAST x=43 y=23.5 script=g38_s0_partner   # EoS ATTENDANT1
end

# ------------------------------------------------------------------------
# group 39: EoS m03a0502 (G01P03A)
# ------------------------------------------------------------------------

script g39_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    SELECT_MAP SKY_GUILD_B1F_CH3   # EoS: the scene goes on on the map as it is
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    SCENARIO_CALC SCENARIO_MAIN 4 4   # EoS scenario numbers
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    FADE_IN wait=TRUE frames=0   # (the map as it was)
    SET_PLACE_MODE 4
    PORTRAIT place=LEFT_BOTTOM_2 who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" Oh, yes sirree! Reckon you all\nare all ready!"
    MSG_NPC who=BIDOOF text=" Then let's pick ourselves a\nlawbreaker for you to find."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 69   # <- PLAYER done
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE 69   # <- PLAYER done
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" Well, you've got your pick of\nthis sorry bunch of characters."
    TEXTBOX_CLEAR
    # eos: back2_SetMode(4); (the top screen)
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=OUTLAW_BOARD frames=90   # EoS: the top screen's picture
    FADE_IN wait=TRUE frames=20
    # eos: camera2_SetPositionMark(Position<'m2', 19.5, 16.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    # eos: Wait(30); (the CG is up)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Let's see. Which should we pick?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    ALERT_CUE 68   # -> PLAYER
    WAIT 5
    ALERT_CUE 66   # -> PARTNER
    MSG_NPC who=BIDOOF text=" Ahem.{WAIT_PRESS} As your mentor, how\nabout I do the choosing?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" Please don't pick anyone scary!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=BIDOOF text=" Yes sirree, I hear you!{WAIT_PRESS} Let's see.\nEenie, meenie..."
    ALERT_CUE 64   # -> BIDOOF
    TEXTBOX_CLEAR
    WAIT 15
    BGM_STOP
    FANFARE_PLAY2 SE_SKY_SIREN   # EoS se_Play(6415)
    WAIT 15
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Stand clear! Updating listings!"
    MSG_NPC who=-1 text=" Stand clear! Updating listings!"
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(1, 15); (the top screen)
    # eos: back2_SetMode(0); (the top screen)
    BGM_SWITCH SKY_EARTHQUAKE1
    CAMERA_SHAKE mode=CUSTOM amp=1 period=1   # EoS camera_SetEffect(2, 1, 1.0);
    WAIT 15
    SKY_CAMERA_SET x=328 y=136   # EoS camera_SetPositionMark(Position<'m3', 55.5, 26.5>);
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 69   # <- PLAYER done
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 67   # <- PARTNER done
    ALERT_CUE 66   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" What's that? What's happening?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=BIDOOF text=" Oh, the data's getting updated."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" It's being...updated?"
    TEXTBOX_CLEAR
    BGM_STOP
    FANFARE_PLAY2 SE_SKY_PANEL_TURN   # EoS se_Play(6416)
    AWAIT_CUE_COND 70 0   # -> G01P03A1_100 (waits until it is ready)
    AWAIT_CUE 71   # <- G01P03A1_100 done
    ALERT_CUE 70   # -> G01P03A1_100
    CAMERA_SHAKE mode=OFF amp=0 period=0
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Yikes! Did you see that?! The\npanel flipped over!"
    TEXTBOX_CLEAR
    # eos: back2_SetMode(4); (the top screen)
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=OUTLAW_BOARD_FLIPPED frames=90   # EoS: the top screen's picture
    FADE_IN wait=TRUE frames=20
    # eos: camera2_SetPositionMark(Position<'m4', 19.5, 16.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    # eos: Wait(30); (the CG is up)
    MSG_NPC who=PARTNER text=" What's going on here?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    MSG_NPC who=BIDOOF text=" The Outlaw Notice Board and Job\nBulletin Board are set up on revolving panels."
    MSG_NPC who=BIDOOF text=" While the panel is flipped over..."
    MSG_NPC who=BIDOOF text=" A Pokémon named Dugtrio\nswaps out the old jobs with new ones."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" Dugtrio?"
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(0, 30); (the top screen)
    FADE_OUT wait=TRUE frames=30
    # eos: back2_SetMode(0); (the top screen)
    RET
end

script g39_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 68
    WALK_RELATIVE speed=256 dx=4 dy=4   # EoS MovePositionMark to Position<'m1', 55.5, 26.5>
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_BIDOOF
    AWAIT_CUE 68
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 68
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 68
    SELECT_ANIMATION 5
    MOVE_RELATIVE speed=256 dx=0 dy=8
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    SELECT_ANIMATION 2
    AWAIT_CUE 68
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 68
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=SKY_LIVES_BIDOOF
    HALT
end

