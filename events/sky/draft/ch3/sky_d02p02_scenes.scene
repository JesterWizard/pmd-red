    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    # eos: supervision_Acting(0); (only the camera's performer)
    # eos: supervision_LoadStation(LEVEL_T01P02A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(10); (the map's own NPCs: none in a scene)
    SKY_CAMERA_SET x=312 y=88   # EoS camera_SetMyself<performer 0>
