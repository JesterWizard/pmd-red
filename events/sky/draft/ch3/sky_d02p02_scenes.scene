# ------------------------------------------------------------------------
# group 42: EoS m03a0511 (P01P01A)
# ------------------------------------------------------------------------

script g42_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=MARILL id=SKY_LIVES_MARILL   # the text names it
    BGM_SWITCH SKY_OH_NO
    SELECT_MAP SKY_CROSSROADS
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=100 y=56   # EoS camera_SetMyself<performer 0>
    WAIT 1
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    FADE_IN wait=TRUE frames=15
    SET_PLACE_MODE 4
    AWAIT_CUE_COND 68 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE 67   # <- PLAYER done
    AWAIT_CUE_COND 68 0   # -> MARILL (waits until it is ready)
    ALERT_CUE 64   # -> PARTNER
    ALERT_CUE 66   # -> PLAYER
    AWAIT_CUE 65   # <- PARTNER done
    ALERT_CUE 64   # -> PARTNER
    PORTRAIT place=MIDLEFT_TOP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Oh! Marill's over there!"
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE dy=60 speed=384   # EoS MovePositionMark<performer 0>(1.5, Position<'m2', 27, 23.5>);
    SKY_CAMERA_MOVE_X dx=4 speed=384
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE 69   # <- MARILL done
    ALERT_CUE 68   # -> MARILL
    WAIT 10
    AWAIT_CUE 65   # <- PARTNER done
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 67   # <- PLAYER done
    ALERT_CUE 66   # -> PLAYER
    # eos: WaitExecutePerformer(0); (the camera has arrived)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Marill, what's the matter?"
    MSG_NPC who=PARTNER text=" Where are Azurill and Drowzee?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE 69   # <- MARILL done
    ALERT_CUE 68   # -> MARILL
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=MARILL emotion=SIGH
    MSG_NPC who=MARILL text=" Yes...about them...!"
    MSG_NPC who=MARILL text=" After we all left, we went\nlooking for our lost item together..."
    MSG_NPC who=MARILL text=" But I wound up all alone when\nMr. Drowzee went somewhere with Azurill."
    MSG_NPC who=MARILL text=" I called and called! But they\ndidn't come back.{WAIT_PRESS} I got scared..."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" So which way did they go?!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=MARILL text=" Th-that way!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> MARILL (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 5
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    WAIT 45
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_OH_NO
    CMD_UNK_AF RESCUE_DUNGEON_MT_STEEL TRUE   # EoS dungeon_mode(4) = DMODE_OPEN; (Mt. Bristle: Red's Mt. Steel)
    RET
end

