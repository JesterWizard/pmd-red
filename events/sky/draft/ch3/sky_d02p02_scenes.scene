# ------------------------------------------------------------------------
# group 40: EoS m03a0505 (V03P03A)
# ------------------------------------------------------------------------

script g40_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    SELECT_MAP SKY_DUGTRIO_TUNNEL
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=36 y=80   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 0   # -> V03P03A2_195 (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> V03P03A1_193 (waits until it is ready)
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE 69   # <- DUGTRIO done
    WAIT 30
    # eos: message_SetActor(ACTOR_NPC_BIPPA);
    MSG_NPC who=BIDOOF text=" Updating data is Dugtrio's duty."
    MSG_NPC who=BIDOOF text=" He tunnels his way to our guild..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_PANEL_TURN   # EoS se_Play(6416)
    ALERT_CUE 68   # -> DUGTRIO
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> V03P03A1_193 (waits until it is ready)
    AWAIT_CUE 67   # <- V03P03A1_193 done
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> SWELLOW (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> WURMPLE (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> SWELLOW (waits until it is ready)
    AWAIT_CUE 71   # <- SWELLOW done
    ALERT_CUE 70   # -> SWELLOW
    AWAIT_CUE_COND 72 0   # -> WURMPLE (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 72 0   # -> WURMPLE (waits until it is ready)
    MSG_NPC who=BIDOOF text=" Then he flips the panel and\nupdates the data."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> SWELLOW (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 72 0   # -> WURMPLE (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    WAIT 15
    FANFARE_PLAY2 SE_SKY_PANEL_TURN   # EoS se_Play(6416)
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    WAIT 10
    ALERT_CUE 66   # -> V03P03A1_193
    AWAIT_CUE 67   # <- V03P03A1_193 done
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> SWELLOW (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> WURMPLE (waits until it is ready)
    AWAIT_CUE 73   # <- WURMPLE done
    AWAIT_CUE_COND 70 0   # -> SWELLOW (waits until it is ready)
    ALERT_CUE 72   # -> WURMPLE
    AWAIT_CUE 73   # <- WURMPLE done
    WAIT 45
    AWAIT_CUE_COND 68 0   # -> DUGTRIO (waits until it is ready)
    AWAIT_CUE 69   # <- DUGTRIO done
    ALERT_CUE 68   # -> DUGTRIO
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 70 0   # -> SWELLOW (waits until it is ready)
    WAIT 5
    ALERT_CUE 72   # -> WURMPLE
    WAIT 15
    MSG_NPC who=BIDOOF text=" This duty doesn't get noticed\nmuch, but it's very important. Yup yup!"
    MSG_NPC who=BIDOOF text=" That's why Dugtrio takes such\ngreat pride in the duty he does!"
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=15
    RET
end

