# ------------------------------------------------------------------------

script g46_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=DROWZEE id=SKY_LIVES_DROWZEE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    BGM_STOP
    SCENARIO_CALC SCENARIO_MAIN 4 7   # EoS scenario numbers
    # eos: $REQUEST_CLEAR_COUNT = 0; (EoS's count of jobs done (its job list): nothing on the GBA)
    SELECT_MAP SKY_MT_BRISTLE_PEAK
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=232 y=208   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> AZURILL (waits until it is ready)
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" Rrrrawrrr!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_DROWZEE_DOWN   # EoS se_Play(6417)
    AWAIT_CUE_COND 64 0   # -> DROWZEE (waits until it is ready)
    WAIT 90
    BGM_SWITCH SKY_IN_THE_DEPTHS_OF_THE_PIT
    SKY_CAMERA_MOVE dy=-116 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m0', 43.5, 20.5>);
    SKY_CAMERA_MOVE_X dx=4 speed=256
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 15
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    WAIT 60
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 66 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 71   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" We're here to rescue you."
    MSG_NPC who=PARTNER text=" Are you OK? You're not hurt,\nare you?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 67   # <- AZURILL done
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" I'm OK."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Great! What a relief!"
    MSG_NPC who=PARTNER text=" Your big brother's waiting.\nLet's go home!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=AZURILL text=" OK."
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_IN_THE_DEPTHS_OF_THE_PIT
    # eos: switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) (EoS's team set-up before a dungeon: Red's own runs)
    RET
end

