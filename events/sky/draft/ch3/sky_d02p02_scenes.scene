    SKY_CAMERA_MOVE_X dx=-88 speed=384
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    FADE2_IN wait=TRUE frames=0
    WAIT 59   # EoS WaitExecutePerformer(0): the rest of the camera's move
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" This is Kecleon Market. You\ncan buy and sell items here."
    TEXTBOX_CLEAR
    SKY_CAMERA_MOVE_X dx=-156 speed=384   # EoS Move2PositionMark<performer 0>(1.5, Position<'m1', 22.5, 20.5>);
    WAIT 104   # EoS WaitExecutePerformer(0): the rest of the camera's move
    MSG_NPC who=PARTNER text=" And there's Kangaskhan Storage.\nItems stored here will never be lost."
    MSG_NPC who=PARTNER text=" If you have precious items that\nyou can't afford to lose, store them here\nbefore you go on an adventure."
    MSG_NPC who=PARTNER text=" And those are the basic places\nthat exploration teams visit."
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=60
    FADE2_OUT wait=TRUE frames=0
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
