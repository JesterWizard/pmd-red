# ------------------------------------------------------------------------
# group 23: EoS m03a0102 (G01P03A)
# ------------------------------------------------------------------------

script g23_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=CHATOT id=SKY_LIVES_CHATOT   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    SELECT_MAP SKY_GUILD_B1F_CH3
    # eos: supervision_Acting(0); (only the camera's performer)
    # eos: supervision_LoadStation(LEVEL_G01P03A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(1); (the map's own NPCs: none in a scene)
    SKY_CAMERA_SET x=236 y=152   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    WAIT 30
    SELECT_LIVES group=-1 sector=2   # EoS supervision_Acting(2)
    WAIT 30
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    WAIT 30
    SELECT_LIVES group=-1 sector=3   # EoS supervision_Acting(3)
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    SKY_CAMERA_MOVE dy=4 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m3', 55.5, 28.5>);
    SKY_CAMERA_MOVE_X dx=96 speed=256
    AWAIT_CUE 67   # <- PLAYER done
    ALERT_CUE 66   # -> PLAYER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE 67   # <- PLAYER done
    AWAIT_CUE 69   # <- PARTNER done
    # eos: WaitExecutePerformer(0); (the camera has arrived)
    WAIT 30
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    ALERT_CUE 68   # -> PARTNER
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh?"
    AWAIT_CUE 69   # <- PARTNER done
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    ALERT_CUE 66   # -> PLAYER
    PORTRAIT place=LEFT_BOTTOM_FLIP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Last time we did a job, it was\nfrom the board on the other side..."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=MIDLEFT_TOP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Correct! ♪"
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=CHATOT text=" Today, we'll have you do a job\nlisted on this side. ♪"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" How is this different from the\nboard on the other side?"
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    MSG_NPC who=CHATOT text=" Take a closer look! ♪"
    TEXTBOX_CLEAR
    # eos: back2_SetMode(4); (the top screen)
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=OUTLAW_BOARD frames=90   # EoS: the top screen's picture
    FADE_IN wait=TRUE frames=20
    # eos: camera2_SetPositionMark(Position<'m4', 19.5, 16.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    # eos: Wait(30); (the CG is up)
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    MSG_NPC who=PARTNER text=" Oh! Look at this, {NAME_0}!"
    MSG_NPC who=PARTNER text=" There are posters up here that\nshow a variety of Pokémon!"
    MSG_NPC who=PARTNER text=" Wow, they all look sort of cool!\nAre they famous explorers?"
    MSG_NPC who=PARTNER text=" Who are these Pokémon, Chatot?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    MSG_NPC who=CHATOT text=" The Pokémon posted here...{WAIT_PRESS}\nare outlaws."
    MSG_NPC who=CHATOT text=" They're all shady characters.\nAnd they're wanted for committing crimes."
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(1, 15); (the top screen)
    # eos: back2_SetMode(0); (the top screen)
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    ALERT_CUE 66   # -> PLAYER
    ALERT_CUE 68   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Oh my gosh!{WAIT_PRESS} They're wanted\nby the law?"
    AWAIT_CUE 69   # <- PARTNER done
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    MSG_NPC who=CHATOT text=" Correct.{WAIT_PRESS} So there are bounties\non their heads."
    MSG_NPC who=CHATOT text=" In other words, there is a cash\nreward if you capture one."
    MSG_NPC who=CHATOT text=" There are so many aggressive\nPokémon around these days that everyone's\nfinding it hard to keep up with the problem."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" And we're supposed to go catch\nthese outlaws?"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    ALERT_CUE 68   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=SHOUTING
    MSG_NPC who=PARTNER text=" No way! That's not possible!"
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    PORTRAIT place=KEEP who=CHATOT emotion=HAPPY
    MSG_NPC who=CHATOT text=" Hee-heeee! ♪{WAIT_PRESS} Just joking! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    WAIT 15
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" The bad Pokémon out there come\nin all shades of badness! ♪"
    MSG_NPC who=CHATOT text=" Some of those Pokémon are\ncompletely wicked, through and through..."
    MSG_NPC who=CHATOT text=" But there are also bad Pokémon\nwho are merely petty thieves. So you've got\nevil to naughty...and everything in between! ♪"
    MSG_NPC who=CHATOT text=" So I'm sure we can avoid giving\nyou a job catching a superbad Pokémon..."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    PORTRAIT place=KEEP who=CHATOT emotion=HAPPY
    MSG_NPC who=CHATOT text=" Hee-heeeee! ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    PORTRAIT place=KEEP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" So look over these posters, then\npick a Pokémon that looks weak enough for you\nto bring to justice! ♪"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=SAD
    MSG_NPC who=PARTNER text=" Um...{WAIT_PRESS} You say some are weak..."
    MSG_NPC who=PARTNER text=" They're still bad Pokémon,\naren't they?"
    MSG_NPC who=PARTNER text=" I'm scared of dangerous\nPokémon!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" It's all a part of your training.\nYou'll work through it, I'm sure! ♪"
    MSG_NPC who=CHATOT text=" But I suppose you do need to be\nprepared to confront a tough opponent..."
    MSG_NPC who=CHATOT text=" So I'll have someone give you a\ntour of the facilities."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    PORTRAIT place=CENTERRIGHT_TOP_FLIP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" Hey! Bidoof!{WAIT_PRESS} Bidoof?!"
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    # eos: message_SetActor(ACTOR_NPC_BIPPA);
    MSG_NPC who=BIDOOF text=" Yup yup!"
    TEXTBOX_CLEAR
    SELECT_LIVES group=-1 sector=4   # EoS supervision_Acting(4)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    WAIT 20
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 71   # <- BIDOOF done
    ALERT_CUE 70   # -> BIDOOF
    AWAIT_CUE 71   # <- BIDOOF done
    AWAIT_CUE_COND 64 0   # -> CHATOT (waits until it is ready)
    AWAIT_CUE 65   # <- CHATOT done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 68   # -> PARTNER
    ALERT_CUE 70   # -> BIDOOF
    PORTRAIT place=LEFT_MIDTOP who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" Huff-puff-huff...{WAIT_PRESS} You called?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=CHATOT text=" Ah, Bidoof! ♪"
    MSG_NPC who=CHATOT text=" These are the new recruits that\njust joined us."
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    MSG_NPC who=CHATOT text=" Take them and show them around\nthe town. ♪"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 71   # <- BIDOOF done
    MSG_NPC who=BIDOOF text=" Yes sirree! By golly, I'll do just\nthat! Yup yup!"
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    PORTRAIT place=MIDLEFT_TOP who=CHATOT emotion=NORMAL
    MSG_NPC who=CHATOT text=" This is Bidoof. He's one of your\nfellow apprentices."
    MSG_NPC who=CHATOT text=" I want you to pay attention to\nwhat Bidoof has to say and follow his orders."
    MSG_NPC who=CHATOT text=" Off you go! ♪"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> BIDOOF
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    AWAIT_CUE 65   # <- CHATOT done
    ALERT_CUE 64   # -> CHATOT
    WAIT 60
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    PORTRAIT place=MIDLEFT_TOP_FLIP who=BIDOOF emotion=TEARY_EYE
    MSG_NPC who=BIDOOF text=" Aw, shucks, I'm overjoyed!"
    AWAIT_CUE 71   # <- BIDOOF done
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=CENTERRIGHT_CENTER_FLIP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" Why's that?"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> BIDOOF
    AWAIT_CUE 71   # <- BIDOOF done
    PORTRAIT place=LEFT_MIDTOP who=BIDOOF emotion=TEARY_EYE
    MSG_NPC who=BIDOOF text=" I'm glad to have members junior\nto me! I'm almost overcome right now...{WAIT_PRESS}\nI might just blubber with happiness!"
    MSG_NPC who=BIDOOF text=" Before you all signed on, I was\nthe most recent rookie..."
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> BIDOOF
    MSG_NPC who=BIDOOF text=" Sniffle..."
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    TEXTBOX_CLEAR
    AWAIT_CUE 71   # <- BIDOOF done
    PORTRAIT place=KEEP who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" Well, I'd best show you around.\nCome with me, please."
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> BIDOOF
    WAIT 10
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> BIDOOF (waits until it is ready)
    FADE_OUT wait=TRUE frames=30
    RET
end

