# ------------------------------------------------------------------------
# group 64: EoS m03a1314 (V03P12A)
# ------------------------------------------------------------------------

script g64_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    BGM_SWITCH SKY_TIME_GEAR_REMIX
    SKY_AMBIENCE song=SKY_STORM frames=0
    SELECT_MAP SKY_GROVYLE_CLOSEUP
    # eos: supervision_Acting(0); (only the camera's performer)
    SKY_CAMERA_SET x=364 y=56   # EoS camera_SetPositionMark(Position<'m0', 60, 16.5>);
    # eos: message_ResetActor(); (no speaker)
    MSG_NPC who=-1 text=" Do my eyes deceive me?{WAIT_PRESS} Could it be...?{WAIT_PRESS}\nYes, it is!"
    TEXTBOX_CLEAR
    FADE_IN wait=TRUE frames=10
    SET_PLACE_MODE 4
    WAIT 45
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    SKY_CAMERA_SET x=52 y=56   # EoS camera_SetPositionMark(Position<'m1', 21, 16.5>);
    WAIT 15
    SKY_CAMERA_SET x=364 y=56   # EoS camera_SetPositionMark(Position<'m2', 60, 16.5>);
    WAIT 30
    MSG_NPC who=-1 text=" I've finally found it!{WAIT_PRESS} A Time Gear!"
    MSG_NPC who=-1 text=" But...{WAIT_PRESS}this is only the first of many..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    SKY_CAMERA_SET x=52 y=56   # EoS camera_SetPositionMark(Position<'m3', 21, 16.5>);
    WAIT 10
    SKY_CAMERA_SET x=364 y=56   # EoS camera_SetPositionMark(Position<'m4', 60, 16.5>);
    WAIT 15
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    WAIT 2
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=2 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    SKY_CAMERA_SET x=52 y=56   # EoS camera_SetPositionMark(Position<'m5', 21, 16.5>);
    WAIT 10
    SKY_CAMERA_SET x=364 y=56   # EoS camera_SetPositionMark(Position<'m6', 60, 16.5>);
    WAIT 90
    BGM_FADEOUT 120
    SKY_AMBIENCE_FADEOUT 120
    FADE_OUT wait=TRUE frames=120
    WAIT 60
    # eos: $SCENARIO_BALANCE_FLAG = 1; (EoS's dungeon-balance stage: nothing on the GBA)
    # eos: $SPECIAL_EPISODE_OPEN[0] = 1; (special episodes: nothing on the GBA)
    RET
end

# ------------------------------------------------------------------------
# group 65: EoS m03a0701 (G01P03A)
# ------------------------------------------------------------------------

script g65_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    SELECT_MAP SKY_MT_BRISTLE_PEAK   # EoS LEVEL_S04P01A: a black screen
    SKY_SHOW_MAP FALSE
    FADE_IN wait=TRUE frames=0
    SET_PLACE_MODE 4
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=PAINED
    MSG_NPC who=PARTNER text=" Hmm. That didn't end well..."
    MSG_NPC who=PARTNER text=" Hmmm... This is really tough...\nLet's call it off for today."
    # eos: message_KeyWait(); (the line above waits for a button)
    FADE_OUT wait=TRUE frames=60
    FADE2_OUT wait=TRUE frames=0
    TEXTBOX_CLEAR
    WAIT 60
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    FADE2_IN wait=TRUE frames=0   # the text layer back for the next scene
    RET
end

script g65_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    HALT
end

script g65_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    HALT
end

actors g65_s0_lives
    actor kind=0 facing=SOUTH x=44 y=26.5 script=g65_s0_player   # EoS PLAYER
    actor kind=34 facing=SOUTH x=40 y=26.5 script=g65_s0_partner   # EoS ATTENDANT1
end

# ------------------------------------------------------------------------
# group 66: EoS m03a0702 (G01P04A)
# ------------------------------------------------------------------------

script g66_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    SELECT_MAP SKY_GUILD_B2F_CH3   # EoS: the scene goes on on the map as it is
    SELECT_ENTITIES group=-1 sector=0   # (its layer 0: who is there)
    FADE_IN wait=TRUE frames=0
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" Hurry! We have to rescue\nAzurill!"
    MSG_NPC who=PARTNER text=" Hurry! Off to Mt. Bristle!"
    TEXTBOX_CLEAR
    RET
end

script g66_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 66
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    HALT
end

script g66_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 64
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    HALT
end

actors g66_s0_lives
    actor kind=0 facing=WEST x=60.5 y=31.5 script=g66_s0_player   # EoS PLAYER
    actor kind=34 facing=WEST x=60.5 y=34 script=g66_s0_partner   # EoS ATTENDANT1
end

