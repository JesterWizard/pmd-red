    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    ROTATE_TO speed=1 turn=DIR_TRANS_10 direction=SOUTH
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    EMOTION_EFFECT SHOCK
    SELECT_ANIMATION 5
    MOVE_RELATIVE speed=384 dx=0 dy=-16   # EoS SlidePositionMark to Position<'m2', 43.5, 17.5>
    AWAIT_CUE_COND 65 0   # done: the station waits for this
    AWAIT_CUE 64
    SELECT_ANIMATION 9
    AWAIT_CUE 64
