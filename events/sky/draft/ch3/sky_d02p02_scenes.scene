    SKY_BUBBLES RAIN   # EoS SetEffect<performer 3>(EFFECT_VERY_HEAVY_RAIN, 3);
    BGM_FADEIN frames=160 song=SKY_STORM
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 60
    FANFARE_PLAY2 461   # EoS se_Play(6401)
    SKY_STORM_BOLT   # EoS SetAnimation<object OBJECT_V01P07B1_191>(18); (chapter 1's lightning, src/sky_storm.c)
    WAIT 118   # EoS WaitAnimation: the storm cloud's lightning (118 frames)
    # eos: WaitExecuteObject(OBJECT_V01P07B1_191); (SKY_STORM_BOLT)
    WAIT 120
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_STORM
    SKY_BUBBLES OFF   # EoS SetEffect<performer 3>(EFFECT_NONE, 3);
    RET
end

# ------------------------------------------------------------------------
# group 52: EoS m03a1302 (G01P07C)
# ------------------------------------------------------------------------

script g52_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    SELECT_MAP SKY_GUILD_CREW_ROOM_NIGHT_CH3
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    BGM_FADEIN frames=120 song=SKY_STORM_INSIDE
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    FANFARE_PLAY2 SE_SKY_THUNDER   # EoS se_Play(6424)
    SKY_BACK_EFFECT 3   # EoS back_SetBackEffect(3);
    WAIT 60
    SKY_BACK_EFFECT 1   # EoS back_SetBackEffect(1);
    WAIT 10
    FANFARE_PLAY2 455   # EoS se_Play(8974)
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    PORTRAIT place=MIDLEFT_TOP who=PARTNER emotion=SUPRISED
    MSG_NPC who=PARTNER text=" Wow, that lightning's intense!"
    TEXTBOX_CLEAR
    WAIT 30
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" It looks like it's really\nstormy tonight..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    WAIT 10
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    MSG_NPC who=PARTNER text=" That reminds me!"
    MSG_NPC who=PARTNER text=" You know the night before we\nmet, {NAME_0}?"
    MSG_NPC who=PARTNER text=" It was storming that night."
    MSG_NPC who=PARTNER text=" I found you out cold on the\nbeach the day after that stormy night,\n{NAME_0}."
    MSG_NPC who=PARTNER text=" So do you remember anything\nabout being out cold on the beach?{WAIT_PRESS} Can you\nremember anything at all?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=WORRIED
    MSG_QUIET who=PLAYER text="(I wonder...{WAIT_PRESS} Hmm...)"
    MSG_QUIET who=PLAYER text="(There was a storm... But how did I end up\nunconscious there?)"
    TEXTBOX_CLEAR
    WAIT 45
    MSG_QUIET who=PLAYER text="(Nope. I can't remember a thing.)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" I guess it won't be that easy."
    MSG_NPC who=PARTNER text=" But that's all right. Just try\nremembering a little at a time."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    WAIT 120
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    MSG_NPC who=PARTNER text=" We have to get up early again\ntomorrow. Let's get some sleep."
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=60
    WAIT_BGM MUS_SKY_STORM_INSIDE
    RET
end

