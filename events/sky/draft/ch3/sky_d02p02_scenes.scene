script g47_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=MARILL id=SKY_LIVES_MARILL   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=MAGNEZONE id=SKY_LIVES_MAGNEZONE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=DROWZEE id=SKY_LIVES_DROWZEE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    BGM_STOP
    SELECT_MAP SKY_MT_BRISTLE_ENTRANCE
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=164 y=160   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=MAGNEZONE emotion=NORMAL
    MSG_NPC who=MAGNEZONE text=" ZZZT! I am Magnezone, the\nprimary officer in this region! ZZZT!"
    MSG_NPC who=MAGNEZONE text=" ZZZT! Thanks to you..."
    MSG_NPC who=MAGNEZONE text=" We have been able to arrest a\nwanted outlaw! ZZZT!"
    MSG_NPC who=MAGNEZONE text=" ZZZT! We owe you great thanks\nfor your cooperation! ZZZT!"
    TEXTBOX_CLEAR
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_MAGNEZONE   # EoS se_Play(6418)
    AWAIT_CUE_COND 64 0   # -> MAGNEZONE (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> MAGNEMITE (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> MAGNEMITE2 (waits until it is ready)
    WAIT 20
    MSG_NPC who=MAGNEZONE text=" ZZZT! We will send the reward\nto your guild. Thank you again! ZZZT!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> MAGNEZONE (waits until it is ready)
    AWAIT_CUE 65   # <- MAGNEZONE done
    MSG_NPC who=MAGNEZONE text=" ZZZT! Now come with us! ZZZT!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_SWEAT_DROP   # EoS se_Play(8961)
    AWAIT_CUE_COND 70 0   # -> DROWZEE (waits until it is ready)
    PORTRAIT place=MIDLEFT_TOP who=DROWZEE emotion=SIGH
    MSG_NPC who=DROWZEE text=" Awww..."
    TEXTBOX_CLEAR
    ALERT_CUE 64   # -> MAGNEZONE
    WAIT 15
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> MAGNEMITE (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> MAGNEMITE2 (waits until it is ready)
    AWAIT_CUE 71   # <- DROWZEE done
    AWAIT_CUE_COND 76 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 70   # -> DROWZEE
    AWAIT_CUE 69   # <- MAGNEMITE2 done
    AWAIT_CUE_COND 76 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> MAGNEMITE (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> DROWZEE (waits until it is ready)
    ALERT_CUE 68   # -> MAGNEMITE2
    AWAIT_CUE 69   # <- MAGNEMITE2 done
    AWAIT_CUE_COND 64 0   # -> MAGNEZONE (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> DROWZEE (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> MAGNEMITE (waits until it is ready)
    ALERT_CUE 68   # -> MAGNEMITE2
    SELECT_LIVES group=-1 sector=1   # EoS supervision_Acting(1)
    # eos: message_SetActor(ACTOR_NPC_MARIRU);
    MSG_NPC who=MARILL text=" Azurill!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 75   # <- AZURILL done
    AWAIT_CUE_COND 76 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    SKY_CAMERA_MOVE dy=80 speed=384   # EoS MovePositionOffset<performer 0>(1.5, 0, 80);
    WAIT 54   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 30
    ALERT_CUE 74   # -> AZURILL
    AWAIT_CUE 75   # <- AZURILL done
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=AZURILL emotion=TEARY_EYE
    MSG_NPC who=AZURILL text=" Marill!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 78 0   # -> MARILL (waits until it is ready)
    ALERT_CUE 74   # -> AZURILL
    SKY_CAMERA_MOVE dy=-36 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m2', 35, 34.5>);
    SKY_CAMERA_MOVE_X dx=4 speed=256
    AWAIT_CUE 79   # <- MARILL done
    WAIT 7   # EoS WaitExecutePerformer(0): the rest of the camera's move
    BGM_SWITCH SKY_HEARTWARMING
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 75   # <- AZURILL done
    PORTRAIT place=MIDRIGHT_BOTTOM_FLIP who=AZURILL emotion=SIGH
    # eos: message_FacePositionOffset(-1, -2); (the face stays at its place on the GBA)
    MSG_NPC who=AZURILL text=" Waaaaah!"
    MSG_NPC who=AZURILL text=" Marill!{WAIT_PRESS} It was so scary!"
    ALERT_CUE 74   # -> AZURILL
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=LEFT_BOTTOM_2 who=MARILL emotion=SIGH
    MSG_NPC who=MARILL text=" You OK, Azurill?{WAIT_PRESS} Are you hurt?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    WAIT 15
    AWAIT_CUE_COND 76 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 77   # <- PLAYER done
    PORTRAIT place=MIDLEFT_TOP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" He's fine. The little guy's not\nhurt in any way."
    TEXTBOX_CLEAR
    ALERT_CUE 78   # -> MARILL
    AWAIT_CUE 79   # <- MARILL done
    PORTRAIT place=KEEP who=MARILL emotion=NORMAL
    MSG_NPC who=MARILL text=" Really?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=MARILL emotion=TEARY_EYE
    MSG_NPC who=MARILL text=" That's a relief!"
    # eos: message_KeyWait(); (the line above waits for a button)
    ALERT_CUE 78   # -> MARILL
    MSG_NPC who=MARILL text=" Oh, Azurill...{WAIT_PRESS}Azurill..."
    WAIT 10
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    TEXTBOX_CLEAR
    WAIT 20
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" I'm truly happy for you two!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 78 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 79   # <- MARILL done
    ALERT_CUE 78   # -> MARILL
    AWAIT_CUE 75   # <- AZURILL done
    ALERT_CUE 74   # -> AZURILL
    AWAIT_CUE 75   # <- AZURILL done
    PORTRAIT place=KEEP who=MARILL emotion=NORMAL
    MSG_NPC who=MARILL text=" You did this all for us,\n{NAME_1} and {NAME_0}."
    MSG_NPC who=MARILL text=" We won't forget what you did\nfor us.{WAIT_PRESS} Thank you so much."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 78 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE 79   # <- MARILL done
    ALERT_CUE 74   # -> AZURILL
    MSG_NPC who=MARILL text=" Come on, Azurill. You too."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=AZURILL emotion=TEARY_EYE
    MSG_NPC who=AZURILL text=" Yup..."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 74 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 75   # <- AZURILL done
    ALERT_CUE 78   # -> MARILL
    MSG_NPC who=AZURILL text=" Thank you very much!{WAIT_PRESS} Thank you\nfor rescuing me!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=MARILL text=" Really...{WAIT_PRESS} Really, thank you!"
    TEXTBOX_CLEAR
    BGM_FADEOUT 120
    FADE_OUT wait=TRUE frames=90
    WAIT_BGM MUS_SKY_HEARTWARMING
    WAIT 60
    FANFARE_PLAY 207   # EoS me_Play(7)
    MSG_NPC who=-1 text="{CENTER_ALIGN}The Exploration Team Federation\n{CENTER_ALIGN}has sent a message..."   # EoS message_Explanation
    TEXTBOX_CLEAR
    FANFARE_PLAY 200   # EoS me_Play(1)
    MSG_NPC who=-1 text="{CENTER_ALIGN}{NAME_0}'s team was rewarded\n{CENTER_ALIGN}with an enlarged Treasure Bag!"   # EoS message_Explanation
    MSG_NPC who=-1 text="{CENTER_ALIGN}You can now carry more\n{CENTER_ALIGN}items than you could before!"   # EoS message_Explanation
    MSG_NPC who=-1 text="{CENTER_ALIGN}Wait...{WAIT_PRESS}\n{CENTER_ALIGN}There's one more message."   # EoS message_Explanation
    TEXTBOX_CLEAR
    SELECT_MAP SKY_BIDOOF_HOME
    SELECT_LIVES group=-1 sector=10   # EoS supervision_Acting(10)
    SKY_CAMERA_SET x=176 y=96   # EoS camera_SetMyself<performer 0>
    # TODO eos: back_SetBackEffect(4);
    FADE_IN wait=TRUE frames=15
    WAIT 30
    FANFARE_PLAY 204   # EoS me_Play(5)
    MSG_INSTANT text="{CENTER_ALIGN}The Special Episode\n{CENTER_ALIGN}\"Bidoof's Wish\"\n{CENTER_ALIGN}has been unlocked!"   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}To play a Special Episode,\n{CENTER_ALIGN}select it from the Episode List\n{CENTER_ALIGN}on the Top Menu."   # EoS message_Mail
    MSG_INSTANT text="{CENTER_ALIGN}If you would like to play the Special Episode,\n{CENTER_ALIGN}save your adventure progress, and\n{CENTER_ALIGN}return to the Top Menu."   # EoS message_Mail
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=30
    # TODO eos: back_SetBackEffect(5);
    WAIT 30
    RET
end

