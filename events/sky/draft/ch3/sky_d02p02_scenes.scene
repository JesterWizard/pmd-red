# ------------------------------------------------------------------------
# group 58: EoS m03a1308 (V03P09A)
# ------------------------------------------------------------------------

script g58_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_SWITCH SKY_TIME_GEAR_REMIX
    SELECT_MAP SKY_TIME_FLOW
    # eos: supervision_Acting(0); (only the camera's performer)
    SKY_CAMERA_SET x=40 y=64   # EoS camera_SetPositionMark(Position<'m0', 19.5, 17.5>);
    # eos: back_SetEffect(5, 0); (with back_SetBackEffect(2): SKY_BACK_EFFECT 2 blends the layers)
    SKY_BACK_EFFECT 2   # EoS back_SetBackEffect(2);
    # eos: CallCommon(CORO_FADE_OUT_ALL_BEFORE) (EoS's top screen: nothing on the GBA)
    FADE_IN wait=TRUE frames=60
    SET_PLACE_MODE 4
    FADE2_IN wait=TRUE frames=0
    WAIT 30
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" At the center of such places..."
    MSG_NPC who=PARTNER text=" is what's known as a Time Gear."
    MSG_NPC who=PARTNER text=" Time Gears serve a very\nimportant function."
    MSG_NPC who=PARTNER text=" Each one protects time and keeps\ntime flowing properly in its region."
    TEXTBOX_CLEAR
    WAIT 30
    FADE_OUT wait=TRUE frames=30
    FADE2_OUT wait=TRUE frames=0
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    FADE2_IN wait=TRUE frames=0   # the text layer back for the next scene
    RET
end

# ------------------------------------------------------------------------
# group 59: EoS m03a1309 (V03P05C)
