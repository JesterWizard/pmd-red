# ------------------------------------------------------------------------
# group 36: EoS m03a0401 (T01P01A)
# ------------------------------------------------------------------------

script g36_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=MARILL id=SKY_LIVES_MARILL   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=DROWZEE id=SKY_LIVES_DROWZEE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    SELECT_MAP SKY_TREASURE_TOWN_SQUARE   # EoS: the scene goes on on the map as it is
    BGM_SWITCH SKY_TREASURE_TOWN
    SCENARIO_CALC SCENARIO_MAIN 4 3   # EoS scenario numbers
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    FADE_IN wait=TRUE frames=0   # (the map as it was)
    SET_PLACE_MODE 4
    WAIT 1
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- PARTNER done
    FANFARE_PLAY2 465   # EoS se_Play(8964)
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE 65   # <- PARTNER done
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Say!{WAIT_PRESS} What are they up to?"
    TEXTBOX_CLEAR
    # eos: SetPositionLives<performer 0>(0); (the camera's performer at PLAYER)
    SKY_CAMERA_SET x=152 y=128   # EoS camera_SetMyself<performer 0>
    SKY_CAMERA_MOVE dy=-20 speed=512   # EoS Move2PositionMark<performer 0>(2, Position<'m0', 44.5, 22.5>);
    SKY_CAMERA_MOVE_X dx=92 speed=512
    WAIT 48   # EoS WaitExecutePerformer(0): the rest of the camera's move
    AWAIT_CUE_COND 68 0   # -> AZURILL (waits until it is ready)
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=AZURILL emotion=JOYOUS
    # eos: message_FacePositionOffset(2, 0); (the face stays at its place on the GBA)
    MSG_NPC who=AZURILL text=" Yaaaay!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> MARILL (waits until it is ready)
    AWAIT_CUE 71   # <- MARILL done
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=MARILL emotion=JOYOUS
    MSG_NPC who=MARILL text=" Thank you!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=MIDLEFT_TOP who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" Please! It's nothing."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 10
    ALERT_CUE 64   # -> PARTNER
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PLAYER done
    MSG_NPC who=PARTNER text=" What's happening?"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> MARILL
    AWAIT_CUE 71   # <- MARILL done
    AWAIT_CUE_COND 68 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 69   # <- AZURILL done
    AWAIT_CUE_COND 72 0   # -> DROWZEE (waits until it is ready)
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    ALERT_CUE 68   # -> AZURILL
    AWAIT_CUE 69   # <- AZURILL done
    PORTRAIT place=KEEP who=AZURILL emotion=NORMAL
    # eos: message_FacePositionOffset(2, 0); (the face stays at its place on the GBA)
    MSG_NPC who=AZURILL text=" Oh! Hi!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=MARILL emotion=SIGH
    MSG_NPC who=MARILL text=" Some time ago, we lost an item\nthat's pretty important to us..."
    MSG_NPC who=MARILL text=" We've been looking all over...{WAIT_PRESS}\nBut we haven't found it yet!"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> MARILL
    AWAIT_CUE 71   # <- MARILL done
    ALERT_CUE 68   # -> AZURILL
    AWAIT_CUE 69   # <- AZURILL done
    PORTRAIT place=KEEP who=MARILL emotion=NORMAL
    MSG_NPC who=MARILL text=" Then Mr. Drowzee came along..."
    MSG_NPC who=MARILL text=" And he says he may have seen\nour lost item somewhere!"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> MARILL
    ALERT_CUE 68   # -> AZURILL
    AWAIT_CUE 71   # <- MARILL done
    AWAIT_CUE 69   # <- AZURILL done
    MSG_NPC who=MARILL text=" He even offered to help us look\nfor it."
    MSG_NPC who=MARILL text=" We're so happy about this!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Is that right? How nice for you!"
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> AZURILL
    WAIT 10
    ALERT_CUE 70   # -> MARILL
    AWAIT_CUE 69   # <- AZURILL done
    AWAIT_CUE 71   # <- MARILL done
    AWAIT_CUE_COND 72 0   # -> DROWZEE (waits until it is ready)
    ALERT_CUE 68   # -> AZURILL
    AWAIT_CUE 69   # <- AZURILL done
    PORTRAIT place=KEEP who=AZURILL emotion=JOYOUS
    # eos: message_FacePositionOffset(2, 0); (the face stays at its place on the GBA)
    MSG_NPC who=AZURILL text=" Thank you, Mr. Drowzee!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=DROWZEE text=" Oh, please..."
    MSG_NPC who=DROWZEE text=" I'd have to have a cold heart to\nignore kids in need! I can't turn a blind eye!"
    MSG_NPC who=DROWZEE text=" Let us be on our way to begin\nour search!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=MARILL emotion=JOYOUS
    MSG_NPC who=MARILL text=" Yup!"
    TEXTBOX_CLEAR
    # eos: message_FacePositionOffset(2, 0); (the face stays at its place on the GBA)
    MSG_NPC who=AZURILL text=" Yup!"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> MARILL
    WAIT 10
    ALERT_CUE 66   # -> PLAYER
    AWAIT_CUE_COND 64 0   # -> PARTNER (waits until it is ready)
    # eos: ResetHitAttribute<actor ACTOR_NPC_RURIRI>(31); (scripted actors have no collision on the GBA)
    ALERT_CUE 68   # -> AZURILL
    WAIT 10
    # eos: ResetHitAttribute<actor ACTOR_NPC_SURIIPU>(31); (scripted actors have no collision on the GBA)
    AWAIT_CUE_COND 72 0   # -> DROWZEE (waits until it is ready)
    WAIT 45
    BGM_STOP
    FANFARE_PLAY2 SE_SKY_BUMP   # EoS se_Play(6414)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 73   # <- DROWZEE done
    ALERT_CUE 72   # -> DROWZEE
    AWAIT_CUE 73   # <- DROWZEE done
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=DROWZEE emotion=NORMAL
    MSG_NPC who=DROWZEE text=" Whoops!{WAIT_PRESS} Excuse me."
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> DROWZEE
    WAIT 30
    FANFARE_PLAY2 SE_SKY_DIZZY   # EoS se_Play(5133)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    WAIT 30
    PORTRAIT place=RIGHT_BOTTOM who=PLAYER emotion=PAINED
    MSG_QUIET who=PLAYER text="(Urk...{WAIT_PRESS} Wh-what is this...?)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" That Drowzee sure is nice.{WAIT_PRESS}\nYou've got to admire that!"
    MSG_NPC who=PARTNER text=" With more and more bad\nPokémon around...{WAIT_PRESS}it's hard to do good deeds."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_DIZZY   # EoS se_Play(5133)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    WAIT 30
    MSG_QUIET who=PLAYER text="(It's happening again...)"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_DIZZY   # EoS se_Play(5133)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=4 color=RGB_U32(0x80, 0x60, 0x40)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_05 frames=1 color=RGB_U32(0x00, 0x00, 0x00)
    WAIT 30
    MSG_QUIET who=PLAYER text="(Another dizzy spell...)"
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=5
    FADE2_OUT wait=TRUE frames=0
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    FADE2_IN wait=TRUE frames=0   # the text layer back for the next scene
    RET
end

