# ------------------------------------------------------------------------

script g50_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    SELECT_MAP SKY_GUILD_B1F_CH3
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=328 y=152   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=15
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=NORMAL
    MSG_QUIET who=PLAYER text="(Both of these events...)"
    MSG_QUIET who=PLAYER text="(They took place in the future!)"
    MSG_QUIET who=PLAYER text="(Why was I able to see something like that?)"
    MSG_QUIET who=PLAYER text="(What was that dream about?)"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_STOMACH   # EoS se_Play(8720)
    WAIT_FANFARE2 SE_SKY_STOMACH
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Uh-oh! My stomach growled!"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_STOMACH   # EoS se_Play(8720)
    WAIT_FANFARE2 SE_SKY_STOMACH
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 67   # <- PARTNER done
    BGM_SWITCH SKY_HEARTWARMING
    ALERT_CUE 66   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=JOYOUS
    MSG_NPC who=PARTNER text=" Ha ha ha! Your stomach growled\ntoo, {NAME_0}!"
    MSG_NPC who=PARTNER text=" I guess we must be famished!"
    MSG_NPC who=PARTNER text=" We were so focused on rescuing\nAzurill that I didn't notice at all!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    FANFARE_PLAY2 SE_SKY_STOMACH   # EoS se_Play(8720)
    WAIT_FANFARE2 SE_SKY_STOMACH
    FANFARE_PLAY2 SE_SKY_STOMACH   # EoS se_Play(8720)
    WAIT_FANFARE2 SE_SKY_STOMACH
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    WAIT 15
    ALERT_CUE 66   # -> PARTNER
    WAIT 5
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    MSG_NPC who=PARTNER text=" But now I'm even hungrier!"
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Come on, let's go get dinner,\n{NAME_0}!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 20
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 67   # <- PARTNER done
    ALERT_CUE 66   # -> PARTNER
    AWAIT_CUE 65   # <- PLAYER done
    ALERT_CUE 64   # -> PLAYER
    AWAIT_CUE 67   # <- PARTNER done
    ALERT_CUE 66   # -> PARTNER
    BGM_FADEOUT 120
    FADE_OUT wait=FALSE frames=60
    AWAIT_CUE 65   # <- PLAYER done
    ALERT_CUE 64   # -> PLAYER
    WAIT_BGM MUS_SKY_HEARTWARMING
    RET
end

