# ------------------------------------------------------------------------
# group 35: EoS m03d0314 (T01P02A)
# ------------------------------------------------------------------------

script g35_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=MARILL id=SKY_LIVES_MARILL   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=KECLEON_PURPLE id=SKY_LIVES_KECLEON_PURPLE   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=KECLEON id=SKY_LIVES_KECLEON   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=AZURILL id=SKY_LIVES_AZURILL   # the text names it
    # eos: CallCommon(CORO_FADE_OUT_ALL_BEFORE) (EoS's top screen: nothing on the GBA)
    SELECT_MAP SKY_TREASURE_TOWN_WEST
    # eos: supervision_StationCommon(0); (the map's own NPCs: none in a scene)
    # eos: supervision_StationCommon(99); (the map's own NPCs: none in a scene)
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # eos: supervision_LoadStation(LEVEL_T01P02A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(10); (the map's own NPCs: none in a scene)
    # eos: SetPositionInitial<actor ACTOR_NPC_KAKUREON1>(); (already there)
    # eos: SetPositionInitial<actor ACTOR_NPC_KAKUREON2>(); (already there)
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    SKY_CAMERA_SET x=220 y=120   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=5
    SET_PLACE_MODE 4
    FADE2_IN wait=TRUE frames=0
    WAIT 30
    FANFARE_PLAY2 473   # EoS se_Play(8973)
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 69   # <- PLAYER done
    ALERT_CUE 68   # -> PLAYER
    PORTRAIT place=LEFT_BOTTOM_2 who=PLAYER emotion=SUPRISED
    MSG_QUIET who=PLAYER text="(What was that?)"
    MSG_QUIET who=PLAYER text="(I'm sure I heard a shout for help just now...)"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    WAIT 60
    MSG_QUIET who=PLAYER text="(Did that shout come from you?)"
    TEXTBOX_CLEAR
    BGM_SWITCH SKY_HEARTWARMING
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 70 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 71   # <- AZURILL done
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" Is something the matter?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_SetActor(ACTOR_NPC_MARIRU);
    MSG_NPC who=MARILL text=" Hey, Azurill!{WAIT_PRESS} What's going on?\nHurry home!"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> AZURILL
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 71   # <- AZURILL done
    PORTRAIT place=CENTERLEFT_CENTER who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" Yup! I'm coming! Wait up!"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> AZURILL
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    SKY_CAMERA_MOVE dy=4 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m0', 53, 24.5>);
    SKY_CAMERA_MOVE_X dx=92 speed=256
    AWAIT_CUE_COND 70 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE_COND 74 0   # -> MARILL (waits until it is ready)
    WAIT 93   # EoS WaitExecutePerformer(0): the rest of the camera's move
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=MARILL emotion=NORMAL
    MSG_NPC who=MARILL text=" Are you all right?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=LEFT_BOTTOM_2 who=AZURILL emotion=NORMAL
    MSG_NPC who=AZURILL text=" Yup!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=MARILL text=" We're done with our shopping...\nNow we gotta look for an item we've lost!"
    MSG_NPC who=MARILL text=" Let's get going."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 70 0   # -> AZURILL (waits until it is ready)
    AWAIT_CUE 71   # <- AZURILL done
    MSG_NPC who=AZURILL text=" Yup! I'm coming!"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 74 0   # -> MARILL (waits until it is ready)
    WAIT 15
    # eos: ResetHitAttribute<actor ACTOR_NPC_RURIRI>(31); (scripted actors have no collision on the GBA)
    ALERT_CUE 70   # -> AZURILL
    AWAIT_CUE 75   # <- MARILL done
    ALERT_CUE 74   # -> MARILL
    AWAIT_CUE 71   # <- AZURILL done
    ALERT_CUE 70   # -> AZURILL
    WAIT 30
    SKY_CAMERA_MOVE dy=-4 speed=256   # EoS MovePositionLives<performer 0>(1, ACTOR_PLAYER);
    SKY_CAMERA_MOVE_X dx=-88 speed=256
    WAIT 89   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Ha! Those little guys are cute."
    TEXTBOX_CLEAR
    WAIT 30
    BGM_FADEOUT 120
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 73   # <- PARTNER done
    WAIT 20
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    ALERT_CUE 72   # -> PARTNER
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Huh?{WAIT_PRESS} What's the matter,\n{NAME_0}?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 69   # <- PLAYER done
    WAIT 30
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 69   # <- PLAYER done
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 73   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=WORRIED
    MSG_NPC who=PARTNER text=" Pardon? Did I hear a shout for\nhelp just then?"
    MSG_NPC who=PARTNER text=" Uh, no... I didn't hear anything\nlike that!"
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> PARTNER
    AWAIT_CUE 73   # <- PARTNER done
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Say, Kecleon brothers."
    MSG_NPC who=PARTNER text=" Did you hear anything strange\njust a moment ago?"
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_FLUSTERED   # EoS se_Play(8963)
    AWAIT_CUE_COND 64 0   # -> KECLEON (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> KECLEON_PURPLE (waits until it is ready)
    AWAIT_CUE 67   # <- KECLEON_PURPLE done
    PORTRAIT place=MIDLEFT_TOP who=KECLEON emotion=NORMAL
    MSG_NPC who=KECLEON text=" No, nothing out of the ordinary."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    PORTRAIT place=MIDRIGHT_TOP_FLIP who=KECLEON_PURPLE emotion=NORMAL
    MSG_NPC who=KECLEON_PURPLE text=" I didn't hear anything odd either."
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> PARTNER
    AWAIT_CUE 73   # <- PARTNER done
    MSG_NPC who=PARTNER text=" The Kecleon brothers didn't hear\nanything strange either."
    MSG_NPC who=PARTNER text=" You must have just imagined it,\n{NAME_0}."
    TEXTBOX_CLEAR
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 69   # <- PLAYER done
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=PLAYER emotion=NORMAL
    MSG_QUIET who=PLAYER text="(No, I'm positive that I didn't imagine it.)"
    MSG_QUIET who=PLAYER text="(I definitely heard it!)"
    MSG_QUIET who=PLAYER text="(That shout that I heard...)"
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=15
    FADE2_OUT wait=TRUE frames=0
    # eos: CallCommon(CORO_FADE_OUT_ALL_AFTER) (the scene's end)
    WAIT 15
    # eos: message_EmptyActor(); (no speaker)
    MSG_NPC who=-1 text="{CENTER_ALIGN}H-h-h...HELP!"   # EoS message_Explanation
    TEXTBOX_CLEAR
    # eos: CallCommon(CORO_FADE_OUT_ALL_BEFORE) (EoS's top screen: nothing on the GBA)
    FADE_IN wait=TRUE frames=15
    FADE2_IN wait=TRUE frames=0   # the text layer (screen_FadeOutAll faded it)
    FADE2_IN wait=TRUE frames=0
    WAIT 15
    MSG_QUIET who=PLAYER text="(There's no mistaking it...)"
    MSG_QUIET who=PLAYER text="(That was Azurill's scream!)"
    TEXTBOX_CLEAR
    ALERT_CUE 72   # -> PARTNER
    PORTRAIT place=KEEP who=PARTNER emotion=HAPPY
    MSG_NPC who=PARTNER text=" Uh, are you daydreaming?"
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 72 0   # -> PARTNER (waits until it is ready)
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 69   # <- PLAYER done
    PORTRAIT place=KEEP who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Let's hustle, {NAME_0}!"
    TEXTBOX_CLEAR
    ALERT_CUE 66   # -> KECLEON_PURPLE
    AWAIT_CUE 67   # <- KECLEON_PURPLE done
    BGM_SWITCH SKY_TREASURE_TOWN
    RET
end

script g35_s0_partner   # EoS actor ATTENDANT1, layer 0
