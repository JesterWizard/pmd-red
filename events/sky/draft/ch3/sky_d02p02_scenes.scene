# ------------------------------------------------------------------------
# group 54: EoS m03a1304 (G01P07C)
# ------------------------------------------------------------------------

script g54_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    BGM_STOP
    SELECT_MAP SKY_GUILD_CREW_ROOM_NIGHT_CH3
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=64 y=108   # EoS camera_SetMyself<performer 0>
    AWAIT_CUE_COND 64 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PARTNER (waits until it is ready)
    SKY_AMBIENCE song=SKY_STORM_INSIDE frames=120
    FADE_IN wait=TRUE frames=30   # EoS screen_FadeChange(1, 30, 0, 192); (to full brightness)
    SET_PLACE_MODE 4
    WAIT 30
    WAIT 60
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" Say, {NAME_0}."
    MSG_NPC who=PARTNER text=" Are you still awake,\n{NAME_0}?"
    MSG_NPC who=PARTNER text=" I've been thinking about it since\nit happened."
    SKY_BACK_EFFECT 3   # EoS back_SetBackEffect(3);
    MSG_NPC who=PARTNER text=" That strange dream you had,\n{NAME_0}..."
    SKY_BACK_EFFECT 1   # EoS back_SetBackEffect(1);
    MSG_NPC who=PARTNER text=" Maybe it has to do with you\npersonally, {NAME_0}."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_EmptyActor(); (no speaker)
    MSG_QUIET who=-1 text="(Huh?)"
    TEXTBOX_CLEAR
    SKY_BACK_EFFECT 3   # EoS back_SetBackEffect(3);
    WAIT 60
    SKY_BACK_EFFECT 1   # EoS back_SetBackEffect(1);
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" I can't quite say why."
    MSG_NPC who=PARTNER text=" I sure don't know any other\n{POKEMON_0} who dreams about the future."
    MSG_NPC who=PARTNER text=" And I've never heard of a human\nsuddenly turning into a Pokémon either."
    MSG_NPC who=PARTNER text=" That's why I think those two\nevents are connected."
    MSG_NPC who=PARTNER text=" That's the feeling I keep getting."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_EmptyActor(); (no speaker)
    MSG_QUIET who=-1 text="(The key to unlocking my memory...)"
    MSG_QUIET who=-1 text="(Was it in that dream?)"
    SKY_BACK_EFFECT 3   # EoS back_SetBackEffect(3);
    MSG_QUIET who=-1 text="(But even if that were true...)"
    SKY_BACK_EFFECT 1   # EoS back_SetBackEffect(1);
    MSG_QUIET who=-1 text="(How does it relate to anything else?)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" I don't know what you were like\nas a human, {NAME_0}..."
    MSG_NPC who=PARTNER text=" But I think you must have been\na good person."
    SKY_BACK_EFFECT 3   # EoS back_SetBackEffect(3);
    MSG_NPC who=PARTNER text=" After all, {NAME_0}, it was\nyour dream that helped us catch that\nbad Pokémon."
    SKY_BACK_EFFECT 1   # EoS back_SetBackEffect(1);
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_EmptyActor(); (no speaker)
    MSG_QUIET who=-1 text="(Bad Pokémon, huh...)"
    MSG_QUIET who=-1 text="(Oh! That reminds me of what Chatot said.)"
    MSG_QUIET who=-1 text="(That the growing number of bad Pokémon has\nbeen caused by time going out of whack.)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" You know..."
    MSG_NPC who=PARTNER text=" Time is getting messed up,\nbit by bit, all over the world."
    MSG_NPC who=PARTNER text=" No one seems to know why."
    SKY_BACK_EFFECT 3   # EoS back_SetBackEffect(3);
    MSG_NPC who=PARTNER text=" But everyone believes that the\nTime Gears are somehow involved."
    SKY_BACK_EFFECT 1   # EoS back_SetBackEffect(1);
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_EmptyActor(); (no speaker)
    MSG_QUIET who=-1 text="(Huh?{WAIT_PRESS} Time Gears?)"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_SetActor(ACTOR_ATTENDANT1);
    MSG_NPC who=PARTNER text=" They say Time Gears are hidden\nin secret places around the world."
    TEXTBOX_CLEAR
    SKY_AMBIENCE_FADEOUT 60
    FADE_OUT wait=TRUE frames=30
    RET
end

