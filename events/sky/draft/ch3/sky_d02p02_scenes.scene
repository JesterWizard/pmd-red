# ------------------------------------------------------------------------

script g26_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    SELECT_MAP SKY_CROSSROADS
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    SKY_CAMERA_SET x=100 y=88   # EoS camera_SetMyself<performer 0>
    WAIT 1
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    BGM_SWITCH SKY_TREASURE_TOWN
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    ALERT_CUE 64   # -> BIDOOF
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 6
    AWAIT_CUE_COND 68 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 69   # <- PARTNER done
    SKY_CAMERA_MOVE dy=4 speed=256   # EoS MovePositionMark<performer 0>(1, Position<'m3', 32, 20.5>);
    SKY_CAMERA_MOVE_X dx=44 speed=256
    WAIT 45   # EoS WaitExecutePerformer(0): the rest of the camera's move
    WAIT 10
    PORTRAIT place=LEFT_BOTTOM_2 who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" I hear you can make a record of\nyour adventure at that Watering Hole."
    # eos: message_KeyWait(); (the line above waits for a button)
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    MSG_NPC who=BIDOOF text=" Usually, you make a record of\nyour adventure by going to your bed at\nthe guild, yup yup."
    MSG_NPC who=BIDOOF text=" Seems you can make a record\nof your adventure over there too."
    MSG_NPC who=BIDOOF text=" By golly, it's a handy spot when\nyou want to record your adventure frequently."
    TEXTBOX_CLEAR
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 3
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 2
    ALERT_CUE 68   # -> PARTNER
    AWAIT_CUE 69   # <- PARTNER done
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 10
    AWAIT_CUE_COND 66 0   # -> PLAYER (waits until it is ready)
    WAIT 18
    ALERT_CUE 68   # -> PARTNER
    WAIT 80
    FADE_OUT wait=TRUE frames=30
    RET
end

