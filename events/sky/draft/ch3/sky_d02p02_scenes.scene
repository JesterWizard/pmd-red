# ------------------------------------------------------------------------
# group 32: EoS c00a0701 (S04P01A)
# ------------------------------------------------------------------------

script g32_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    SELECT_MAP SKY_MT_BRISTLE_PEAK   # EoS LEVEL_S04P01A: a black screen
    SKY_SHOW_MAP FALSE
    # eos: supervision_Acting(0); (only the camera's performer)
    SKY_CAMERA_SET x=20 y=24   # EoS camera_SetMyself<performer 0>
    FADE_IN wait=TRUE frames=16
    SET_PLACE_MODE 4
    FANFARE_PLAY2 SE_SKY_VISION_START   # EoS se_Play(5132)
    # eos: SetEffect<performer 3>(621, 3);: the dizzy spell's swirl, as white pulses
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_01 frames=12 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_01 frames=12 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_01 frames=8 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_01 frames=8 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_01 frames=5 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_01 frames=5 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_01 frames=3 color=RGB_U32(0xFF, 0xFF, 0xFF)
    FLASH_FROM wait=TRUE kind=PALUTIL_KIND_01 frames=3 color=RGB_U32(0xFF, 0xFF, 0xFF)
    # eos: WaitEffect<performer 3>(); (the pulses above)
    SKY_CAMERA_SET x=20 y=280   # EoS SetPositionMark<performer 0>(Position<'m0', 17, 44.5>);
    # eos: WaitExecutePerformer(3); (the camera has arrived)
    FLASH_TO wait=TRUE kind=PALUTIL_KIND_05 frames=16 color=RGB_U32(0xFF, 0xFF, 0xFF)
    RET
end

