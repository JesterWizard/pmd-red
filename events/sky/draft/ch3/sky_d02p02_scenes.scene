script g31_s1_marill   # EoS actor NPC_MARIRU, layer 1
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=MARILL id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 70
    WALK_RELATIVE speed=256 dx=-164 dy=4   # EoS Move2PositionMark to Position<'m0', 43.5, 24.5>
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 70
    EMOTION_EFFECT SMILE
    AWAIT_CUE 70
    EMOTION_EFFECT NONE
    AWAIT_CUE 70
    WALK_RELATIVE speed=256 dx=180 dy=0   # EoS Move2PositionMark to Position<'m5', 66, 24.5>
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    WALK_RELATIVE speed=768 dx=-180 dy=0   # EoS Move2PositionMark to Position<'m7', 43.5, 24.5>
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 70
    CALL_SCRIPT NOTICE_FUNC
    AWAIT_CUE 70
    WALK_RELATIVE speed=256 dx=140 dy=0   # EoS MovePositionMark to Position<'m9', 61, 24.5>
    HALT
end

