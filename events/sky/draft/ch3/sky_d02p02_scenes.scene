# ------------------------------------------------------------------------
# group 41: EoS m03a0506 (G01P03A)
# ------------------------------------------------------------------------

script g41_s0_station control=EVENT_CONTROL type=SCRIPT_TYPE_07
    DEBUGINFO
    SET_PLACE_MODE 1
    FADE_OUT wait=TRUE frames=0
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=DUGTRIO id=SKY_LIVES_DUGTRIO   # the text names it
    UPDATE_NAME kind=ACTOR_TYPE who=BIDOOF id=SKY_LIVES_BIDOOF   # the text names it
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD_REMIX
    # eos: back2_SetMode(4); (the top screen)
    # eos: back2_SetGround(LEVEL_V03P02A); (the top screen's picture: OUTLAW_BOARD_FLIPPED; left out as in chapter 1)
    SELECT_MAP SKY_GUILD_B1F_CH3
    SELECT_ENTITIES group=-1 sector=0   # EoS supervision_Acting(0)
    # eos: supervision_LoadStation(LEVEL_G01P03A, 'UM03'): the GBA's event scripts chain the scenes (src/data/ground/sky/sky_ch2_events.h)
    # eos: supervision_Station(4); (the map's own NPCs: none in a scene)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE_COND 66 0   # -> G01P03A1_100 (waits until it is ready)
    # eos: camera2_SetPositionMark(Position<'m0', 19.5, 16.5>); (the top screen's view)
    SKY_CAMERA_SET x=328 y=136   # EoS camera_SetMyself<performer 0>
    # eos: WaitLockLives(5, ACTOR_ATTENDANT1); (Unlock below waits for it)
    # eos: screen2_FadeIn(0, 30); (the top screen)
    FADE_IN wait=TRUE frames=30
    SET_PLACE_MODE 4
    WAIT 30
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Oh, is that so?"
    TEXTBOX_CLEAR
    WAIT 15
    FANFARE_PLAY2 SE_SKY_SIREN   # EoS se_Play(6415)
    WAIT 15
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 5 0   # EoS Unlock(5): once it is waiting
    # eos: message_SetActor(ACTOR_NPC_DAGUTORIO);
    MSG_NPC who=DUGTRIO text=" Update completed! Stand clear!"
    MSG_NPC who=DUGTRIO text=" Update completed! Stand clear!"
    TEXTBOX_CLEAR
    # eos: WaitLockLives(6, ACTOR_ATTENDANT1); (Unlock below waits for it)
    AWAIT_CUE_COND 6 0   # EoS Unlock(6): once it is waiting
    WAIT 5
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    MSG_NPC who=PARTNER text=" Oh, looks like he's done."
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(1, 15); (the top screen)
    # eos: back2_SetMode(0); (the top screen)
    SKY_AMBIENCE song=SKY_EARTHQUAKE1 frames=0
    CAMERA_SHAKE mode=CUSTOM amp=1 period=1   # EoS camera_SetEffect(2, 1, 1.0);
    WAIT 45
    SKY_AMBIENCE_FADEOUT 0
    FANFARE_PLAY2 SE_SKY_PANEL_TURN   # EoS se_Play(6416)
    AWAIT_CUE_COND 66 0   # -> G01P03A1_100 (waits until it is ready)
    AWAIT_CUE 67   # <- G01P03A1_100 done
    ALERT_CUE 66   # -> G01P03A1_100
    CAMERA_SHAKE mode=OFF amp=0 period=0
    WAIT 45
    PORTRAIT place=RIGHT_BOTTOM_FLIP who=BIDOOF emotion=NORMAL
    MSG_NPC who=BIDOOF text=" Yes sirree! The data is updated."
    MSG_NPC who=BIDOOF text=" The list of outlaws has been\nrefreshed, so let's pick one."
    TEXTBOX_CLEAR
    WAIT 30
    BGM_FADEOUT 120
    UPDATE_VARINT CALC_SET EVENT_LOCAL 0   # EoS clear $EVENT_LOCAL;
    AWAIT_CUE_COND 7 0   # EoS Unlock(7): once it is waiting
    WAIT 15
    PORTRAIT place=KEEP who=PARTNER emotion=DETERMINED
    MSG_NPC who=PARTNER text=" ..."
    TEXTBOX_CLEAR
    FANFARE_PLAY2 SE_SKY_NOTICE_5   # EoS se_Play(8978)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    MSG_NPC who=BIDOOF text=" Huh? What's ailing you?{WAIT_PRESS} Why\nare you shivering all of a sudden?"
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    TEXTBOX_CLEAR
    WAIT 20
    ALERT_CUE 64   # -> BIDOOF
    WAIT 20
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 30
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    WAIT 45
    FANFARE_PLAY2 469   # EoS se_Play(8962)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    MSG_NPC who=BIDOOF text=" It's not cold here, after all."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" P-p-please look at this,\n{NAME_0}!"
    TEXTBOX_CLEAR
    # eos: back2_SetMode(4); (the top screen)
    # eos: screen2_FadeOut(1, 15); (the top screen)
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=OUTLAW_BOARD frames=90   # EoS: the top screen's picture
    FADE_IN wait=TRUE frames=20
    # eos: camera2_SetPositionMark(Position<'m1', 19.5, 16.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    # eos: Wait(30); (the CG is up)
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE 69   # <- PLAYER done
    ALERT_CUE 64   # -> BIDOOF
    MSG_NPC who=PARTNER text=" At the top! On the left!"
    TEXTBOX_CLEAR
    # eos: screen2_FadeOut(1, 15); (the top screen)
    FADE_OUT wait=TRUE frames=20   # fade the scene out and back in around the CG
    SKY_CUTAWAY cg=DROWZEE_POSTER frames=75   # EoS: the top screen's picture
    FADE_IN wait=TRUE frames=20
    # eos: camera2_SetPositionMark(Position<'m2', 19.5, 16.5>); (the top screen's view)
    # eos: screen2_FadeIn(1, 15); (the top screen)
    FANFARE_PLAY2 SE_SKY_NOTICE_3   # EoS se_Play(8966)
    WAIT_FANFARE2 SE_SKY_NOTICE_3
    # eos: Wait(15); (the CG is up)
    FANFARE_PLAY2 463   # EoS se_Play(8968)
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE 69   # <- PLAYER done
    WAIT_FANFARE2 463
    BGM_SWITCH SKY_OH_NO
    MSG_NPC who=PARTNER text=" It's Drowzee!{WAIT_PRESS} H-he's a\nwanted criminal!"
    TEXTBOX_CLEAR
    UPDATE_VARINT CALC_SET EVENT_LOCAL 1   # EoS $EVENT_LOCAL = 1;
    AWAIT_CUE 8   # EoS WaitLockLives(8, ACTOR_ATTENDANT1);: ATTENDANT1 waits at Lock(8), then takes the station's commands
    # eos: screen2_FadeOut(1, 15); (the top screen)
    # eos: back2_SetMode(0); (the top screen)
    WAIT 30
    ALERT_CUE 70   # -> PARTNER
    AWAIT_CUE 71   # <- PARTNER done
    ALERT_CUE 68   # -> PLAYER
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    MSG_NPC who=PARTNER text=" We have to hurry! Azurill will\nbe in trouble!"
    TEXTBOX_CLEAR
    ALERT_CUE 70   # -> PARTNER
    WAIT 5
    AWAIT_CUE_COND 68 0   # -> PLAYER (waits until it is ready)
    AWAIT_CUE_COND 70 0   # -> PARTNER (waits until it is ready)
    AWAIT_CUE 71   # <- PARTNER done
    ALERT_CUE 70   # -> PARTNER
    AWAIT_CUE 69   # <- PLAYER done
    ALERT_CUE 68   # -> PLAYER
    WAIT 30
    FANFARE_PLAY2 470   # EoS se_Play(8972)
    AWAIT_CUE_COND 64 0   # -> BIDOOF (waits until it is ready)
    AWAIT_CUE 65   # <- BIDOOF done
    MSG_NPC who=BIDOOF text=" Now what's going on?"
    MSG_NPC who=BIDOOF text=" Where are you all off to?"
    TEXTBOX_CLEAR
    FADE_OUT wait=TRUE frames=30
    # eos: $PERFORMANCE_PROGRESS_LIST[3] = 1; (unlocks EoS menus: nothing on the GBA)
    RET
end

script g41_s0_player   # EoS actor PLAYER, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PLAYER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    AWAIT_CUE 68
    EMOTION_EFFECT NOTICE   # TODO emotion: EoS EFFECT_TWO_ARROWS_AT_SIDE_RIGHT has no GBA picture: the closest
    AWAIT_CUE 68
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 68
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 68
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    CALL_SCRIPT SHOCK_FUNC
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PARTNER
    AWAIT_CUE 68
    WALK_RELATIVE speed=640 dx=-108 dy=4   # EoS Move2PositionMark to Position<'m4', 41.5, 27.5>
    WALK_RELATIVE speed=640 dx=0 dy=-96   # EoS Move2PositionMark to Position<'m6', 41.5, 15.5>
    WALK_RELATIVE speed=640 dx=0 dy=-32
    AWAIT_CUE_COND 69 0   # done: the station waits for this
    AWAIT_CUE 68
    END_DELETE
end

script g41_s0_partner   # EoS actor ATTENDANT1, layer 0
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=PARTNER id=0x0
    CLEAR_OBJ_FLAGS INTERACT_MASK   # scripted: no collision
    # EoS: its own coroutine (def ... for actor ATTENDANT1)
    SELECT_ANIMATION 2
    AWAIT_CUE 5   # EoS Lock(5)
    EMOTION_EFFECT NOTICE
    AWAIT_CUE 6   # EoS Lock(6)
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=NORTH
    AWAIT_CUE 7   # EoS Lock(7)
    # eos: ResetHitAttribute(31); (scripted actors have no collision on the GBA)
    SELECT_ANIMATION 3
  LABEL 0
  LABEL 1
    MOVE_RELATIVE speed=256 dx=1 dy=0
    WAIT 1
    MOVE_RELATIVE speed=256 dx=-1 dy=0
    WAIT 1
    JUMPIF_EQUAL EVENT_LOCAL 1 2
    JUMP_LABEL 3
  LABEL 2
    JUMP_LABEL 5
    JUMP_LABEL 4
  LABEL 3
    JUMP_LABEL 4
  LABEL 4
    WAIT 1   # (a forever loop)
    JUMP_LABEL 1
  LABEL 5
  LABEL 6
    SELECT_ANIMATION 2
    AWAIT_CUE_COND 8 0   # EoS Lock(8); hold: the station takes over
    # eos: hold (handed over to the station: its commands follow)
    # (then the station's commands, below)
    AWAIT_CUE 70
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    WALK_RELATIVE speed=640 dx=-84 dy=4   # EoS Move2PositionMark to Position<'m3', 41.5, 27.5>
    AWAIT_CUE 70
    WALK_RELATIVE speed=640 dx=0 dy=-96   # EoS Move2PositionMark to Position<'m5', 41.5, 15.5>
    WALK_RELATIVE speed=640 dx=0 dy=-32
    AWAIT_CUE_COND 71 0   # done: the station waits for this
    AWAIT_CUE 70
    END_DELETE
end

