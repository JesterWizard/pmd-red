script g2_sign_enter13   # EoS G01P03A enter13
    DEBUGINFO
    WAIT 1
    MSG_INSTANT text="\n{CENTER_ALIGN}All sorts of information is written here..."   # EoS message_Notice
    TEXTBOX_CLEAR
    # eos: message_ResetActor(); (no speaker)
    UPDATE_VARINT CALC_SET EVENT_LOCAL 8   # EoS $EVENT_LOCAL = 8;
    # eos: switch ( message_Menu(MENU_GUILD_F_A_Q_BOARD) ) (every question and its answer, in order)
  LABEL 0
    MSG_INSTANT text="Q1: What's the Exploration Team Federation?"   # EoS message_Mail
    MSG_INSTANT text="A1: The Pokémon Exploration Team Federation\nis a mysterious organization to which all\nexcellent explorers belong."   # EoS message_Mail
    MSG_INSTANT text="The Federation collects dues from guilds\nnationwide for producing items and badges\nused by exploration teams."   # EoS message_Mail
    MSG_INSTANT text="The Federation also operates a number of\nservices for explorers. It's an indispensable\norganization for explorers!"   # EoS message_Mail
    MSG_INSTANT text="To put it simply, it's an incredibly great\norganization!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q2: What's written here?"   # EoS message_Mail
    MSG_INSTANT text="A2: This spot is reserved for useful notices,\nhints, tips, advice, and so on."   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q3: How do I know what to do?"   # EoS message_Mail
    MSG_INSTANT text="A3: If you're not sure what to do, try looking\nup some hints!"   # EoS message_Mail
    MSG_INSTANT text="To get some hints, press START to access the\nmenu, then find them under Others."   # EoS message_Mail
    MSG_INSTANT text="The hints will give you all sorts of useful\ninformation for your explorations."   # EoS message_Mail
    MSG_INSTANT text="So if you're stuck, look up some hints!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q4: How do I start a job?"   # EoS message_Mail
    MSG_INSTANT text="A4: If you've already put the job on your Job\nList, you must then use the Take Job option."   # EoS message_Mail
    MSG_INSTANT text="If you see a job on the Job Bulletin Board or\nthe Outlaw Notice Board that you want to do,\nyou have to do two things..."   # EoS message_Mail
    MSG_INSTANT text="First, choose the job from a board to add it to\nyour Job List. Second, select it from your Job\nList, then use the Take Job option."   # EoS message_Mail
    MSG_INSTANT text="Exploration teams should take care of jobs\nthey've added to their list as soon as possible!"   # EoS message_Mail
    MSG_INSTANT text="Now, go! Quit reading this and explore!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q5: What's the Explorer Rank?"   # EoS message_Mail
    MSG_INSTANT text="A5: The Explorer Rank indicates your\nstanding within the Pokémon Exploration Team\nFederation."   # EoS message_Mail
    MSG_INSTANT text="An exploration team gains Rank Points for\ncompleting jobs. Upon earning set amounts\nof points, the team goes up in rank."   # EoS message_Mail
    MSG_INSTANT text="A team gets a new Explorer Badge when it\ngoes up in rank. But that's not all. You'll\ndiscover more benefits as you rank up!"   # EoS message_Mail
    MSG_INSTANT text="Finally, you'll notice that there is a footprint\nimprinted on the back of the badge."   # EoS message_Mail
    MSG_INSTANT text="That doubles as a security pass for the guild.\nIt lets you enter and exit the guild whenever\nyou want. Did you know that?"   # EoS message_Mail
    MSG_INSTANT text="Those who are first starting out should work\ntoward the Bronze Rank!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q6: Is eating Gummis a good thing to do?"   # EoS message_Mail
    MSG_INSTANT text="A6: Yes! Of course you should eat Gummis!\nIt boosts your IQ!"   # EoS message_Mail
    MSG_INSTANT text="When your IQ goes up, you'll gain IQ Skills\nthat help you while exploring."   # EoS message_Mail
    MSG_INSTANT text="That's why you shouldn't hesitate to eat\nGummis. Eat as much as you want!"   # EoS message_Mail
    MSG_INSTANT text="Specific types of Pokémon have a different\nfavorite Gummi. If a Pokémon eats its\nfavorite, its IQ goes up much faster!"   # EoS message_Mail
    MSG_INSTANT text="It's great to eat lots of Gummis! And it's best\nto eat lots of your favorite kind of Gummis!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q7: How do I talk to my partner?"   # EoS message_Mail
    MSG_INSTANT text="A7: What?{WAIT_PRESS} Your partner is right next to you,\nbut you can't chat?"   # EoS message_Mail
    MSG_INSTANT text="Just be brave and talk to your partner. Your\nfriend will understand what's on your mind."   # EoS message_Mail
    MSG_INSTANT text="Press A to talk to your partner. Your partner\nwill never ignore you!"   # EoS message_Mail
    MSG_INSTANT text="Talk to your partner especially if you're not\nsure what to do next. Press A and strike up\na conversation!"   # EoS message_Mail
    MSG_INSTANT text="Your partner is sure to have useful advice\nfor you!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    MSG_INSTANT text="Q8: What are types?"   # EoS message_Mail
    MSG_INSTANT text="A8: Pokémon are categorized by types such as\nFire, Water, and Grass. Many Pokémon even\nhave two types."   # EoS message_Mail
    MSG_INSTANT text="The amount of damage that an attacking\nPokémon does with its move is related to the\nmove's type and the defending Pokémon's type."   # EoS message_Mail
    MSG_INSTANT text="For example, a Fire-type Pokémon is weak\nagainst Water-type moves."   # EoS message_Mail
    MSG_INSTANT text="And a Water-type Pokémon will be weak to\nElectric-type moves."   # EoS message_Mail
    MSG_INSTANT text="Learn how all types of Pokémon and moves\nmatch up, so you can battle effectively.{WAIT_PRESS}\nThat's you, the exploration team reading this!"   # EoS message_Mail
    MSG_INSTANT text="...That is all."   # EoS message_Mail
    TEXTBOX_CLEAR
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

