script g9_talk_enter11   # EoS T01P02A enter11 (NPC_KAKUREON2)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 901
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0), (4, 2), (4, 3), (4, 4), (4, 5), (4, 6)
    SPECIAL_TEXT SPECIAL_TEXT_PURPLE_KECLEON_SHOP 0 0   # EoS message_Menu(MENU_KECLEON_WARES)
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 1)
    SPECIAL_TEXT SPECIAL_TEXT_PURPLE_KECLEON_SHOP 0 0   # EoS message_Menu(MENU_KECLEON_WARES)
    EXECUTE_FUNCTION SKY_CH3_KECLEON_EVENT   # EoS supervision_ExecuteCommon(CORO_EVENT_M03_03);
    HALT   # the event takes over
