script g2_s0_station control=ENTER_CONTROL type=SCRIPT_TYPE_01   # the guild's B1F (EoS G01P03A, station UM03): Bidoof waits by the Outlaw Notice Board
    DEBUGINFO
    SELECT_MAP SKY_GUILD_B1F_CH3
    UPDATE_VARINT CALC_SET PARTNER1_KIND 2   # the partner (lives kind 4) follows the hero
    SELECT_ENTITIES group=-1 sector=1   # signs, objects, shopkeepers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 2   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 2   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 3   # fail
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 3   # fail
    JUMP_LABEL 1
  LABEL 2
    SELECT_LIVES group=-1 sector=2   # open: who is there
    JUMP_LABEL 1
  LABEL 3
    SELECT_LIVES group=-1 sector=3   # fail: who is there
    JUMP_LABEL 1
  LABEL 1
    CJUMP_VAR GROUND_ENTER_LINK   # where the hero comes in
    COND_EQUAL 1 101
    COND_EQUAL 2 102
    JUMP_LABEL 101
  LABEL 101
    SELECT_LIVES group=-1 sector=10
    JUMP_LABEL 2
  LABEL 102
    SELECT_LIVES group=-1 sector=11
    JUMP_LABEL 2
  LABEL 2
    SELECT_EVENTS g=-1 s=0   # the exits
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    FADE_IN wait=FALSE frames=-1
    RET
end

script g3_exit0 control=GETOUT_NORMAL type=SCRIPT_TYPE_02   # to SKY_GUILD_ENTRANCE_DAY (entry 1)
    DEBUGINFO
    SKY_GOTO_MAP map=MAP_SKY_GUILD_ENTRANCE_DAY link=1
    HALT
end

script g3_exit1 control=GETOUT_NORMAL type=SCRIPT_TYPE_02   # to SKY_GUILD_B1F_CH3 (entry 1)
    DEBUGINFO
    SKY_GOTO_MAP map=MAP_SKY_GUILD_B1F_CH3 link=1
    HALT
end

script g3_sign_enter07   # EoS G01P02A enter07
    DEBUGINFO
    WAIT 1
    MSG_INSTANT text="{CENTER_ALIGN}Wigglytuff's Guild\n{CENTER_ALIGN}Ten Rules for Exploration Teams"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}One!{WAIT_PRESS}\n{CENTER_ALIGN}Don't shirk work!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Two!{WAIT_PRESS}\n{CENTER_ALIGN}Run away and pay!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Three!{WAIT_PRESS}\n{CENTER_ALIGN}Smiles go for miles!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Four!{WAIT_PRESS}\n{CENTER_ALIGN}Once you put a job on your team's list,\n{CENTER_ALIGN}then use Take Job! That step can't be missed!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Five!{WAIT_PRESS}\n{CENTER_ALIGN}Restock your supplies and rations\n{CENTER_ALIGN}before heading out on explorations!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Six!{WAIT_PRESS}\n{CENTER_ALIGN}Before you explore, try to think\n{CENTER_ALIGN}about the moves you should link!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Seven!{WAIT_PRESS}\n{CENTER_ALIGN}While exploring, don't you panic!\n{CENTER_ALIGN}Stay cool and calm, never manic!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Eight!{WAIT_PRESS}\n{CENTER_ALIGN}Helping all Pokémon in need\n{CENTER_ALIGN}is an explorer's duty, indeed!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Nine!{WAIT_PRESS}\n{CENTER_ALIGN}Do lots of jobs! That's truly the key!\n{CENTER_ALIGN}You'll reach Gold Rank. Just wait and see!"   # EoS message_Notice
    MSG_INSTANT text="{CENTER_ALIGN}Ten!{WAIT_PRESS}\n{CENTER_ALIGN}The money you earn is shared with the guild!{WAIT_PRESS}\n{CENTER_ALIGN}That's the way our friendship will build!"   # EoS message_Notice
    JUMP_SCRIPT END_TALK
end

