script g2_talk_m03a0501   # EoS G01P03A m03a0501 (NPC_BIPPA)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    ASK2 flag=FALSE default=-1 who=TALK_A text=" Huh?{WAIT_PRESS} Are you folks all set and\nready for some exploring?"
    CHOICE label=2002 text="Yes"
    CHOICE label=2003 text="No"
    JUMP_LABEL 2003   # (B / no choice)
  LABEL 2002
    TEXTBOX_CLEAR
  LABEL 0
    TEXTBOX_CLEAR
    EXECUTE_FUNCTION SKY_CH3_OUTLAW_EVENT   # EoS supervision_ExecuteCommon(CORO_EVENT_M03_05_06);
    HALT   # the event takes over
    JUMP_SCRIPT END_TALK
end

