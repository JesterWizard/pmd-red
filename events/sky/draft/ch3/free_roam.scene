script g1_talk_um0306   # EoS G01P04A um0306 (NPC_DOGOOMU)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 901
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0), (4, 1), (4, 2), (4, 3), (4, 4)
    SELECT_ANIMATION 2
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" All right!{WAIT_PRESS} Time to buck up and\nWORK HARD!"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 5), (4, 6)
    UPDATE_NAME kind=ACTOR_TYPE who=TALK_B id=SKY_LIVES_DIGLETT   # the text names it
    SELECT_ANIMATION 2
    PORTRAIT place=LEFT_BOTTOM_FLIP who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" HEY! Diglett!"
    MSG_NPC who=TALK_A text=" Let me know right away if\nANYONE sketchy comes along!"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    # eos: message_SetActor(ACTOR_NPC_DIGUDA);
    MSG_NPC who=TALK_B text=" Yes! Will do!"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

script g1_talk_um0307   # EoS G01P04A um0307 (NPC_PERAPPU)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 902
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 902
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0), (4, 1), (4, 2)
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 3), (4, 4)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" You two!{WAIT_PRESS} Did Bidoof give you a\ntour of the premises?"
    MSG_NPC who=TALK_A text=" Very well. Then I want you to\nexamine the Outlaw Notice Board."
    MSG_NPC who=TALK_A text=" Choose a weak criminal or two.\nThat should be suitable for you! ♪{WAIT_PRESS} I can trust\nyou with that, I'm sure! ♪"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
  LABEL 902   # scenario (4, 5), (4, 6)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" Ah, you two. Are you more or\nless settled into the guild?"
    MSG_NPC who=TALK_A text=" If you've finally made yourself\ncomfortable, then you should get down to work."
    MSG_NPC who=TALK_A text=" It will be good to earn loads of\nmoney for yourselves...and the guild! ♪"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

actors g1_s3_lives
