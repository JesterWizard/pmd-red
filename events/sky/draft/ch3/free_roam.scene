script g2_sign_enter11   # EoS G01P03A enter11
    DEBUGINFO
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 901
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0), (4, 1), (4, 2), (4, 3)
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    PORTRAIT place=LEFT_BOTTOM_2 who=PARTNER emotion=NORMAL
    MSG_NPC who=PARTNER text=" Say, {NAME_0}."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" Today, they didn't want us to do\nany jobs from the Job Bulletin Board."
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" We're supposed to check the\njobs on the Outlaw Notice Board, right?"
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=PARTNER text=" If we're ready to go do the job,\nwe have to tell Bidoof by the Outlaw\nNotice Board."
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 4), (4, 5), (4, 6)
    MSG_INSTANT text="{CENTER_ALIGN}Jobs on the Job Bulletin Board\n{CENTER_ALIGN}are not in this demo."   # EoS message_Menu(MENU_JOB_BOARD)
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

