script g8_talk_um0314   # EoS T01P01A um0314 (NPC_BANEBUU)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 901
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0), (4, 1), (4, 2), (4, 3), (4, 4)
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 5), (4, 6)
    UPDATE_NAME kind=ACTOR_TYPE who=PARTNER id=0x22
    UPDATE_NAME kind=ACTOR_TYPE who=PLAYER id=0x21
    # eos: $SCENARIO_TALK_BIT_FLAG[2] = 1; (EoS's talked-to flags: the free roam's NPCs keep none: nothing on the GBA)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" Oh, {NAME_0} and\n{NAME_1}!"
    MSG_NPC who=TALK_A text=" It's me! Spoink!"
    MSG_NPC who=TALK_A text=" Thank you so much for getting\nmy pearl back for me!"
    MSG_NPC who=TALK_A text=" I'll give you a useful tip as\nfurther gratitude! ♪"
    MSG_NPC who=TALK_A text=" Inside a dungeon...{WAIT_PRESS}until you make\na move, no enemies can take their turns. Did\nyou know that surprising fact?"
    MSG_NPC who=TALK_A text=" So when you run into an enemy\nin a dungeon...{WAIT_PRESS}you don't have to panic."
    MSG_NPC who=TALK_A text=" That gives you time to stay calm\nwhile you choose what to do. You'll be a\ngreat explorer if you make careful choices! ♪"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

