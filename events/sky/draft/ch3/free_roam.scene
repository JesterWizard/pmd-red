script g1_talk_enter05   # EoS G01P04A enter05 (NPC_GUREGGURU)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" The name's Croagunk."
    MSG_NPC who=TALK_A text=" Nice to meet you, rookies.\nMeh-heh-heh."
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

