script g12_crew_exit control=GETOUT_NORMAL type=SCRIPT_TYPE_02   # EoS G01P07A enter01
    DEBUGINFO
    # the morning (c00a0201 set EoS's $SCENARIO_MAIN_BIT_FLAG[1]): the morning address
    JUMPIF_ARRAY SKY_SCENARIO_MAIN_BIT_FLAG 1 0
    SKY_GOTO_MAP map=MAP_SKY_GUILD_B2F_CH3 link=2
    HALT
  LABEL 0
    EXECUTE_FUNCTION SKY_CH3_ADDRESS_EVENT   # EoS CORO_EVENT_HA_CHO / CORO_EVENT_M03_07B
    HALT
end

script g0_s0_station control=ENTER_CONTROL type=SCRIPT_TYPE_01   # every chapter-3 map's enter: its group
    DEBUGINFO
    CJUMP_VAR GROUND_ENTER
    COND_EQUAL MAP_SKY_GUILD_B2F_CH3 1
    COND_EQUAL MAP_SKY_GUILD_B1F_CH3 2
    COND_EQUAL MAP_SKY_GUILD_1F_CH3 3
    COND_EQUAL MAP_SKY_GUILD_ENTRANCE_DAY 4
    COND_EQUAL MAP_SKY_CROSSROADS 5
    COND_EQUAL MAP_SKY_BEACH_PATH 6
    COND_EQUAL MAP_SKY_BEACH_DAY_CH3 7
    COND_EQUAL MAP_SKY_TREASURE_TOWN_SQUARE 8
    COND_EQUAL MAP_SKY_TREASURE_TOWN_WEST 9
    COND_EQUAL MAP_SKY_GUILD_WIGGLYTUFF_CH3 10
    COND_EQUAL MAP_SKY_GUILD_MESS_HALL_CH3 11
    COND_EQUAL MAP_SKY_GUILD_CREW_ROOM_CH3 12
    JUMP_STATION 8 0   # (Treasure Town)
  LABEL 1
    JUMP_STATION 1 0   # b2f
  LABEL 2
    JUMP_STATION 2 0   # b1f
  LABEL 3
    JUMP_STATION 3 0   # f1
  LABEL 4
    JUMP_STATION 4 0   # gate
  LABEL 5
    JUMP_STATION 5 0   # cross
  LABEL 6
    JUMP_STATION 6 0   # path
  LABEL 7
    JUMP_STATION 7 0   # beach
  LABEL 8
    JUMP_STATION 8 0   # square
  LABEL 9
    JUMP_STATION 9 0   # west
  LABEL 10
    JUMP_STATION 10 0   # wiggly
  LABEL 11
    JUMP_STATION 11 0   # mess
  LABEL 12
    JUMP_STATION 12 0   # crew
end

