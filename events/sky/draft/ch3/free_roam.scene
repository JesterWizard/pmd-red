script g8_talk_um0306   # EoS T01P01A um0306 (NPC_KIMAWARI)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 902
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 902
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0)
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 1), (4, 2), (4, 3), (4, 4)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" Eek!"
    MSG_NPC who=TALK_A text=" Oh my gosh! The new guild\nrecruits!{WAIT_PRESS} Delighted to meet you!"
    MSG_NPC who=TALK_A text=" You can get all sorts of things\nhere. It's quite convenient."
    MSG_NPC who=TALK_A text=" Do build a stock of items that\nwill aid your explorations."
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
  LABEL 902   # scenario (4, 5), (4, 6)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    ASK2 flag=FALSE default=-1 who=TALK_A text=" Yes?{WAIT_PRESS} Oh, you want to know\nhow the Job Bulletin Board works?"
    CHOICE label=2002 text="Yes"
    CHOICE label=2003 text="No"
    JUMP_LABEL 2002   # (B / no choice)
  LABEL 2002
    TEXTBOX_CLEAR
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=TALK_A text=" Very well.{WAIT_PRESS} I will be happy to\nexplain it to you."
    MSG_NPC who=TALK_A text=" First, you walk up to the Job\nBulletin Board and press A."
    MSG_NPC who=TALK_A text=" Using the Job Bulletin Board,\nfirst choose the jobs you want to do someday."
    MSG_NPC who=TALK_A text=" The jobs you chose will then\nappear in your menu's Job List. Each whole job\nletter will be there with all the details."
    MSG_NPC who=TALK_A text=" Then use the Take Job command\nto activate jobs on your Job List.{WAIT_PRESS} After that,\nyou can go to the dungeon to do the job!"
    MSG_NPC who=TALK_A text=" Don't forget! You must activate\na job with Take Job if you want to do it."
    TEXTBOX_CLEAR
    JUMP_LABEL 130
  LABEL 2003
    TEXTBOX_CLEAR
    # eos: CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC); (the next line follows)
    MSG_NPC who=TALK_A text=" This Job Bulletin Board fills up\nwith many kinds of jobs."
    MSG_NPC who=TALK_A text=" They represent the cries of\nPokémon who are calling for our help."
    MSG_NPC who=TALK_A text=" Lending a helping hand to such\nPokémon in need is an important part of an\nexploration team's work."
    TEXTBOX_CLEAR
    JUMP_LABEL 130
  LABEL 2001
    JUMP_SCRIPT END_TALK
end

