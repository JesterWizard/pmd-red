script g9_talk_um0304   # EoS T01P02A um0304 (NPC_YAMIKARASU)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 901
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0)
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 1), (4, 2), (4, 3), (4, 4), (4, 5), (4, 6)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" My favorite things, darlings?\nWell, do I ever have an eye for sparklies!"
    MSG_NPC who=TALK_A text=" I keep telling my partner that\nwe should seek out flashy baubles and\nglamorous glitz..."
    MSG_NPC who=TALK_A text=" But Shuppet always reacts\ncoolly to my suggestions."
    MSG_NPC who=TALK_A text=" But she seems not to hear! Or\nshe just won't listen!{WAIT_PRESS} Arrgh, it's aggravating!"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

