};
```

script g11_s0_station control=ENTER_CONTROL type=SCRIPT_TYPE_01   # the mess hall by day (EoS G01P06A, station UM03; shown on chapter 2's g01p06b)
    DEBUGINFO
    SELECT_MAP SKY_GUILD_MESS_HALL_CH3
    UPDATE_VARINT CALC_SET PARTNER1_KIND 2   # the partner (lives kind 4) follows the hero
    SELECT_ENTITIES group=-1 sector=1   # signs, objects, shopkeepers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 2   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 2   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 3   # fail
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 3   # fail
    JUMP_LABEL 1
  LABEL 2
    SELECT_LIVES group=-1 sector=2   # open: who is there
    JUMP_LABEL 1
  LABEL 3
    SELECT_LIVES group=-1 sector=3   # fail: who is there
    JUMP_LABEL 1
  LABEL 1
    CJUMP_VAR GROUND_ENTER_LINK   # where the hero comes in
    COND_EQUAL 1 101
    JUMP_LABEL 101
  LABEL 101
    SELECT_LIVES group=-1 sector=10
    JUMP_LABEL 2
  LABEL 2
    SELECT_EVENTS g=-1 s=0   # the exits
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    FADE_IN wait=FALSE frames=-1
    RET
end

script g12_sign_enter07   # EoS G01P07A enter07
    DEBUGINFO
    WAIT 1
    MSG_INSTANT text="{CENTER_ALIGN}GET UP ALREADY!\n{CENTER_ALIGN}         -Loudred"   # EoS message_Notice
    JUMP_SCRIPT END_TALK
end

script g12_sign_enter04   # EoS G01P07A enter04
    DEBUGINFO
    WAIT 1
    UPDATE_VARINT CALC_SET GROUND_ENTER_LINK 2   # Continue: the crew room, at the bed
    SET_ARRAYVAL SKY_SCENARIO_MAIN_BIT_FLAG 7 1   # EoS $SCENARIO_MAIN_BIT_FLAG[7] = 1;
    ASK2 flag=FALSE default=-1 who=-1 text="{CENTER_ALIGN}Would you like to save your adventure?"
    CHOICE label=1001 text="Save"
    CHOICE label=1002 text="Don't save"
  LABEL 1001
    TEXTBOX_CLEAR
    SKY_SAVE_GAME   # EoS CORO_HANYOU_SAVE_FUNC
    COND_EQUAL 0 1003
    MSG_INSTANT text="{CENTER_ALIGN}Your adventure has been saved."
    JUMP_LABEL 1002
  LABEL 1003
    MSG_INSTANT text="{CENTER_ALIGN}The data could not be saved."
  LABEL 1002
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

