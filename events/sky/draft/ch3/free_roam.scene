script g1_s0_station control=ENTER_CONTROL type=SCRIPT_TYPE_01   # the guild's B2F (EoS G01P04A, station UM03)
    DEBUGINFO
    SELECT_MAP SKY_GUILD_B2F_CH3
    UPDATE_VARINT CALC_SET PARTNER1_KIND 2   # the partner (lives kind 4) follows the hero
    SELECT_ENTITIES group=-1 sector=1   # signs, objects, shopkeepers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 2   # morning
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 3   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 3   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 4   # fail
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 4   # fail
    JUMP_LABEL 1
  LABEL 2
    SELECT_LIVES group=-1 sector=2   # morning: who is there
    SELECT_EVENTS g=-1 s=2   # morning: the story's triggers
    JUMP_LABEL 1
  LABEL 3
    SELECT_LIVES group=-1 sector=3   # open: who is there
    JUMP_LABEL 1
  LABEL 4
    SELECT_LIVES group=-1 sector=4   # fail: who is there
    JUMP_LABEL 1
  LABEL 1
    CJUMP_VAR GROUND_ENTER_LINK   # where the hero comes in
    COND_EQUAL 0 100
    COND_EQUAL 1 101
    COND_EQUAL 2 102
    COND_EQUAL 3 103
    COND_EQUAL 4 104
    JUMP_LABEL 100
  LABEL 100
    SELECT_LIVES group=-1 sector=10
    JUMP_LABEL 2
  LABEL 101
    SELECT_LIVES group=-1 sector=11
    JUMP_LABEL 2
  LABEL 102
    SELECT_LIVES group=-1 sector=12
    JUMP_LABEL 2
  LABEL 103
    SELECT_LIVES group=-1 sector=13
    JUMP_LABEL 2
  LABEL 104
    SELECT_LIVES group=-1 sector=14
    JUMP_LABEL 2
  LABEL 2
    SELECT_EVENTS g=-1 s=0   # the exits
    BGM_SWITCH SKY_WIGGLYTUFFS_GUILD
    FADE_IN wait=FALSE frames=-1
    RET
end

