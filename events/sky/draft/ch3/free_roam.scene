script g8_s0_station control=ENTER_CONTROL type=SCRIPT_TYPE_01   # Treasure Town, the square (EoS T01P01A, station UM03)
    DEBUGINFO
    SELECT_MAP SKY_TREASURE_TOWN_SQUARE
    UPDATE_VARINT CALC_SET PARTNER1_KIND 2   # the partner (lives kind 4) follows the hero
    SELECT_ENTITIES group=-1 sector=1   # signs, objects, shopkeepers
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 2   # town1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 3   # town2
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 4   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 4   # open
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 5   # fail
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 5   # fail
    JUMP_LABEL 1
  LABEL 2
    SELECT_LIVES group=-1 sector=2   # town1: who is there
    SELECT_EVENTS g=-1 s=2   # town1: the story's triggers
    JUMP_LABEL 1
  LABEL 3
    SELECT_LIVES group=-1 sector=3   # town2: who is there
    SELECT_EVENTS g=-1 s=3   # town2: the story's triggers
    JUMP_LABEL 1
  LABEL 4
    SELECT_LIVES group=-1 sector=4   # open: who is there
    JUMP_LABEL 1
  LABEL 5
    SELECT_LIVES group=-1 sector=5   # fail: who is there
    JUMP_LABEL 1
  LABEL 1
    CJUMP_VAR GROUND_ENTER_LINK   # where the hero comes in
    COND_EQUAL 1 101
    COND_EQUAL 2 102
    COND_EQUAL 5 105
    COND_EQUAL 6 106
    COND_EQUAL 7 107
    JUMP_LABEL 101
  LABEL 101
    SELECT_LIVES group=-1 sector=10
    JUMP_LABEL 2
  LABEL 102
    SELECT_LIVES group=-1 sector=11
    JUMP_LABEL 2
  LABEL 105
    SELECT_LIVES group=-1 sector=12
    JUMP_LABEL 2
  LABEL 106
    SELECT_LIVES group=-1 sector=13
    JUMP_LABEL 2
  LABEL 107
    SELECT_LIVES group=-1 sector=14
    JUMP_LABEL 2
  LABEL 2
    SELECT_EVENTS g=-1 s=0   # the exits
    BGM_SWITCH SKY_TREASURE_TOWN
    FADE_IN wait=FALSE frames=-1
    RET
end

