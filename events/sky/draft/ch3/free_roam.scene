script g5_talk_um0301   # EoS P01P01A um0301 (NPC_HEIGANI)
    DEBUGINFO
    SELECT_ANIMATION 2
    UPDATE_NAME kind=ACTOR_SELF who=TALK_A id=0x0
    WAIT 1
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 0 900
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 1 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 2 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 3 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 4 901
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 5 902
    JUMPIF_SCENE_EQ SCENARIO_MAIN 4 6 902
    JUMP_SCRIPT END_TALK
  LABEL 900   # scenario (4, 0)
    JUMP_SCRIPT END_TALK
  LABEL 901   # scenario (4, 1), (4, 2), (4, 3), (4, 4)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" Hey, hey, hey! You there!{WAIT_PRESS}\nYou're the new rookies at the guild, aren't you?"
    MSG_NPC who=TALK_A text=" Hey, hey! My name's Corphish!"
    MSG_NPC who=TALK_A text=" I'm an apprentice at Wigglytuff's\nGuild too. Hey, hey!"
    MSG_NPC who=TALK_A text=" If you don't know what's going\non or whatever...you come ask me! You got\nthat, hey, hey?"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
  LABEL 902   # scenario (4, 5), (4, 6)
    PORTRAIT place=LEFT_BOTTOM_2 who=TALK_A emotion=NORMAL
    MSG_NPC who=TALK_A text=" Hey, hey! You're going out on an\nexploration?"
    TEXTBOX_CLEAR
    ROTATE_TO speed=4 turn=DIR_TRANS_10 direction=EAST
    MSG_NPC who=TALK_A text=" You can start exploring by going\nout this way, hey, hey!"
    TEXTBOX_CLEAR
    ROTATE_TO_LIVES speed=4 turn=DIR_TRANS_11 kind=LIVES_KIND_PLAYER
    MSG_NPC who=TALK_A text=" Hey, hey! You be careful!"
    MSG_NPC who=TALK_A text=" Hey, hey! If you're looking for\nadventure, you gotta get ready for whatever\ncomes your way!"
    TEXTBOX_CLEAR
    JUMP_SCRIPT END_TALK
end

